<!-- 价格明细视图（由 XM 中已「定型」的行自动生成，列标题与 XM 一致） -->
<div id="priceView" style="display:none">
  <div class="toolbar">
    <span style="font-size:13px;color:#888;align-self:center;">本表由「XM方案明细」中已勾选为「定型」的方案自动生成，无需手动添加</span>
  </div>
  <div class="table-wrapper">
