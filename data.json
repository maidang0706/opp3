// 价格视图不再单独维护数据：所有操作都作用于 XM 源数据（deleteRow/toggleFinalize 已复用）

// ==================== 订单明细视图（由上传的订单明细.xlsx 生成，独立维护数据） ====================
var orderColumns = ["订单类型", "订单状态", "内部订单号（必填）", "订单日期", "客户查找关联", "规格型号", "数量", "单位", "单价", "金额", "负责人", "价格申请日期", "项目名称", "配置"];
var orderEditingIdx = null;
var orderTableBody = document.getElementById('orderTableBody');
var orderTable = document.getElementById('orderTable');
// 性能优化：订单表点击高亮改用事件委托（整表一个监听），避免给每个单元格挂 onclick 闭包（2756 行约 3.8 万单元格）
if (orderTableBody && !orderTableBody._delegated) {
  orderTableBody.addEventListener('click', function (e) {
    var cell = e.target.closest ? e.target.closest('td') : null;
    if (cell && cell.tagName === 'TD') {
      if (cell.getAttribute('data-col') === '规格型号' && cell.classList.contains('order-model-dup')) {
        var mv = (cell.textContent || '').trim();
        orderModelFilter = (orderModelFilter === mv) ? null : mv;
        updateOrderModelFilterBar();
        renderOrder();
        return;
      }
      highlightOrderCell(cell);
    }
  });
  orderTableBody._delegated = true;
}
// 窗口尺寸变化会使缓存的列宽失效，下次渲染重新测量
window.addEventListener('resize', invalidateOrderColWidths);
// 数据字段重命名迁移：列标题调整后兼容旧订单数据（幂等，可重复执行）
(function migrateOrderColumns() {
  var renameMap = { '订单负责人': '负责人', '订单数量': '数量' };
  orderData.forEach(function (r) {
    Object.keys(renameMap).forEach(function (oldK) {
      if (oldK in r) { r[renameMap[oldK]] = r[oldK]; delete r[oldK]; }
    });
    if ('客户订单号' in r) delete r['客户订单号'];
  });
})();
// ===== 订单 ↔ 价格 联动 =====
var orderModelFilter = null; // 订单表按型号筛选：null 不过滤

function normalizeDate(v) {
  if (v === undefined || v === null) return '';
  var s = String(v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{2,4})[/\-.](\d{1,2})[/\-.](\d{1,2})$/);
  if (m) {
    var y = parseInt(m[1], 10); if (y < 100) y += 2000;
    var mo = String(parseInt(m[2], 10)).padStart(2, '0');
    var d = String(parseInt(m[3], 10)).padStart(2, '0');
    return y + '-' + mo + '-' + d;
  }
  return s;
}

// 统计订单表规格型号出现次数 → {counts, dupSet(>1), modelSet(全部)}
var _orderModelCache = null; // 缓存规格型号统计结果，避免每次渲染重复遍历 2756 行
function getOrderModelInfo() {
  if (_orderModelCache) return _orderModelCache;
  var counts = {}, modelSet = {};
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m) return;
    counts[m] = (counts[m] || 0) + 1;
    modelSet[m] = true;
  });
  var dupSet = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dupSet[k] = true; });
  _orderModelCache = { counts: counts, dupSet: dupSet, modelSet: modelSet };
  return _orderModelCache;
}

// 把价格明细的项目名称/配置 同步到订单明细（按规格型号匹配；订单中该型号唯一直接填，重复则需价格申请日期一致）
function syncOrderFromPrice() {
  var priceByModel = {};
  getPriceList().forEach(function (p) {
    var m = (p['型号'] || '').toString().trim();
    if (!m) return;
    (priceByModel[m] = priceByModel[m] || []).push(p);
  });
  if (!Object.keys(priceByModel).length) return;
  var info = getOrderModelInfo();
  var changed = false;
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m || !priceByModel[m]) return;
    var candidates = priceByModel[m];
    var orderCount = info.counts[m];
    var pick = null;
    if (orderCount === 1) {
      var od = normalizeDate(r['价格申请日期']);
      pick = (od && candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od; })[0]) || candidates[0];
    } else {
      var od2 = normalizeDate(r['价格申请日期']);
      if (!od2) return;
      pick = candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od2; })[0];
      if (!pick) return;
    }
    if (pick['项目名称'] && pick['项目名称'] !== r['项目名称']) { r['项目名称'] = pick['项目名称']; changed = true; }
    if (pick['配置'] && pick['配置'] !== r['配置']) { r['配置'] = pick['配置']; changed = true; }
  });
  if (changed) persistData();
}
// 订单明细：列宽比例调整。每次渲染都基于“当前自然宽 × 比例”计算，不依赖跨渲染状态，确定可靠。
var orderFilterCols = [
  { id: 'of_customer', col: '客户查找关联' },
  { id: 'of_model', col: '规格型号' },
  { id: 'of_owner', col: '负责人' }
];

// 连续编号：序列 = 行序（从 1 开始，顶部为 1）
function renumberOrders() {
  for (var i = 0; i < orderData.length; i++) orderData[i]['序列'] = i + 1;
}

function getOrderFiltered() {
  var f = {};
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el && el.value.trim()) f[o.col] = el.value.trim().toLowerCase();
  });
  return orderData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    if (orderModelFilter) {
      var m = (row['规格型号'] || '').toString().trim();
      if (m !== orderModelFilter) return false;
    }
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function orderCellClass(col) {
  if (col === '内部订单号（必填）') return 'col-fixed';
  if (col === '订单日期' || col === '价格申请日期') return 'col-date';
  if (col === '订单类型' || col === '订单状态' || col === '数量' || col === '单价' || col === '负责人') return 'col-half w40';
  if (col === '单位') return 'col-half w30';
  if (col === '金额') return 'col-half w50';
  if (col === '客户查找关联' || col === '规格型号') return 'col-cust';
  return '';
}

function renderOrder() {
  var list = getOrderFiltered();
  var orderModelInfo = getOrderModelInfo();
  // 预计算每列元数据（只算一次，避免每次渲染 4 万次 orderCellClass 调用与分支判断）
  if (!renderOrder._meta) {
    var meta = [];
    for (var k = 0; k < orderColumns.length; k++) {
      var col = orderColumns[k];
      meta.push({
        col: col,
        cls: orderCellClass(col),
        isDate: (col === '订单日期' || col === '价格申请日期'),
        isModel: (col === '规格型号')
      });
    }
    renderOrder._meta = meta;
  }
  var META = renderOrder._meta;
  // 按订单日期倒序排列（最新日期在最上方）
  list.sort(function (a, b) {
    return orderDateValue(b['订单日期']) - orderDateValue(a['订单日期']);
  });
  if (list.length === 0) {
    orderTableBody.innerHTML = '<tr><td colspan="' + (orderColumns.length + 2) + '" style="padding:14px;color:#999;">暂无数据</td></tr>';
    return;
  }
  // 性能优化：用单次 innerHTML 批量构建 tbody（2756 行 × 15 列约 4 万单元格），避免逐个 createElement/appendChild
  var rows = new Array(list.length);
  for (var i = 0; i < list.length; i++) {
    var item = list[i];
    var mval = (item['规格型号'] || '').toString().trim();
    var cells = ['<td class="seq-cell col-half w30" data-col="序列">' + (i + 1) + '</td>'];
    for (var k = 0; k < META.length; k++) {
      var m = META[k];
      var val = item[m.col];
      if (m.isDate) val = formatOrderDate(val);
      var disp = (val === '' || val === null || val === undefined) ? '' : String(val);
      var cls = m.cls;
      if (m.isModel && orderModelInfo.dupSet[mval]) cls = (cls ? cls + ' ' : '') + 'order-model-dup';
      cells.push('<td' + (cls ? ' class="' + cls + '"' : '') + ' data-col="' + m.col + '">' + escapeHtml(disp) + '</td>');
    }
    rows[i] = '<tr' + (item['定型'] ? ' class="finalized-row"' : '') + '>' + cells.join('') + '</tr>';
  }
  orderTableBody.innerHTML = rows.join('');
  applyOrderColumnRatios();
  scheduleAutoFit(orderTable);
}

// 列宽比例调整：首次测量并缓存结果，之后直接套用（仅写不读，去除每次渲染对上万单元格的 offsetWidth 读取）
var _orderColWidths = null; // {col: targetPx}
var _orderColMeasuring = false; // 防止同帧重复安排测量
function invalidateOrderColWidths() { _orderColWidths = null; _orderModelCache = null; }

function applyOrderColumnRatios() {
  var ratios = {
    '订单状态': 2 / 3,
    '订单日期': 2 / 3,
    '客户查找关联': 3 / 4,
    '规格型号': 3 / 4,
    '负责人': 2 / 3,
    '价格申请日期': 2 / 3
  };
  // 已缓存：直接套用，不重新测量（无 layout 读取，仅一次重排）
  if (_orderColWidths) {
    for (var c in _orderColWidths) {
      if (!ratios.hasOwnProperty(c)) continue;
      var tw = _orderColWidths[c];
      var th = document.querySelector('#orderTable th[data-col="' + c + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = tw + 'px';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + c + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = tw + 'px';
    }
    return;
  }
  var cols = Object.keys(ratios);
  // 首次测量推迟到下一帧：先让表格以自然宽瞬时呈现（点击进入不卡），后台再测宽并缓存套用
  if (_orderColMeasuring) return; // 本帧已安排测量，避免重复
  _orderColMeasuring = true;
  requestAnimationFrame(function () {
    _orderColMeasuring = false;
    // 若订单表当前不可见（例如正在「方案明细」视图中编辑、保存时触发了 renderOrder），
    // 隐藏表的 offsetWidth 为 0，测得自然宽 0 会把列宽错误锁成 18px。此时放弃测量、不写缓存，
    // 待订单视图真正显示时由 showView → renderOrder 重新触发测量（已先 invalidateOrderColWidths）。
    var _ov = document.getElementById('orderView');
    if (!_ov || _ov.offsetParent === null) return;
    // 写阶段①：清除所有目标列的固定宽，量自然宽
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = '';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = '';
    });
    // 读阶段：量取每列最大自然宽（全部读，无穿插写，仅触发一次重排）
    var res = {};
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      if (!th || !cells.length) return;
      var natural = th.offsetWidth;
      for (var i = 0; i < cells.length; i++) { var w = cells[i].offsetWidth; if (w > natural) natural = w; }
      res[col] = { th: th, cells: cells, target: Math.max(18, Math.round(natural * ratios[col])) };
    });
    // 写阶段②：统一回写目标列宽，并缓存结果供后续渲染复用
    var store = {};
    cols.forEach(function (col) {
      var r = res[col];
      if (!r) return;
      r.th.style.width = r.th.style.minWidth = r.th.style.maxWidth = r.target + 'px';
      for (var i = 0; i < r.cells.length; i++) r.cells[i].style.width = r.cells[i].style.minWidth = r.cells[i].style.maxWidth = r.target + 'px';
      store[col] = r.target;
    });
    _orderColWidths = store;
  });
}

function highlightOrderCell(td) {
  // 清除上一次高亮（整表所有 .hl）
  var prev = orderTable.querySelectorAll('td.hl, th.hl');
  Array.prototype.forEach.call(prev, function (c) { c.classList.remove('hl'); });
  var tr = td.parentElement;
  var idx = td.cellIndex;
  // 高亮整行
  Array.prototype.forEach.call(tr.querySelectorAll('td'), function (c) { c.classList.add('hl'); });
  // 高亮整列（含表头，按列索引定位）
  Array.prototype.forEach.call(orderTable.querySelectorAll('tr'), function (row) {
    var cell = row.cells[idx];
    if (cell) cell.classList.add('hl');
  });
}
function startOrderEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var rawVal = (orderData[rowIdx][col] === undefined || orderData[rowIdx][col] === null) ? '' : orderData[rowIdx][col];
  input.value = (col === '订单日期') ? formatOrderDate(rawVal) : rawVal;
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishOrderEdit(input.value, rowIdx, col); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderOrder(); }
  };
}
function finishOrderEdit(val, rowIdx, col) {
  if (orderData[rowIdx][col] !== val) {
    orderData[rowIdx][col] = val;
    persistData();
    invalidateOrderColWidths();
    renderOrder();
    scheduleSync();
  }
}
function commitOrderEdit(input, rowIdx, col) {
  orderData[rowIdx][col] = input.value;
  persistData();
  scheduleSync();
}
function editOrderRow(rowIdx) { orderEditingIdx = rowIdx; renderOrder(); }
function addOrderRow() {
  // 清空当前筛选条件，确保新增的空白行一定可见（否则空行会被筛选隐藏，造成「点了没反应」）
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el) el.value = '';
  });
  var row = { 序列: 0, 定型: false };
  orderColumns.forEach(function (c) { row[c] = ''; });
  orderData.unshift(row);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}
function toggleOrderFinalize(rowIdx) {
  orderData[rowIdx]['定型'] = !orderData[rowIdx]['定型'];
  persistData();
  renderOrder();
  scheduleSync();
}
function deleteOrderRow(idx) {
  if (!confirm('确定删除这条订单记录吗？')) return;
  orderData.splice(idx, 1);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}

// 视图切换：三个界面共用同一标题栏（方案明细 / 价格明细 / 订单明细）
function showView(name) {
  currentView = name;
  document.getElementById('xmView').style.display = (name === 'xm') ? '' : 'none';
  document.getElementById('priceView').style.display = (name === 'price') ? '' : 'none';
  document.getElementById('orderView').style.display = (name === 'order') ? '' : 'none';
  document.getElementById('navXm').classList.toggle('active', name === 'xm');
  document.getElementById('navPrice').classList.toggle('active', name === 'price');
  document.getElementById('navOrder').classList.toggle('active', name === 'order');
  if (name === 'xm') render();
  else if (name === 'price') renderPrice();
  else { invalidateOrderColWidths(); renderOrder(); }
}

// ==================== 增删 ====================
// 序列 = 方案编号（同一方案的多条变更共享同一编号；新增取最大号+1，删除方案后由 renumberSchemes 重新连续编号）
function addRow() {
  var now = new Date().toLocaleString('zh-CN');
  var maxSeq = 0;
  rawData.forEach(function (r) { var n = parseFloat(r['序列']); if (!isNaN(n) && n > maxSeq) maxSeq = n; });
  rawData.unshift({
    序列: maxSeq + 1,
    建档日期: todayStr(),
    客户: '', 项目号: '', 项目名称: '', 工程师: '',
    变更时间: now, 工况: '', 型号: '', 配置: '', 价格申请日期: '',
    定型: false
  });
  persistData();
  applyFilters();
  scheduleSync();
}

function deleteRow(idx) {
  if (!confirm('确定删除这条记录吗？')) return;
  rawData.splice(idx, 1);
  renumberSchemes(); // 删除方案后，剩余方案重新连续编号
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 新增变更（点击序列列弹出） ====================
// 与编辑对话框同构：建档日期/客户/项目号/项目名称/工程师 锁定（只读），变更时间默认当前时间，其余可编辑
var chPlanSeq = null; // 当前操作的方案编号
var CHANGE_FIELDS = [
  { key: '建档日期', id: 'ch_date', locked: true },
  { key: '客户', id: 'ch_customer', locked: true },
  { key: '项目号', id: 'ch_projno', locked: true },
  { key: '项目名称', id: 'ch_projname', locked: true },
  { key: '工程师', id: 'ch_engineer', locked: true },
  { key: '变更时间', id: 'ch_changetime', locked: true },
  { key: '工况', id: 'ch_cond' },
  { key: '型号', id: 'ch_model' },
  { key: '配置', id: 'ch_config', multiline: true }
];

function buildChangeModal() {
  var box = document.getElementById('chFields');
  if (!box || box.dataset.built) return;
  var html = '';
  CHANGE_FIELDS.forEach(function (f) {
    html += '<label>' + f.key + (f.multiline ? '（多行）' : '') + (f.locked ? '（只读）' : '') + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="3" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '>';
    }
  });
  box.innerHTML = html;
  box.dataset.built = '1';
}

function openChangeDialog(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  chPlanSeq = row['序列'];
  buildChangeModal();
  document.getElementById('chPlanId').textContent = row['序列'];
  CHANGE_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    if (f.key === '变更时间') {
      el.value = new Date().toLocaleString('zh-CN'); // 默认当前时间，且只读
    } else {
      el.value = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
    }
  });
  document.getElementById('changeModal').classList.add('show');
  // 焦点放到第一个可编辑字段（工况）
  setTimeout(function () { var c = document.getElementById('ch_cond'); if (c) c.focus(); }, 50);
}

function closeChangeModal() {
  document.getElementById('changeModal').classList.remove('show');
  chPlanSeq = null;
}

function submitChange() {
  if (chPlanSeq === null && chPlanSeq !== 0) { showToast('无效方案', 'error'); return; }
  var pid = chPlanSeq;
  // 从现有方案第一条读取固定字段（建档日期/客户/项目号/项目名称/工程师），变更行继承且锁定
  var src = rawData.find(function (r) { return String(r['序列']) === String(pid); });
  if (!src) { showToast('未找到该方案', 'error'); return; }
  var newRow = {
    序列: pid,
    建档日期: src['建档日期'],
    客户: src['客户'], 项目号: src['项目号'], 项目名称: src['项目名称'], 工程师: src['工程师'],
    变更时间: (document.getElementById('ch_changetime').value || new Date().toLocaleString('zh-CN')),
    工况: (document.getElementById('ch_cond').value || '').trim(),
    型号: (document.getElementById('ch_model').value || '').trim(),
    配置: (document.getElementById('ch_config').value || '').trim(),
    定型: false
  };
  // 插入到该方案在表格中的最上方（同一序列号合并显示时位于块首）
  var topIdx = rawData.findIndex(function (r) { return String(r['序列']) === String(pid); });
  if (topIdx === -1) topIdx = 0;
  rawData.splice(topIdx, 0, newRow);
  closeChangeModal();
  persistData();
  applyFilters();
  scheduleSync();
  showToast('✅ 已为方案 #' + pid + ' 新增变更', 'success');
}

// ==================== 编辑方案弹窗 ====================
// 点击「编辑」按钮弹出独立对话框，输入内容后点「保存」显式写回 rawData 并刷新表格，
// 不再依赖单元格失焦来提交，彻底避免「输入内容表格显示不了」的问题
var editModalIdx = null;
var EDIT_FIELDS = [
  { key: '建档日期', id: 'em_date' },
  { key: '客户', id: 'em_customer' },
  { key: '项目号', id: 'em_projno' },
  { key: '项目名称', id: 'em_projname' },
  { key: '工程师', id: 'em_engineer' },
  { key: '变更时间', id: 'em_changetime' },
  { key: '工况', id: 'em_cond' },
  { key: '型号', id: 'em_model' },
  { key: '配置', id: 'em_config', multiline: true }
];

function buildEditModal() {
  var box = document.getElementById('emFields');
  if (!box || box.dataset.built) return;
  var html = '';
  EDIT_FIELDS.forEach(function (f) {
    html += '<label>' + f.key + (f.multiline ? '（多行）' : '') + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="3" placeholder="输入' + f.key + '"></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '">';
    }
  });
  box.innerHTML = html;
  box.dataset.built = '1';
}

function openEditModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  editModalIdx = rowIdx;
  buildEditModal();
  document.getElementById('emSeq').textContent = row['序列'] || '';
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (el) el.value = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
  });
  document.getElementById('editModal').classList.add('show');
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('show');
  editModalIdx = null;
}

function saveEditModal() {
  if (editModalIdx === null) return;
  var row = rawData[editModalIdx];
  if (!row) { closeEditModal(); return; }
  var pid = String(row['序列']);
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    var val = el ? el.value : '';
    row[f.key] = val;
    // 合并列同步到同方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(f.key) !== -1) {
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[f.key] = val; });
    }
  });
  persistData();
  applyFilters();
  // 仅在点击「保存」后触发同步：价格明细项目名称/配置回填订单，并刷新各视图与 GitHub
  syncOrderFromPrice();
  renderPrice();
  renderOrder();
  scheduleSync();
  closeEditModal();
  showToast('✅ 已保存', 'success');
}

// 当前日期（YYYY/MM/DD），用于新增行默认建档日期
function todayStr() {
  var d = new Date();
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 价格明细由 XM 数据自动生成，无需单独存储
// 双层持久化：① 写入页面内嵌 script（供 GitHub 上传） ② 写入 localStorage（本地即时缓存，重开优先读取）
var LS_KEY_RAW = 'xm_rawData_v1';
var LS_KEY_ORDER = 'xm_orderData_v1';
function persistData() {
  document.getElementById('xmData').textContent = 'var rawData = ' + JSON.stringify(rawData) + ';';
  var od = document.getElementById('orderData');
  if (od) od.textContent = 'var orderData = ' + JSON.stringify(orderData) + ';';
  // 同步写入 localStorage（同设备重开的唯一可靠来源）
  try { localStorage.setItem(LS_KEY_RAW, JSON.stringify(rawData)); } catch(e) {}
  try { localStorage.setItem(LS_KEY_ORDER, JSON.stringify(orderData)); } catch(e) {}
}

// ==================== GitHub 配置 ====================
// 默认仓库/文件路径取自 XM方案明细（项目资产）。Token 仅通过头部输入框填入，不写入文件内容。
var DEFAULT_GH = {
  user: 'maidang0706',
  repo: 'OPP3',
  token: '',
  filePath: 'XM方案明细.html',
  commitMsg: 'Update XM方案明细'
};

function loadGitHubSettings() {
  try {
    var saved = localStorage.getItem('xm_github_settings');
    if (!saved) {
      saved = JSON.stringify(DEFAULT_GH);
      localStorage.setItem('xm_github_settings', saved);
    }
    updateSyncStatus('idle', '已配置');
  } catch (e) {}
}

// 获取配置：user/repo/filePath 固定，token 从 localStorage 读取，未设置则弹窗输入
function getGitHubSettings() {
  var saved = localStorage.getItem('xm_github_settings');
  var s = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT_GH));
  return s;
}

// ==================== GitHub同步 ====================
function updateSyncStatus(status, text) {
  var dot = document.querySelector('#syncStatus .sync-dot');
  var txt = document.getElementById('syncText');
  var el = document.getElementById('syncStatus');
  el.className = 'sync-status ' + status;
  txt.textContent = text || (status === 'idle' ? '已配置' : status === 'syncing' ? '同步中...' : '同步失败');
}

async function syncToGitHub() {
  var settings = getGitHubSettings();
  if (!settings.token) {
    var t = prompt('请输入 GitHub Token：');
    if (!t) return;
    settings.token = t.trim();
    localStorage.setItem('xm_github_settings', JSON.stringify(settings));
  }
  if (!settings.user || !settings.repo) { showToast('配置错误', 'error'); return; }
  updateSyncStatus('syncing', '同步中...');
  var btn = document.getElementById('syncBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 同步中...';

  try {
    // 同步前确保脚本中的 rawData 为最新
    persistData();
    var htmlContent = document.documentElement.outerHTML;
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var branch = settings.branch || 'main';
    var headers = {
      'Authorization': 'token ' + settings.token,
      'Accept': 'application/vnd.github.v3+json',
      'Content-Type': 'application/json'
    };

    // 诊断：先查 Token 是否具备仓库写权限（最常见「上传不了」的原因）
    try {
      var meResp = await fetch('https://api.github.com/user', { headers: { 'Authorization': 'token ' + settings.token, 'Accept': 'application/vnd.github.v3+json' } });
      var meScopes = meResp.headers.get('X-OAuth-Scopes') || '';
      if (meResp.ok && !/(^|,\s*)(repo|public_repo)(,|$)/.test(meScopes)) {
        showToast('⚠️ Token 缺少仓库写权限（当前: ' + (meScopes || '无') + '），上传会失败。请到 GitHub 重新生成带 repo 权限的 Token', 'error');
      } else if (!meResp.ok) {
        showToast('⚠️ Token 无效或已过期（' + meResp.status + '），请重新点「🔄 同步到 GitHub」输入', 'error');
      }
    } catch (e) {}

    // 文件超过 1MB 时 Contents API（PUT /contents）会被 GitHub 拒绝，
    // 故改用 Git Data API（blob + tree + commit），支持最大 100MB，可稳定同步大文件。
    var base64Content = btoa(unescape(encodeURIComponent(htmlContent)));

    // 1) 创建 blob
    var blobResp = await fetch(base + '/git/blobs', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ content: base64Content, encoding: 'base64' })
    });
    if (!blobResp.ok) {
      var be = await blobResp.json().catch(function(){return {};});
      throw new Error('创建 blob 失败(' + blobResp.status + '): ' + (be.message || ''));
    }
    var blob = await blobResp.json();

    // 2) 获取分支最新 commit
    var refResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), { headers: headers });
    if (!refResp.ok) { var re = await refResp.json().catch(function(){return{};}); throw new Error('获取分支失败(' + refResp.status + '): ' + (re.message || '请确认分支名是否为 ' + branch)); }
    var refData = await refResp.json();
    var latestCommitSha = refData.object.sha;

    // 3) 获取该 commit 的 tree
    var commitResp = await fetch(base + '/git/commits/' + latestCommitSha, { headers: headers });
    if (!commitResp.ok) throw new Error('获取 commit 失败');
    var commitData = await commitResp.json();
    var baseTreeSha = commitData.tree.sha;

    // 4) 用新 blob 创建新 tree（替换/新增目标文件）
    var treeResp = await fetch(base + '/git/trees', {
      method: 'POST', headers: headers,
      body: JSON.stringify({
        base_tree: baseTreeSha,
        tree: [ { path: settings.filePath, mode: '100644', type: 'blob', sha: blob.sha } ]
      })
    });
    if (!treeResp.ok) { var te = await treeResp.json().catch(function(){return{};}); throw new Error('创建 tree 失败(' + treeResp.status + '): ' + (te.message || '')); }
    var newTree = await treeResp.json();

    // 5) 创建 commit
    var newCommitResp = await fetch(base + '/git/commits', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ message: settings.commitMsg, tree: newTree.sha, parents: [latestCommitSha] })
    });
    if (!newCommitResp.ok) throw new Error('创建 commit 失败(' + newCommitResp.status + ')');
    var newCommit = await newCommitResp.json();

    // 6) 更新分支引用
    var updateRefResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), {
      method: 'PATCH', headers: headers,
      body: JSON.stringify({ sha: newCommit.sha, force: false })
    });
    if (!updateRefResp.ok) throw new Error('更新分支引用失败(' + updateRefResp.status + ')');

    updateSyncStatus('idle', '已同步');
    showToast('✅ 同步成功！', 'success');
  } catch (e) {
    updateSyncStatus('error', '同步失败');
    showToast('❌ 同步失败: ' + e.message, 'error');
  }
  btn.disabled = false;
  btn.textContent = '🔄 同步到 GitHub';
}

// 编辑后自动（防抖）同步
var _syncTimer = null;
function scheduleSync() {
  // 已改为「手动同步」：编辑/新增/删除仅写入本地缓存（persistData 中的 localStorage），
  // 不再自动上传 GitHub。需要跨设备同步时，由用户手动点击「🔄 同步到 GitHub」按钮触发。
}

// ==================== 从 GitHub 下载（两步 Git Data API，无 1MB 限制，CORS 兼容 file://） ====================
// auto=true 时为打开文件时自动调用：404（仓库中尚无文件）静默跳过，不弹错误
async function downloadFromGitHub(auto) {
  var settings = getGitHubSettings();
  if (!settings.user || !settings.repo) { if (!auto) showToast('配置错误', 'error'); return; }
  if (!auto) {
    updateSyncStatus('syncing', '下载中...');
    var btn = document.getElementById('downloadBtn');
    btn.disabled = true;
    btn.textContent = '⏳ 下载中...';
  }
  try {
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var headers = { 'Accept': 'application/vnd.github.v3+json' };
    if (settings.token) headers['Authorization'] = 'token ' + settings.token;

    // 第一步：GET /contents 拿 blob SHA（大文件 ≥1MB 时 content 为空，但 SHA 照常返回）
    var contentsUrl = base + '/contents/' + encodeURIComponent(settings.filePath);
    var resp1 = await fetch(contentsUrl, { headers: headers });
    if (!resp1.ok) {
      if (auto && resp1.status === 404) return;
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: HTTP ' + resp1.status, 'error'); }
      return;
    }
    var fileInfo = await resp1.json();
    if (!fileInfo.sha) throw new Error('未获取到文件 SHA');

    // 第二步：GET /git/blobs/{sha} 拿完整内容（支持任意大小，有 CORS 头）
    var resp2 = await fetch(base + '/git/blobs/' + fileInfo.sha, { headers: headers });
    if (!resp2.ok) throw new Error('获取文件内容失败 HTTP ' + resp2.status);
    var blobData = await resp2.json();
    if (!blobData.content) throw new Error('blob 内容为空');
    // GitHub 返回的 base64 可能有换行，需清理
    var htmlStr = decodeURIComponent(escape(atob(blobData.content.replace(/\s/g, ''))));
    if (!htmlStr || htmlStr.length < 100) throw new Error('解码后内容为空或过小');
    // 提取仓库文件中的 rawData
    var m = htmlStr.match(/<script id="xmData">([\s\S]*?)<\/script>/);
    if (!m) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 文件中未找到数据', 'error'); }
      return;
    }
    var newData = new Function(m[1] + '\n; return rawData;')();
    if (!Array.isArray(newData)) throw new Error('数据格式错误');
    // 打开文件自动拉取时的安全护栏：若 GitHub 记录比本地还少，说明本地有未同步改动，保留本地不覆盖
    if (auto && Array.isArray(rawData) && newData.length < rawData.length) {
      updateSyncStatus('idle', '已同步');
      showToast('⚠️ 本地有未同步改动，已保留本地数据', 'info');
      return;
    }
    rawData = newData;
    // 提取订单明细数据
    var mo = htmlStr.match(/<script id="orderData">([\s\S]*?)<\/script>/);
    if (mo) {
      try {
        var od = new Function(mo[1] + '\n; return orderData;')();
        // 同理护栏：GitHub 订单记录比本地少则保留本地
        if (!(auto && Array.isArray(orderData) && od.length < orderData.length) && Array.isArray(od)) orderData = od;
      } catch (e) {}
    }
    renumberOrders();
    // 价格明细由 rawData 中已定型行自动生成，无需单独提取
    syncOrderFromPrice();
    render();
    renderPrice();
    renderOrder();
    // 手动从 GitHub 下载后，把数据也写回本地缓存，保证下次重开也能恢复
    persistData();
    updateSyncStatus('idle', '已同步');
    if (!auto) showToast('✅ 已从 GitHub 下载 方案 ' + rawData.length + ' 条 / 订单 ' + orderData.length + ' 条', 'success');
  } catch (e) {
    if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + e.message, 'error'); }
  }
  if (!auto) {
    btn.disabled = false;
    btn.textContent = '📥 从 GitHub 下载';
  }
}

// ==================== Toast ====================
function showToast(msg, type) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + (type || 'info') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(function () { toast.classList.remove('show'); }, 3000);
}

// ==================== 初始化 ====================
loadGitHubSettings();
// 第一优先：从 localStorage 恢复（同设备即时缓存，不依赖网络）
(function () {
  try {
    var lr = localStorage.getItem(LS_KEY_RAW);
    var lo = localStorage.getItem(LS_KEY_ORDER);
    if (lr) { var d = JSON.parse(lr); if (Array.isArray(d) && d.length > 0) rawData = d; }
    if (lo) { var o = JSON.parse(lo); if (Array.isArray(o) && o.length > 0) orderData = o; }
  } catch (e) {}
})();
syncOrderFromPrice();
render();
