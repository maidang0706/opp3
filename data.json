]);
var elecTableBody = document.getElementById('elecTableBody');
var elecTable = document.getElementById('elecTable');
var elecColW = [];
var elecColGroup = null;
var elecResizerInited = false;
var elecEditingIdx = null;
var ELEC_COLW_KEY = 'xmElecColWidthsV2';
var ELEC_DEF_W = {};
for (var _eek in XM_DEF_W) ELEC_DEF_W[_eek] = XM_DEF_W[_eek];
ELEC_DEF_W['编辑'] = 92;
ELEC_DEF_W['驱动器电压等级'] = 100;
ELEC_DEF_W['驱动器功率'] = 100;
ELEC_DEF_W['配套电源线'] = 110;
ELEC_DEF_W['配套编码器线'] = 110;
ELEC_DEF_W['配套刹车电阻'] = 110;

function loadElecColW(n) {
  try { var raw = localStorage.getItem(ELEC_COLW_KEY); if (!raw) return null; var arr = JSON.parse(raw); if (Array.isArray(arr) && arr.length === n) return arr; } catch (e) {}
  return null;
}
function saveElecColW() { try { localStorage.setItem(ELEC_COLW_KEY, JSON.stringify(elecColW)); } catch (e) {} }
function applyElecColWidths(arr) {
  if (!Array.isArray(arr) || !arr.length) return false;
  if (!elecColGroup || elecColGroup.children.length !== arr.length) return false;
  elecColW = arr.slice();
  for (var i = 0; i < elecColW.length; i++) { if (elecColGroup.children[i]) elecColGroup.children[i].style.width = elecColW[i] + 'px'; }
  if (elecTable) elecTable.style.width = elecColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  saveElecColW();
  return true;
}
function buildElecHead() {
  var thead = document.getElementById('elecHead');
  if (!thead) return;
  thead.innerHTML = '';
  var tr = document.createElement('tr');
  ELEC_DISPLAY.forEach(function (d) {
    if (d.type === 'elec-op') {
      var opTh = document.createElement('th');
      opTh.textContent = '编辑';
      opTh.className = 'col-op elec-edit-head';
      tr.appendChild(opTh);
      return;
    }
    var th = document.createElement('th');
    if (d.t.indexOf('/') !== -1) th.innerHTML = d.t.replace('/', '<br>');
    else th.textContent = d.t;
    if (d.type === 'cfg') th.className = 'col-config';
    else if (d.cls) th.className = d.cls;
    if (d.elecEdit || d.type === 'elec-select') th.className = (th.className ? th.className + ' ' : '') + 'elec-edit-head';
    tr.appendChild(th);
  });
  thead.appendChild(tr);
}
function initElecColResizer() {
  if (elecResizerInited) return;
  buildElecHead();
  if (!elecTable) return;
  var ths = elecTable.querySelectorAll('thead th');
  if (!ths.length) return;
  var savedW = loadElecColW(ths.length);
  elecColGroup = document.createElement('colgroup');
  elecColGroup.id = 'elecColGroup';
  elecColW = [];
  var thList = [];
  ths.forEach(function (th, i) {
    thList.push(th);
    var title = (th.textContent || '').trim();
    var w = (savedW && savedW[i] != null) ? savedW[i] : (ELEC_DEF_W[title] || 50);
    elecColW.push(w);
    var col = document.createElement('col');
    col.style.width = w + 'px';
    elecColGroup.appendChild(col);
    var r = document.createElement('span');
    r.className = 'col-resizer';
    th.appendChild(r);
  });
  elecTable.insertBefore(elecColGroup, elecTable.firstChild);
  elecTable.style.width = elecColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  elecTable.querySelector('thead').addEventListener('mousedown', function (e) {
    var rEl = e.target.closest ? e.target.closest('.col-resizer') : null;
    if (!rEl) return;
    e.preventDefault();
    var th = rEl.parentNode;
    var idx = 0;
    for (var k = 0; k < thList.length; k++) { if (thList[k] === th) { idx = k; break; } }
    var startX = e.clientX;
    var startW = elecColW[idx];
    rEl.classList.add('active');
    function onMove(ev) {
      var nw = Math.max(36, startW + (ev.clientX - startX));
      elecColW[idx] = nw;
      elecColGroup.children[idx].style.width = nw + 'px';
      elecTable.style.width = elecColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
    }
    function onUp() {
      rEl.classList.remove('active');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.body.classList.remove('col-resizing');
      saveElecColW();
      persistData();
    }
    document.body.classList.add('col-resizing');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });
  elecResizerInited = true;
}
// 电气配置筛选：仅按「客户」与「模组下单型号」两列过滤（对应数据键 客户 / 型号）
function getElecFiltered() {
  var f = {};
  var map = { '客户': 'ef_客户', '型号': 'ef_型号' };
  Object.keys(map).forEach(function (k) {
    var el = document.getElementById(map[k]);
    if (el && el.value.trim()) f[k] = el.value.trim().toLowerCase();
  });
  var list = getPriceList();
  if (Object.keys(f).length === 0) return list;
  return list.filter(function (row) {
    return Object.keys(f).every(function (k) {
      return (row[k] || '').toString().toLowerCase().indexOf(f[k]) !== -1;
    });
  });
}
// 电气配置：展示「价格明细」全部定型行（列已剔除价格/报价类字段），原列之后、4 个可编辑列之前为「编辑」列，
// 末尾 4 列（驱动器功率/配套电源线/配套编码器线/配套刹车电阻）可通过「编辑」按钮行内编辑。
function renderElec() {
  if (!elecTableBody) return;
  elecTableBody.innerHTML = '';
  var list = getElecFiltered();
  if (list.length === 0) {
    var tr0 = document.createElement('tr');
    tr0.innerHTML = '<td colspan="' + ELEC_DISPLAY.length + '" style="padding:14px;color:#999;">暂无定型方案，请在「XM方案明细」中将方案勾选为「定型」</td>';
    elecTableBody.appendChild(tr0);
    return;
  }
  list.forEach(function (item) {
    var tr = document.createElement('tr');
    var _seqNum = parseInt(item['序列'], 10);
    if (!isNaN(_seqNum) && _seqNum % 2 === 0) tr.className = 'row-even';
    var isEditing = (elecEditingIdx === item.__idx);
    if (isEditing) tr.setAttribute('data-edit', '1');

    ELEC_DISPLAY.forEach(function (d) {
      // 编辑列（位于原列之后、4 个可编辑列之前）：编辑 / 保存·取消
      if (d.type === 'elec-op') {
        var opTd = document.createElement('td');
        opTd.className = 'col-op';
        if (isEditing) {
          var saveBtn = document.createElement('button');
          saveBtn.className = 'btn btn-primary btn-xs';
          saveBtn.textContent = '保存';
          saveBtn.onclick = function () { saveElecRowEdit(item.__idx); };
          var cancelBtn = document.createElement('button');
          cancelBtn.className = 'btn btn-outline btn-xs';
          cancelBtn.textContent = '取消';
          cancelBtn.onclick = function () { elecEditingIdx = null; renderElec(); };
          opTd.appendChild(saveBtn);
          opTd.appendChild(document.createTextNode(' '));
          opTd.appendChild(cancelBtn);
        } else {
          var editBtn = document.createElement('button');
          editBtn.className = 'btn btn-outline btn-xs';
          editBtn.textContent = '编辑';
          editBtn.onclick = function () { elecEditingIdx = item.__idx; renderElec(); };
          opTd.appendChild(editBtn);
        }
        tr.appendChild(opTd);
        return;
      }
      var td = document.createElement('td');
      if (d.cls) td.className = d.cls;
      // 驱动器电压等级：仅编辑态下显示可下拉选择（220V / 380V）；非编辑态仅展示、不可选择、无外框
      if (d.type === 'elec-select') {
        var selCur = (item[d.key] === undefined || item[d.key] === null) ? '' : item[d.key];
        if (isEditing) {
          var sel = document.createElement('select');
          sel.className = 'elec-sel';
          sel.setAttribute('data-es', d.key);
          var _opts = d.options || ['', '220V', '380V'];
          _opts.forEach(function (o) {
            var op = document.createElement('option');
            op.value = o;
            op.textContent = (o === '') ? '（未选）' : o;
            if (selCur === o) op.selected = true;
            sel.appendChild(op);
          });
          sel.onchange = (function (ri, k) {
            return function () {
              var _s = rawData[ri];
              if (_s) { _s[k] = sel.value; persistData(); scheduleSync(); }
            };
          })(item.__idx, d.key);
          td.appendChild(sel);
        } else {
          // 非编辑态：仅展示文本，无外框、不可修改
          td.className = (td.className ? td.className + ' ' : '') + 'elec-sel-display';
          td.textContent = (selCur === '' || selCur === null || selCur === undefined) ? '' : selCur;
        }
        tr.appendChild(td);
        return;
      }
      // 4 个可编辑新增列：编辑态渲染输入框（无外框、字体与展示一致），否则只读展示
      if (d.elecEdit) {
        var cur = item[d.key];
        if (isEditing) {
          var inp = document.createElement('input');
          inp.className = 'elec-cell-input';
          inp.setAttribute('data-ef', d.key);
          inp.value = (cur === '' || cur === null || cur === undefined) ? '' : cur;
          td.appendChild(inp);
        } else {
          td.textContent = (cur === '' || cur === null || cur === undefined) ? '' : cur;
        }
        tr.appendChild(td);
        return;
      }
      var val = xmDisplayValue(item, d);
      // 序列列：点击弹出「电气配置文本」弹窗（可一键复制）
      if (d.key === '序列') {
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
        td.style.cursor = 'pointer';
        td.title = '点击查看/复制方案文本';
        td.onclick = (function (ri) { return function () { openElecTextModal(ri); }; })(item.__idx);
        tr.appendChild(td);
        return;
      }
      if (d.type === 'combo') {
        var _pv1 = item[d.keys[0]] || '';
        var _pv2 = item[d.keys[1]] || '';
        td.innerHTML = escapeHtml(_pv1) + '<br>' + escapeHtml(_pv2);
      } else if (d.type === 'cfg') {
        td.className = (td.className ? td.className + ' ' : '') + 'col-config';
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      } else {
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      }
      tr.appendChild(td);
    });
    elecTableBody.appendChild(tr);
  });
}
// 电气配置行内编辑提交：仅写入 4 个可编辑新增列（驱动器功率/配套电源线/配套编码器线/配套刹车电阻），写回 XM 源数据
function saveElecRowEdit(rowIdx) {
  var _src = rawData[rowIdx];
  if (!_src) { elecEditingIdx = null; renderElec(); return; }
  ['驱动器功率', '配套电源线', '配套编码器线', '配套刹车电阻'].forEach(function (k) {
    var inp = document.querySelector('#elecTableBody tr[data-edit="1"] input[data-ef="' + k + '"]');
    if (inp) _src[k] = inp.value;
  });
  elecEditingIdx = null;
  persistData();
  scheduleSync();
  renderElec();
  showToast('✅ 已保存电气配置编辑', 'success');
}

// 电气配置：点击序列号 → 弹出方案文本（固定格式，可一键复制全部）
function openElecTextModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  var cfg = parseConfig(row['配置'] || '');
  var parts = [
    ['模组下单型号', row['型号'] || ''],
    ['电机型号', cfg['电机'] || ''],
    ['动子个数', cfg['动子个数'] || ''],
    ['驱动器型号', cfg['驱动器型号'] || ''],
    ['驱动器电压等级', row['驱动器电压等级'] || ''],
    ['驱动器功率', row['驱动器功率'] || ''],
    ['配套电源线', row['配套电源线'] || ''],
    ['配套编码器线', row['配套编码器线'] || ''],
    ['配套刹车电阻', row['配套刹车电阻'] || '无']
  ];
  var text = parts.map(function (p) { return p[0] + '(' + p[1] + ')'; }).join(',');
  document.getElementById('etText').value = text;
  document.getElementById('etTitle').textContent = row['序列'];
  document.getElementById('elecTextModal').classList.add('show');
}
function closeElecTextModal() {
  document.getElementById('elecTextModal').classList.remove('show');
}
function copyElecText() {
  var ta = document.getElementById('etText');
  if (!ta) return;
  ta.focus();
  ta.select();
  var ok = false;
  try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
  if (ok) showToast('✅ 已复制全部文本', 'success');
  else if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(ta.value).then(function () { showToast('✅ 已复制全部文本', 'success'); },
      function () { showToast('复制失败，请手动复制', 'error'); });
  }
}

// ==================== 订单明细视图（由上传的订单明细.xlsx 生成，独立维护数据） ====================
var orderColumns = ["订单类型", "订单状态", "内部订单号（必填）", "订单日期", "客户查找关联", "规格型号", "数量", "单位", "单价", "金额", "负责人", "价格申请日期", "项目名称", "配置"];
var orderEditingIdx = null;
var orderTableBody = document.getElementById('orderTableBody');
var orderTable = document.getElementById('orderTable');
// 性能优化：订单表点击高亮改用事件委托（整表一个监听），避免给每个单元格挂 onclick 闭包（2756 行约 3.8 万单元格）
if (orderTableBody && !orderTableBody._delegated) {
  orderTableBody.addEventListener('click', function (e) {
    var cell = e.target.closest ? e.target.closest('td') : null;
    if (cell && cell.tagName === 'TD') {
      if (cell.getAttribute('data-col') === '规格型号' && cell.classList.contains('order-model-dup')) {
        var mv = (cell.textContent || '').trim();
        orderModelFilter = (orderModelFilter === mv) ? null : mv;
        updateOrderModelFilterBar();
        renderOrder();
        return;
      }
      highlightOrderCell(cell);
    }
  });
  orderTableBody._delegated = true;
}
// 窗口尺寸变化会使缓存的列宽失效，下次渲染重新测量
window.addEventListener('resize', invalidateOrderColWidths);
// 数据字段重命名迁移：列标题调整后兼容旧订单数据（幂等，可重复执行）
(function migrateOrderColumns() {
  var renameMap = { '订单负责人': '负责人', '订单数量': '数量' };
  orderData.forEach(function (r) {
    Object.keys(renameMap).forEach(function (oldK) {
      if (oldK in r) { r[renameMap[oldK]] = r[oldK]; delete r[oldK]; }
    });
    if ('客户订单号' in r) delete r['客户订单号'];
  });
})();
// ===== 订单 ↔ 价格 联动 =====
var orderModelFilter = null; // 订单表按型号筛选：null 不过滤

function normalizeDate(v) {
  if (v === undefined || v === null) return '';
  var s = String(v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{2,4})[/\-.](\d{1,2})[/\-.](\d{1,2})$/);
  if (m) {
    var y = parseInt(m[1], 10); if (y < 100) y += 2000;
    var mo = String(parseInt(m[2], 10)).padStart(2, '0');
    var d = String(parseInt(m[3], 10)).padStart(2, '0');
    return y + '-' + mo + '-' + d;
  }
  return s;
}

// 统计订单表规格型号出现次数 → {counts, dupSet(>1), modelSet(全部)}
var _orderModelCache = null; // 缓存规格型号统计结果，避免每次渲染重复遍历 2756 行
function getOrderModelInfo() {
  if (_orderModelCache) return _orderModelCache;
  var counts = {}, modelSet = {}, byModel = {};
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m) return;
    counts[m] = (counts[m] || 0) + 1;
    modelSet[m] = true;
    (byModel[m] = byModel[m] || []).push({ 单价: r['单价'], 价格申请日期: r['价格申请日期'] });
  });
  var dupSet = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dupSet[k] = true; });
  _orderModelCache = { counts: counts, dupSet: dupSet, modelSet: modelSet, byModel: byModel };
  return _orderModelCache;
}

// 按「型号」从订单明细匹配 单价 → 价格明细的「成交价」。
// 匹配规则与 syncOrderFromPrice 反向一致：同型号在订单中唯一则直接取；
// 多个匹配时按「价格申请日期」精确匹配；日期也无法确定唯一时返回空，避免误填。
function lookupChengJiaPrice(model, applyDate) {
  if (model === undefined || model === null) return '';
  var m = String(model).trim();
  if (!m) return '';
  var info = getOrderModelInfo();
  var arr = info.byModel[m];
  if (!arr || !arr.length) return '';
  var getPrice = function (x) {
    var v = (x && x['单价']);
    return (v === undefined || v === null) ? '' : String(v);
  };
  if (arr.length === 1) {
    var od = normalizeDate(applyDate);
    if (od) {
      var hit = arr.filter(function (x) { return normalizeDate(x['价格申请日期']) === od; })[0];
      if (hit) return getPrice(hit);
    }
    return getPrice(arr[0]);
  }
  var ad = normalizeDate(applyDate);
  if (ad) {
    for (var i = 0; i < arr.length; i++) {
      if (normalizeDate(arr[i]['价格申请日期']) === ad) return getPrice(arr[i]);
    }
  }
  return ''; // 多匹配且日期无法唯一确定 → 不填，避免填错成交价
}

// 批量刷新：把订单明细匹配到的单价写入价格明细源数据的「成交价」，仅变更时持久化。
// 在切换/刷新价格视图时调用，保证成交价始终与订单最新状态一致。
function syncChengJiaToPrice() {
  var changed = false;
  rawData.forEach(function (r) {
    if (!r || !r['定型']) return;
    var cj = lookupChengJiaPrice(r['型号'], r['价格申请日期']);
    if ((r['成交价'] || '') !== cj) { r['成交价'] = cj; changed = true; }
  });
  if (changed) persistData();
}

// 把价格明细的项目名称/配置 同步到订单明细（按规格型号匹配；订单中该型号唯一直接填，重复则需价格申请日期一致）
function syncOrderFromPrice() {
  var priceByModel = {};
  getPriceList().forEach(function (p) {
    var m = (p['型号'] || '').toString().trim();
    if (!m) return;
    (priceByModel[m] = priceByModel[m] || []).push(p);
  });
  if (!Object.keys(priceByModel).length) return;
  var info = getOrderModelInfo();
  var changed = false;
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m || !priceByModel[m]) return;
    var candidates = priceByModel[m];
    var orderCount = info.counts[m];
    var pick = null;
    if (orderCount === 1) {
      var od = normalizeDate(r['价格申请日期']);
      pick = (od && candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od; })[0]) || candidates[0];
    } else {
      var od2 = normalizeDate(r['价格申请日期']);
      if (!od2) return;
      pick = candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od2; })[0];
      if (!pick) return;
    }
    if (pick['项目名称'] && pick['项目名称'] !== r['项目名称']) { r['项目名称'] = pick['项目名称']; changed = true; }
    if (pick['配置'] && pick['配置'] !== r['配置']) { r['配置'] = pick['配置']; changed = true; }
  });
  if (changed) persistData();
}
// 订单明细：列宽比例调整。每次渲染都基于“当前自然宽 × 比例”计算，不依赖跨渲染状态，确定可靠。
var orderFilterCols = [
  { id: 'of_customer', col: '客户查找关联' },
  { id: 'of_model', col: '规格型号' },
  { id: 'of_owner', col: '负责人' }
];

// 筛选栏与表格列对齐：每表按表头列顺序生成等宽单元格，对应列的单元格放入筛选输入框，
// 输入框宽度 = 该列宽，从而【位置】与【列宽】都和对应表格列保持一致。
var FILTER_INPUTS = {
  // 方案/价格明细筛选框均改为顶部工具栏内联（.filter-inline），宽度由 layoutXm/PriceFilterWidths 跟随列宽
  orderTable: { '客户查找关联': 'of_customer', '规格型号': 'of_model', '负责人': 'of_owner' }
};

function initFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  if (!bar || bar.dataset.built) return;
  var table = document.getElementById(tableId);
  if (!table) return;
  var ths = table.querySelectorAll('thead th');
  var map = FILTER_INPUTS[tableId] || {};
  // 先取出已有输入框与按钮（避免清空后丢失节点）；支持「一列多个输入框」堆叠
  var inputs = {};
  Object.keys(map).forEach(function (k) {
    var ids = map[k];
    if (!Array.isArray(ids)) ids = [ids];
    inputs[k] = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
  });
  var btns = [];
  var bNodes = bar.querySelectorAll('button');
  for (var b = 0; b < bNodes.length; b++) btns.push(bNodes[b]);
  bar.innerHTML = '';
  for (var i = 0; i < ths.length; i++) {
    var key = (ths[i].textContent || '').trim();
    var cell = document.createElement('div');
    cell.className = 'fcell';
    var cols = inputs[key];
    if (cols && cols.length) {
      if (cols.length === 1) {
        cell.appendChild(cols[0]);
      } else {
        var stack = document.createElement('div');
        stack.className = 'fcell-stack';
        for (var s = 0; s < cols.length; s++) stack.appendChild(cols[s]);
        cell.appendChild(stack);
      }
    }
    bar.appendChild(cell);
  }
  var actions = document.createElement('div');
  actions.className = 'fbar-actions';
  for (var j = 0; j < btns.length; j++) actions.appendChild(btns[j]);
  bar.appendChild(actions);
  bar.dataset.built = '1';
}

// 按表头列宽同步每个筛选单元格宽度（隐藏视图跳过，待显示时再布局）
function layoutFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  var table = document.getElementById(tableId);
  if (!bar || !table || !bar.dataset.built) return;
  if (table.offsetParent === null) return; // 视图隐藏时跳过
  var ths = table.querySelectorAll('thead th');
  var cells = bar.children;
  for (var i = 0; i < ths.length && i < cells.length; i++) {
    if (!cells[i].classList || !cells[i].classList.contains('fcell')) continue;
    var w = ths[i].offsetWidth;
    if (w) cells[i].style.width = w + 'px';
  }
}

// 方案明细：顶部工具栏内联筛选框宽度跟随对应列列宽（客户 / 项目号 / 项目名称 / 模组下单型号）
// 「项目号/项目名称」在表格中是合并列，这里拆成两个输入框，均分该列宽度，并随该列宽变化同步变化
function layoutXmFilterWidths() {
  var tbl = document.getElementById('dataTable');
  if (!tbl || tbl.offsetParent === null) return; // 视图隐藏时跳过
  var map = {};
  tbl.querySelectorAll('thead th').forEach(function (th) {
    map[(th.textContent || '').trim()] = th.offsetWidth;
  });
  function setW(id, w) { var el = document.getElementById(id); if (el && w) el.style.width = w + 'px'; }
  setW('f_客户', map['客户']);
  setW('f_型号', map['模组下单型号']);
  var comb = map['项目号/项目名称'] || 130;
  var half = Math.floor(comb / 2);
  setW('f_项目号', half);
  setW('f_项目名称', comb - half);
}

// 价格明细：顶部工具栏内联筛选框宽度跟随对应列列宽（与方案明细一致）
function layoutPriceFilterWidths() {
  var tbl = document.getElementById('priceTable');
  if (!tbl || tbl.offsetParent === null) return; // 视图隐藏时跳过
  var map = {};
  tbl.querySelectorAll('thead th').forEach(function (th) {
    map[(th.textContent || '').trim()] = th.offsetWidth;
  });
  function setW(id, w) { var el = document.getElementById(id); if (el && w) el.style.width = w + 'px'; }
  setW('pf_客户', map['客户']);
  setW('pf_型号', map['模组下单型号']);
  var comb = map['项目号/项目名称'] || 130;
  var half = Math.floor(comb / 2);
  setW('pf_项目号', half);
  setW('pf_项目名称', comb - half);
}

function initAllFilterBars() {
  // 方案/价格明细筛选框均已改为顶部工具栏内联（.filter-inline），宽度由 layoutXm/PriceFilterWidths 跟随列宽，无需此机制
  initFilterBar('orderTable');
}

// 连续编号：序列 = 行序（从 1 开始，顶部为 1）
function renumberOrders() {
  for (var i = 0; i < orderData.length; i++) orderData[i]['序列'] = i + 1;
}

function getOrderFiltered() {
  var f = {};
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el && el.value.trim()) f[o.col] = el.value.trim().toLowerCase();
  });
  return orderData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    if (orderModelFilter) {
      var m = (row['规格型号'] || '').toString().trim();
      if (m !== orderModelFilter) return false;
    }
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function orderCellClass(col) {
  if (col === '内部订单号（必填）') return 'col-fixed';
  if (col === '订单日期' || col === '价格申请日期') return 'col-date';
  if (col === '订单类型' || col === '订单状态' || col === '数量' || col === '单价' || col === '负责人') return 'col-half w40';
  if (col === '单位') return 'col-half w30';
  if (col === '金额') return 'col-half w50';
  if (col === '客户查找关联' || col === '规格型号') return 'col-cust';
  return '';
}

function renderOrder() {
  var list = getOrderFiltered();
  var orderModelInfo = getOrderModelInfo();
  // 预计算每列元数据（只算一次，避免每次渲染 4 万次 orderCellClass 调用与分支判断）
  if (!renderOrder._meta) {
    var meta = [];
    for (var k = 0; k < orderColumns.length; k++) {
      var col = orderColumns[k];
      meta.push({
        col: col,
        cls: orderCellClass(col),
        isDate: (col === '订单日期' || col === '价格申请日期'),
        isModel: (col === '规格型号')
      });
    }
    renderOrder._meta = meta;
  }
  var META = renderOrder._meta;
  // 按订单日期倒序排列（最新日期在最上方）
  list.sort(function (a, b) {
    return orderDateValue(b['订单日期']) - orderDateValue(a['订单日期']);
  });
  if (list.length === 0) {
    orderTableBody.innerHTML = '<tr><td colspan="' + (orderColumns.length + 2) + '" style="padding:14px;color:#999;">暂无数据</td></tr>';
    return;
  }
  // 性能优化：用单次 innerHTML 批量构建 tbody（2756 行 × 15 列约 4 万单元格），避免逐个 createElement/appendChild
  var rows = new Array(list.length);
  for (var i = 0; i < list.length; i++) {
    var item = list[i];
    var mval = (item['规格型号'] || '').toString().trim();
    var cells = ['<td class="seq-cell col-half w30" data-col="序列">' + (i + 1) + '</td>'];
    for (var k = 0; k < META.length; k++) {
      var m = META[k];
      var val = item[m.col];
      if (m.isDate) val = formatOrderDate(val);
      var disp = (val === '' || val === null || val === undefined) ? '' : String(val);
      var cls = m.cls;
      if (m.isModel && orderModelInfo.dupSet[mval]) cls = (cls ? cls + ' ' : '') + 'order-model-dup';
      cells.push('<td' + (cls ? ' class="' + cls + '"' : '') + ' data-col="' + m.col + '">' + escapeHtml(disp) + '</td>');
    }
    rows[i] = '<tr' + (item['定型'] ? ' class="finalized-row"' : '') + '>' + cells.join('') + '</tr>';
  }
  orderTableBody.innerHTML = rows.join('');
  applyOrderColumnRatios();
  scheduleAutoFit(orderTable);
  layoutFilterBar('orderTable');
}

// 列宽比例调整：首次测量并缓存结果，之后直接套用（仅写不读，去除每次渲染对上万单元格的 offsetWidth 读取）
var _orderColWidths = null; // {col: targetPx}
var _orderColMeasuring = false; // 防止同帧重复安排测量
function invalidateOrderColWidths() { _orderColWidths = null; _orderModelCache = null; }

function applyOrderColumnRatios() {
  var ratios = {
    '订单状态': 2 / 3,
    '订单日期': 2 / 3,
    '客户查找关联': 3 / 4,
    '规格型号': 3 / 4,
    '负责人': 2 / 3,
    '价格申请日期': 2 / 3
  };
  // 已缓存：直接套用，不重新测量（无 layout 读取，仅一次重排）
  if (_orderColWidths) {
    for (var c in _orderColWidths) {
      if (!ratios.hasOwnProperty(c)) continue;
      var tw = _orderColWidths[c];
      var th = document.querySelector('#orderTable th[data-col="' + c + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = tw + 'px';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + c + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = tw + 'px';
    }
    return;
  }
  var cols = Object.keys(ratios);
  // 首次测量推迟到下一帧：先让表格以自然宽瞬时呈现（点击进入不卡），后台再测宽并缓存套用
  if (_orderColMeasuring) return; // 本帧已安排测量，避免重复
  _orderColMeasuring = true;
  requestAnimationFrame(function () {
    _orderColMeasuring = false;
    // 若订单表当前不可见（例如正在「方案明细」视图中编辑、保存时触发了 renderOrder），
    // 隐藏表的 offsetWidth 为 0，测得自然宽 0 会把列宽错误锁成 18px。此时放弃测量、不写缓存，
    // 待订单视图真正显示时由 showView → renderOrder 重新触发测量（已先 invalidateOrderColWidths）。
    var _ov = document.getElementById('orderView');
    if (!_ov || _ov.offsetParent === null) return;
    // 写阶段①：清除所有目标列的固定宽，量自然宽
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = '';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = '';
    });
    // 读阶段：量取每列最大自然宽（全部读，无穿插写，仅触发一次重排）
    var res = {};
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      if (!th || !cells.length) return;
      var natural = th.offsetWidth;
      for (var i = 0; i < cells.length; i++) { var w = cells[i].offsetWidth; if (w > natural) natural = w; }
      res[col] = { th: th, cells: cells, target: Math.max(18, Math.round(natural * ratios[col])) };
    });
    // 写阶段②：统一回写目标列宽，并缓存结果供后续渲染复用
    var store = {};
    cols.forEach(function (col) {
      var r = res[col];
      if (!r) return;
      r.th.style.width = r.th.style.minWidth = r.th.style.maxWidth = r.target + 'px';
      for (var i = 0; i < r.cells.length; i++) r.cells[i].style.width = r.cells[i].style.minWidth = r.cells[i].style.maxWidth = r.target + 'px';
      store[col] = r.target;
    });
    _orderColWidths = store;
  });
}

function highlightOrderCell(td) {
  // 清除上一次高亮（整表所有 .hl）
  var prev = orderTable.querySelectorAll('td.hl, th.hl');
  Array.prototype.forEach.call(prev, function (c) { c.classList.remove('hl'); });
  var tr = td.parentElement;
  var idx = td.cellIndex;
  // 高亮整行
  Array.prototype.forEach.call(tr.querySelectorAll('td'), function (c) { c.classList.add('hl'); });
  // 高亮整列（含表头，按列索引定位）
  Array.prototype.forEach.call(orderTable.querySelectorAll('tr'), function (row) {
    var cell = row.cells[idx];
    if (cell) cell.classList.add('hl');
  });
}
function startOrderEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var rawVal = (orderData[rowIdx][col] === undefined || orderData[rowIdx][col] === null) ? '' : orderData[rowIdx][col];
  input.value = (col === '订单日期') ? formatOrderDate(rawVal) : rawVal;
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishOrderEdit(input.value, rowIdx, col); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderOrder(); }
  };
}
function finishOrderEdit(val, rowIdx, col) {
  if (orderData[rowIdx][col] !== val) {
    orderData[rowIdx][col] = val;
    persistData();
    invalidateOrderColWidths();
    renderOrder();
    scheduleSync();
  }
}
function commitOrderEdit(input, rowIdx, col) {
  orderData[rowIdx][col] = input.value;
  persistData();
  scheduleSync();
}
function editOrderRow(rowIdx) { orderEditingIdx = rowIdx; renderOrder(); }
function addOrderRow() {
  // 清空当前筛选条件，确保新增的空白行一定可见（否则空行会被筛选隐藏，造成「点了没反应」）
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el) el.value = '';
  });
  var row = { 序列: 0, 定型: false };
  orderColumns.forEach(function (c) { row[c] = ''; });
  orderData.unshift(row);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}
function toggleOrderFinalize(rowIdx) {
  orderData[rowIdx]['定型'] = !orderData[rowIdx]['定型'];
  persistData();
  renderOrder();
  scheduleSync();
}
function deleteOrderRow(idx) {
  if (!confirm('确定删除这条订单记录吗？')) return;
  orderData.splice(idx, 1);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}

// 视图切换：三个界面共用同一标题栏（方案明细 / 价格明细 / 订单明细）
function showView(name) {
  currentView = name;
  document.getElementById('xmView').style.display = (name === 'xm') ? '' : 'none';
  document.getElementById('priceView').style.display = (name === 'price') ? '' : 'none';
  document.getElementById('orderView').style.display = (name === 'order') ? '' : 'none';
  document.getElementById('elecView').style.display = (name === 'elec') ? '' : 'none';
  document.getElementById('navXm').classList.toggle('active', name === 'xm');
  document.getElementById('navPrice').classList.toggle('active', name === 'price');
  document.getElementById('navOrder').classList.toggle('active', name === 'order');
  document.getElementById('navElec').classList.toggle('active', name === 'elec');
  if (name === 'xm') { initXmColResizer(); render(); }
  else if (name === 'price') renderPrice();
  else if (name === 'elec') { initElecColResizer(); renderElec(); }
  else { invalidateOrderColWidths(); renderOrder(); }
}

// ==================== 增删 ====================
// 序列 = 方案编号（同一方案的多条变更共享同一编号；新增取最大号+1，删除方案后由 renumberSchemes 重新连续编号）
// ==================== 方案明细视图按比例缩放 ====================
var xmViewZoom = 1;
function zoomXmView(delta, reset) {
  if (reset) xmViewZoom = 1;
  else xmViewZoom = Math.min(2.0, Math.max(0.5, +(xmViewZoom + delta).toFixed(2)));
  var tbl = document.getElementById('dataTable');
  if (tbl) tbl.style.zoom = xmViewZoom;
  var lbl = document.getElementById('zoomLabel');
  if (lbl) lbl.textContent = Math.round(xmViewZoom * 100) + '%';
}

// ==================== 新增行（方案）弹窗：字段与表格列一致 ====================
var addRowSeq = null;
function openAddRowModal() {
  buildAddRowModal();
  var maxSeq = 0;
  rawData.forEach(function (r) { var n = parseFloat(r['序列']); if (!isNaN(n) && n > maxSeq) maxSeq = n; });
  addRowSeq = maxSeq + 1;
  document.getElementById('ar_seq').value = addRowSeq;
  document.getElementById('ar_date').value = todayStr();
  document.getElementById('ar_customer').value = '';
  document.getElementById('ar_projno').value = '';
  document.getElementById('ar_projname').value = '';
  document.getElementById('ar_engineer').value = '';
  document.getElementById('ar_changetime').value = nowStr();
  fillXmDetailFields('ard', { 配置: '' });
  document.getElementById('addRowModal').classList.add('show');
}
function buildAddRowModal() {
  var box = document.getElementById('arFields');
  if (!box || box.dataset.built) return;
  var fields = [
    ['ar_seq', '序列'], ['ar_date', '建档日期'], ['ar_customer', '客户'],
    ['ar_projno', '项目号'], ['ar_projname', '项目名称'], ['ar_engineer', '工程师'],
    ['ar_changetime', '变更时间']
  ];
  var html = '';
  fields.forEach(function (p) {
    html += '<div class="ch-field ch-small"><label>' + p[1] + '</label>' +
            '<input type="text" id="' + p[0] + '" placeholder="输入' + p[1] + '"></div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
  buildXmDetailFields(document.getElementById('arDetail'), 'ard', {});
}
function closeAddRowModal() {
  document.getElementById('addRowModal').classList.remove('show');
}

// 批量粘贴解析：将「名称(内容)」按类别填入新增方案弹窗的明细输入项
function parseQuickFill(scope) {
  var ta = document.getElementById(scope + 'QuickText');
  if (!ta) return;
  var text = ta.value || '';
  // 匹配 名称(内容)，支持中英文括号、名称可含 &、内容可含任意字符（除括号）
  var re = /([^(),，（）]+?)\s*[（(]\s*([^()（）]*?)\s*[)）]/g;
  var m, cnt = 0;
  // 三个弹窗的明细字段前缀：新增方案 ard_ / 新建变更 chd_ / 编辑 emd_
  var prefix = scope === 'ar' ? 'ard' : (scope === 'ch' ? 'chd' : 'emd');
  // 类别名 -> 明细字段下标；动力线/电源线 视为同一字段
  var idxByCol = {};
  XM_DETAIL_FIELDS.forEach(function (f, i) { idxByCol[f.col] = i; });
  idxByCol['电源线'] = idxByCol['动力线'];
  while ((m = re.exec(text)) !== null) {
    var name = m[1].trim();
    var val = m[2].trim();
    if (name === '' || val === '') continue;
    var idx = idxByCol[name];
    if (idx === undefined) continue;
    var el = document.getElementById(prefix + '_' + idx);
    if (el) { el.value = val; cnt++; }
  }
  if (cnt > 0) showToast('✅ 已自动填入 ' + cnt + ' 项', 'success');
  else showToast('未匹配到可填入的类别', 'error');
}
function submitAddRow() {
  var d = readXmDetailFields('ard');
  var newRow = {
    序列: document.getElementById('ar_seq').value || addRowSeq,
    建档日期: document.getElementById('ar_date').value || todayStr(),
    客户: document.getElementById('ar_customer').value.trim(),
    项目号: document.getElementById('ar_projno').value.trim(),
    项目名称: document.getElementById('ar_projname').value.trim(),
    工程师: document.getElementById('ar_engineer').value.trim(),
    变更时间: nowStr(), // 保存时刻的真实日期时间（YY/MM/DD HH:mm）
    工况: (d['工况'] || '').trim(),
    型号: (d['型号'] || '').trim(),
    配置: serializeConfig(d.cfgObj),
    定型: false
  };
  rawData.unshift(newRow);
  closeAddRowModal();
  persistData();
  refreshAfterAdd(0); // 新行置于表首；若匹配现行筛选则保留筛选，否则清除以显示
  scheduleSync();
  showToast('✅ 已新增方案 #' + newRow['序列'], 'success');
}

function deleteRow(idx) {
  if (!confirm('确定删除这条记录吗？')) return;
  rawData.splice(idx, 1);
  renumberSchemes(); // 删除方案后，剩余方案重新连续编号
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 新增变更（点击序列列弹出） ====================
// 与编辑对话框同构：建档日期/客户/项目号/项目名称 锁定（只读），工程师可编辑，变更时间默认当前时间，其余可编辑
var chPlanSeq = null; // 当前操作的方案编号
// 固定字段（与表格列一致；锁定的由同方案首行继承，可编辑的逐条变更独立）
var CHANGE_FIELDS = [
  { key: '建档日期', id: 'ch_date', locked: true },
  { key: '客户', id: 'ch_customer', locked: true },
  { key: '项目号', id: 'ch_projno', locked: true },
  { key: '项目名称', id: 'ch_projname', locked: true },
  { key: '工程师', id: 'ch_engineer' },
  { key: '变更时间', id: 'ch_changetime', locked: true }
];

// ==================== 新增行 / 新增变更 共用的「明细字段」 ====================
// 顺序与 XM_DISPLAY 表格列一致；模组总长/总行程/电机型号等配置类字段来自「配置」字符串对应子项，
// 工况及变更、模组下单型号 直接存 rawData（key=工况/型号）
var XM_DETAIL_FIELDS = [
  { col: '工况及变更', key: '工况' },
  { col: '模组下单型号', key: '型号' },
  { col: '电机型号', cfg: '电机' },
  { col: '动子个数', cfg: '动子个数' },
  { col: '驱动器型号', cfg: '驱动器型号' },
  { col: '光电&个数', cfg: '光电开关' },
  { col: '导轨', cfg: '导轨品牌' },
  { col: '读头', cfg: '读头' },
  { col: '动力线', cfg: '动力线' },
  { col: '编码器线', cfg: '编码器线' },
  { col: '图纸来源', cfg: '图纸来源' },
  { col: '刹车电阻', cfg: '刹车电阻' },
  { col: '其他', cfg: '其他备注' }
];

function escapeAttr(s) {
  return String(s == null ? '' : s).replace(/&/g, '&amp;').replace(/"/g, '&quot;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// 在 container 内生成明细字段（与表格列一致）；prefix 区分弹窗；vals={工况,型号,配置}
function buildXmDetailFields(container, prefix, vals) {
  if (!container) return;
  vals = vals || {};
  var cfg = vals['配置'] ? parseConfig(vals['配置']) : {};
  var html = '';
  XM_DETAIL_FIELDS.forEach(function (f, i) {
    var id = prefix + '_' + i;
    var v = f.key ? (vals[f.key] || '') : (cfg[f.cfg] || '');
    html += '<div class="ch-field"><label>' + f.col + '</label>' +
            '<input type="text" id="' + id + '" value="' + escapeAttr(v) + '" placeholder="输入' + f.col + '"></div>';
  });
  container.innerHTML = html;
}

// 读取明细字段，返回 { 工况, 型号, cfgObj }
function readXmDetailFields(prefix) {
  var r = { cfgObj: {} };
  XM_DETAIL_FIELDS.forEach(function (f, i) {
    var el = document.getElementById(prefix + '_' + i);
    var v = el ? el.value : '';
    if (f.key) r[f.key] = v;
    else r.cfgObj[f.cfg] = v;
  });
  return r;
}

// 向明细字段填入值（用于弹窗重新打开时回填）
function fillXmDetailFields(prefix, vals) {
  vals = vals || {};
  var cfg = vals['配置'] ? parseConfig(vals['配置']) : {};
  XM_DETAIL_FIELDS.forEach(function (f, i) {
    var el = document.getElementById(prefix + '_' + i);
    if (!el) return;
    el.value = f.key ? (vals[f.key] || '') : (cfg[f.cfg] || '');
  });
}


function buildChangeModal() {
  var box = document.getElementById('chFields');
  if (!box || box.dataset.built) return;
  var html = '';
  CHANGE_FIELDS.forEach(function (f) {
    html += '<div class="ch-field ch-small"><label>' + f.key + (f.locked ? '（只读）' : '') + '</label>' +
            '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '></div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
  // 明细字段面板（与「新增行」弹窗完全一致：工况及变更/模组下单型号/电机型号…一项一项）
  buildXmDetailFields(document.getElementById('chDetail'), 'chd', {});
}

function openChangeDialog(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  chPlanSeq = row['序列'];
  buildChangeModal();
  document.getElementById('chPlanId').textContent = row['序列'];
  CHANGE_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    if (f.key === '变更时间') {
      el.value = nowStr(); // 默认当前真实时间（YY/MM/DD HH:mm，与保存值一致），只读
    } else {
      el.value = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
    }
  });
  // 明细字段按表格列回填（工况及变更/模组下单型号/电机型号…），与「新增行」弹窗一致
  fillXmDetailFields('chd', { 工况: row['工况'], 型号: row['型号'], 配置: row['配置'] });
  document.getElementById('changeModal').classList.add('show');
  // 焦点放到第一个可编辑字段（工程师）
  setTimeout(function () { var c = document.getElementById('ch_engineer'); if (c) c.focus(); }, 50);
}

function closeChangeModal() {
  document.getElementById('changeModal').classList.remove('show');
  chPlanSeq = null;
}

function submitChange() {
  if (chPlanSeq === null && chPlanSeq !== 0) { showToast('无效方案', 'error'); return; }
  var pid = chPlanSeq;
  // 从现有方案第一条读取固定字段（建档日期/客户/项目号/项目名称/工程师），变更行继承且锁定
  var src = rawData.find(function (r) { return String(r['序列']) === String(pid); });
  if (!src) { showToast('未找到该方案', 'error'); return; }
  var d = readXmDetailFields('chd');
  var newRow = {
    序列: pid,
    建档日期: src['建档日期'],
    客户: src['客户'], 项目号: src['项目号'], 项目名称: src['项目名称'], 工程师: (document.getElementById('ch_engineer').value || '').trim(),
    变更时间: nowStr(), // 记录新增变更的真实保存时刻（YY/MM/DD HH:mm），日期与时间均为新增时刻
    工况: (d['工况'] || '').trim(),
    型号: (d['型号'] || '').trim(),
    配置: serializeConfig(d.cfgObj),
    定型: false
  };
  // 插入到该方案在表格中的最上方（同一序列号合并显示时位于块首）
  var topIdx = rawData.findIndex(function (r) { return String(r['序列']) === String(pid); });
  if (topIdx === -1) topIdx = 0;
  rawData.splice(topIdx, 0, newRow);
  closeChangeModal();
  persistData();
  refreshAfterAdd(topIdx); // 新变更行匹配现行筛选则保留筛选上下文，否则清除以显示
  scheduleSync();
  showToast('✅ 已为方案 #' + pid + ' 新增变更', 'success');
}

// ==================== 编辑方案弹窗 ====================
// 点击「编辑」按钮弹出独立对话框，输入内容后点「保存」显式写回 rawData 并刷新表格，
// 不再依赖单元格失焦来提交，彻底避免「输入内容表格显示不了」的问题
var editModalIdx = null;
var EDIT_FIELDS = [
  { key: '序列', id: 'em_seq', locked: true },
  { key: '建档日期', id: 'em_date' },
  { key: '客户', id: 'em_customer' },
  { key: '项目号', id: 'em_projno' },
  { key: '项目名称', id: 'em_projname' },
  { key: '工程师', id: 'em_engineer' },
  { key: '变更时间', id: 'em_changetime' }
];

function buildEditModal() {
  var box = document.getElementById('emFields');
  if (!box || box.dataset.built) return;
  var html = '';
  EDIT_FIELDS.forEach(function (f) {
    var cls = 'em-field';
