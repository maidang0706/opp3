function closeChangeModal() {
  document.getElementById('changeModal').classList.remove('show');
  chPlanSeq = null;
}

function submitChange() {
  if (chPlanSeq === null && chPlanSeq !== 0) { showToast('无效方案', 'error'); return; }
  var pid = chPlanSeq;
  // 从现有方案第一条读取固定字段（建档日期/客户/项目号/项目名称/工程师）
  var src = rawData.find(function (r) { return String(r['序列']) === String(pid); });
  if (!src) { showToast('未找到该方案', 'error'); return; }
  var now = new Date().toLocaleString('zh-CN');
  var newRow = {
    序列: pid,
    建档日期: src['建档日期'],
    客户: src['客户'], 项目号: src['项目号'], 项目名称: src['项目名称'], 工程师: src['工程师'],
    变更时间: now,
    工况: document.getElementById('chCond').value.trim(),
    型号: document.getElementById('chModel').value.trim(),
    配置: document.getElementById('chConfig').value.trim(),
    其他: document.getElementById('chOther').value.trim(),
    定型: false
  };
  // 插入到该方案在表格中的最上方
  var topIdx = rawData.findIndex(function (r) { return String(r['序列']) === String(pid); });
  if (topIdx === -1) topIdx = 0;
  rawData.splice(topIdx, 0, newRow);
  closeChangeModal();
  persistData();
  applyFilters();
  scheduleSync();
  showToast('✅ 已为方案 #' + pid + ' 新增变更', 'success');
}

// ==================== 编辑方案弹窗 ====================
// 点击「编辑」按钮弹出独立对话框，输入内容后点「保存」显式写回 rawData 并刷新表格，
// 不再依赖单元格失焦来提交，彻底避免「输入内容表格显示不了」的问题
var editModalIdx = null;
var EDIT_FIELDS = [
  { key: '建档日期', id: 'em_date' },
  { key: '客户', id: 'em_customer' },
  { key: '项目号', id: 'em_projno' },
  { key: '项目名称', id: 'em_projname' },
  { key: '工程师', id: 'em_engineer' },
  { key: '变更时间', id: 'em_changetime' },
  { key: '工况', id: 'em_cond' },
  { key: '型号', id: 'em_model' },
  { key: '价格申请日期', id: 'em_priceapp' },
  { key: '配置', id: 'em_config', multiline: true },
  { key: '其他', id: 'em_other', multiline: true }
];

function buildEditModal() {
  var box = document.getElementById('emFields');
  if (!box || box.dataset.built) return;
  var html = '';
  EDIT_FIELDS.forEach(function (f) {
    html += '<label>' + f.key + (f.multiline ? '（多行）' : '') + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="3" placeholder="输入' + f.key + '"></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '">';
    }
  });
  box.innerHTML = html;
  box.dataset.built = '1';
}

function openEditModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  editModalIdx = rowIdx;
  buildEditModal();
  document.getElementById('emSeq').textContent = row['序列'] || '';
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (el) el.value = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
  });
  document.getElementById('editModal').classList.add('show');
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('show');
  editModalIdx = null;
}

function saveEditModal() {
  if (editModalIdx === null) return;
  var row = rawData[editModalIdx];
  if (!row) { closeEditModal(); return; }
  var pid = String(row['序列']);
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    var val = el ? el.value : '';
    row[f.key] = val;
    // 合并列同步到同方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(f.key) !== -1) {
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[f.key] = val; });
    }
  });
  persistData();
  applyFilters();
  // 仅在点击「保存」后触发同步：价格明细项目名称/配置回填订单，并刷新各视图与 GitHub
  syncOrderFromPrice();
  renderPrice();
  renderOrder();
  scheduleSync();
  closeEditModal();
  showToast('✅ 已保存', 'success');
}

// 当前日期（YYYY/MM/DD），用于新增行默认建档日期
function todayStr() {
  var d = new Date();
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 价格明细由 XM 数据自动生成，无需单独存储
// 双层持久化：① 写入页面内嵌 script（供 GitHub 上传） ② 写入 localStorage（本地即时缓存，重开优先读取）
var LS_KEY_RAW = 'xm_rawData_v1';
var LS_KEY_ORDER = 'xm_orderData_v1';
function persistData() {
  document.getElementById('xmData').textContent = 'var rawData = ' + JSON.stringify(rawData) + ';';
  var od = document.getElementById('orderData');
  if (od) od.textContent = 'var orderData = ' + JSON.stringify(orderData) + ';';
  // 同步写入 localStorage（同设备重开的唯一可靠来源）
  try { localStorage.setItem(LS_KEY_RAW, JSON.stringify(rawData)); } catch(e) {}
  try { localStorage.setItem(LS_KEY_ORDER, JSON.stringify(orderData)); } catch(e) {}
}

// ==================== GitHub 配置 ====================
// 默认仓库/文件路径取自 XM方案明细（项目资产）。Token 仅通过头部输入框填入，不写入文件内容。
var DEFAULT_GH = {
  user: 'maidang0706',
  repo: 'OPP3',
  token: '',
  filePath: 'XM方案明细.html',
  commitMsg: 'Update XM方案明细'
};

function loadGitHubSettings() {
  try {
    var saved = localStorage.getItem('xm_github_settings');
    if (!saved) {
      saved = JSON.stringify(DEFAULT_GH);
      localStorage.setItem('xm_github_settings', saved);
    }
    updateSyncStatus('idle', '已配置');
  } catch (e) {}
}

// 获取配置：user/repo/filePath 固定，token 从 localStorage 读取，未设置则弹窗输入
function getGitHubSettings() {
  var saved = localStorage.getItem('xm_github_settings');
  var s = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT_GH));
  return s;
}

// ==================== GitHub同步 ====================
function updateSyncStatus(status, text) {
  var dot = document.querySelector('#syncStatus .sync-dot');
  var txt = document.getElementById('syncText');
  var el = document.getElementById('syncStatus');
  el.className = 'sync-status ' + status;
  txt.textContent = text || (status === 'idle' ? '已配置' : status === 'syncing' ? '同步中...' : '同步失败');
}

async function syncToGitHub() {
  var settings = getGitHubSettings();
  if (!settings.token) {
    var t = prompt('请输入 GitHub Token：');
    if (!t) return;
    settings.token = t.trim();
    localStorage.setItem('xm_github_settings', JSON.stringify(settings));
  }
  if (!settings.user || !settings.repo) { showToast('配置错误', 'error'); return; }
  updateSyncStatus('syncing', '同步中...');
  var btn = document.getElementById('syncBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 同步中...';

  try {
    // 同步前确保脚本中的 rawData 为最新
    persistData();
    var htmlContent = document.documentElement.outerHTML;
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var branch = settings.branch || 'main';
    var headers = {
      'Authorization': 'token ' + settings.token,
      'Accept': 'application/vnd.github.v3+json',
      'Content-Type': 'application/json'
    };

    // 诊断：先查 Token 是否具备仓库写权限（最常见「上传不了」的原因）
    try {
      var meResp = await fetch('https://api.github.com/user', { headers: { 'Authorization': 'token ' + settings.token, 'Accept': 'application/vnd.github.v3+json' } });
      var meScopes = meResp.headers.get('X-OAuth-Scopes') || '';
      if (meResp.ok && !/(^|,\s*)(repo|public_repo)(,|$)/.test(meScopes)) {
        showToast('⚠️ Token 缺少仓库写权限（当前: ' + (meScopes || '无') + '），上传会失败。请到 GitHub 重新生成带 repo 权限的 Token', 'error');
      } else if (!meResp.ok) {
        showToast('⚠️ Token 无效或已过期（' + meResp.status + '），请重新点「🔄 同步到 GitHub」输入', 'error');
      }
    } catch (e) {}

    // 文件超过 1MB 时 Contents API（PUT /contents）会被 GitHub 拒绝，
    // 故改用 Git Data API（blob + tree + commit），支持最大 100MB，可稳定同步大文件。
    var base64Content = btoa(unescape(encodeURIComponent(htmlContent)));

    // 1) 创建 blob
    var blobResp = await fetch(base + '/git/blobs', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ content: base64Content, encoding: 'base64' })
    });
    if (!blobResp.ok) {
      var be = await blobResp.json().catch(function(){return {};});
      throw new Error('创建 blob 失败(' + blobResp.status + '): ' + (be.message || ''));
    }
    var blob = await blobResp.json();

    // 2) 获取分支最新 commit
    var refResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), { headers: headers });
    if (!refResp.ok) { var re = await refResp.json().catch(function(){return{};}); throw new Error('获取分支失败(' + refResp.status + '): ' + (re.message || '请确认分支名是否为 ' + branch)); }
    var refData = await refResp.json();
    var latestCommitSha = refData.object.sha;

    // 3) 获取该 commit 的 tree
    var commitResp = await fetch(base + '/git/commits/' + latestCommitSha, { headers: headers });
    if (!commitResp.ok) throw new Error('获取 commit 失败');
    var commitData = await commitResp.json();
    var baseTreeSha = commitData.tree.sha;

    // 4) 用新 blob 创建新 tree（替换/新增目标文件）
    var treeResp = await fetch(base + '/git/trees', {
      method: 'POST', headers: headers,
      body: JSON.stringify({
        base_tree: baseTreeSha,
        tree: [ { path: settings.filePath, mode: '100644', type: 'blob', sha: blob.sha } ]
      })
    });
    if (!treeResp.ok) { var te = await treeResp.json().catch(function(){return{};}); throw new Error('创建 tree 失败(' + treeResp.status + '): ' + (te.message || '')); }
    var newTree = await treeResp.json();

    // 5) 创建 commit
    var newCommitResp = await fetch(base + '/git/commits', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ message: settings.commitMsg, tree: newTree.sha, parents: [latestCommitSha] })
    });
    if (!newCommitResp.ok) throw new Error('创建 commit 失败(' + newCommitResp.status + ')');
    var newCommit = await newCommitResp.json();

    // 6) 更新分支引用
    var updateRefResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), {
      method: 'PATCH', headers: headers,
      body: JSON.stringify({ sha: newCommit.sha, force: false })
    });
    if (!updateRefResp.ok) throw new Error('更新分支引用失败(' + updateRefResp.status + ')');

    updateSyncStatus('idle', '已同步');
    showToast('✅ 同步成功！', 'success');
  } catch (e) {
    updateSyncStatus('error', '同步失败');
    showToast('❌ 同步失败: ' + e.message, 'error');
  }
  btn.disabled = false;
  btn.textContent = '🔄 同步到 GitHub';
}

// 编辑后自动（防抖）同步
var _syncTimer = null;
function scheduleSync() {
  // 已改为「手动同步」：编辑/新增/删除仅写入本地缓存（persistData 中的 localStorage），
  // 不再自动上传 GitHub。需要跨设备同步时，由用户手动点击「🔄 同步到 GitHub」按钮触发。
}

// ==================== 从 GitHub 下载（使用 Raw URL，无 1MB 限制） ====================
// auto=true 时为打开文件时自动调用：404（仓库中尚无文件）静默跳过，不弹错误
async function downloadFromGitHub(auto) {
  var settings = getGitHubSettings();
  if (!settings.user || !settings.repo) { if (!auto) showToast('配置错误', 'error'); return; }
  if (!auto) {
    updateSyncStatus('syncing', '下载中...');
    var btn = document.getElementById('downloadBtn');
    btn.disabled = true;
    btn.textContent = '⏳ 下载中...';
  }
  try {
    // 使用 Raw URL 直接获取原始文件内容（无 1MB 限制，无需 base64 解码）
    // 格式：https://raw.githubusercontent.com/{user}/{repo}/{branch}/{filePath}
    var branch = settings.branch || 'main';
    var url = 'https://raw.githubusercontent.com/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo) + '/' + encodeURIComponent(branch) + '/' + encodeURIComponent(settings.filePath);
    var headers = {};
    if (settings.token) headers['Authorization'] = 'token ' + settings.token;
    var resp = await fetch(url, { headers: headers });
    if (!resp.ok) {
      if (auto && resp.status === 404) return;
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: HTTP ' + resp.status, 'error'); }
      return;
    }
    var htmlStr = await resp.text();
    if (!htmlStr || htmlStr.length < 100) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载内容为空或过小', 'error'); }
      return;
    }
    // 提取仓库文件中的 rawData
    var m = htmlStr.match(/<script id="xmData">([\s\S]*?)<\/script>/);
    if (!m) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 文件中未找到数据', 'error'); }
      return;
    }
    var newData = new Function(m[1] + '\n; return rawData;')();
    if (!Array.isArray(newData)) throw new Error('数据格式错误');
    // 打开文件自动拉取时的安全护栏：若 GitHub 记录比本地还少，说明本地有未同步改动，保留本地不覆盖
    if (auto && Array.isArray(rawData) && newData.length < rawData.length) {
      updateSyncStatus('idle', '已同步');
      showToast('⚠️ 本地有未同步改动，已保留本地数据', 'info');
      return;
    }
    rawData = newData;
    // 提取订单明细数据
    var mo = htmlStr.match(/<script id="orderData">([\s\S]*?)<\/script>/);
    if (mo) {
      try {
        var od = new Function(mo[1] + '\n; return orderData;')();
        // 同理护栏：GitHub 订单记录比本地少则保留本地
        if (!(auto && Array.isArray(orderData) && od.length < orderData.length) && Array.isArray(od)) orderData = od;
      } catch (e) {}
    }
    renumberOrders();
    // 价格明细由 rawData 中已定型行自动生成，无需单独提取
    syncOrderFromPrice();
    render();
    renderPrice();
    renderOrder();
    // 手动从 GitHub 下载后，把数据也写回本地缓存，保证下次重开也能恢复
    persistData();
    updateSyncStatus('idle', '已同步');
    if (!auto) showToast('✅ 已从 GitHub 下载 方案 ' + rawData.length + ' 条 / 订单 ' + orderData.length + ' 条', 'success');
  } catch (e) {
    if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + e.message, 'error'); }
  }
  if (!auto) {
    btn.disabled = false;
    btn.textContent = '📥 从 GitHub 下载';
  }
}

// ==================== Toast ====================
function showToast(msg, type) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + (type || 'info') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(function () { toast.classList.remove('show'); }, 3000);
}

// ==================== 初始化 ====================
loadGitHubSettings();
// 第一优先：从 localStorage 恢复（同设备即时缓存，不依赖网络）
(function () {
  try {
    var lr = localStorage.getItem(LS_KEY_RAW);
    var lo = localStorage.getItem(LS_KEY_ORDER);
    if (lr) { var d = JSON.parse(lr); if (Array.isArray(d) && d.length > 0) rawData = d; }
    if (lo) { var o = JSON.parse(lo); if (Array.isArray(o) && o.length > 0) orderData = o; }
  } catch (e) {}
})();
syncOrderFromPrice();
render();
// 点击遮罩关闭变更弹窗
document.getElementById('changeModal').addEventListener('click', function (e) {
  if (e.target === this) closeChangeModal();
});
// 点击遮罩关闭编辑方案弹窗
document.getElementById('editModal').addEventListener('click', function (e) {
  if (e.target === this) closeEditModal();
});
// Esc 关闭编辑方案弹窗
document.getElementById('editModal').addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeEditModal();
});
// 打开文件时已改为「手动同步」：仅从本地缓存(localStorage)恢复数据，不再自动从 GitHub 拉取。
// 如需跨设备最新数据，用户手动点击「📥 从 GitHub 下载」按钮。
</script>


