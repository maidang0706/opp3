  CHANGE_FIELDS.forEach(function (f) {
    html += '<div class="ch-field ch-small"><label>' + f.key + (f.locked ? '（只读）' : '') + '</label>' +
            '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '></div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
  // 明细字段面板（与「新增行」弹窗完全一致：工况及变更/模组下单型号/电机型号…一项一项）
  buildXmDetailFields(document.getElementById('chDetail'), 'chd', {});
