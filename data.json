function openEditModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  editModalIdx = rowIdx;
  buildEditModal();
  document.getElementById('emSeq').textContent = row['序列'] || '';
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    var raw = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
    // 变更时间保留原有时分（显示形如 YY/MM/DD HH:mm），不再截断为日期
    el.value = raw;
  });
  // 明细字段按表格列回填（工况及变更/模组下单型号/电机型号/导轨…）
  fillXmDetailFields('emd', { 工况: row['工况'], 型号: row['型号'], 配置: row['配置'] });
  document.getElementById('editModal').classList.add('show');
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('show');
  editModalIdx = null;
}

function saveEditModal() {
  if (editModalIdx === null) return;
  var row = rawData[editModalIdx];
  if (!row) { closeEditModal(); return; }
  var pid = String(row['序列']);
  EDIT_FIELDS.forEach(function (f) {
    if (f.locked) return; // 只读字段（如序列号）不写回，保持不可编辑
    var el = document.getElementById(f.id);
    var val = el ? el.value : '';
    // 变更时间保留完整时分（不再截断），其余字段原样保存
    row[f.key] = val;
    // 合并列同步到同方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(f.key) !== -1) {
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[f.key] = val; });
    }
  });
  // 明细字段（模组总长/总行程/工况及变更/模组下单型号…）写回 工况 / 型号 / 配置
  var ed = readXmDetailFields('emd');
  row['工况'] = (ed['工况'] || '').trim();
  row['型号'] = (ed['型号'] || '').trim();
  row['配置'] = serializeConfig(ed.cfgObj);
  persistData();
  applyFilters();
  // 仅在点击「保存」后触发同步：价格明细项目名称/配置回填订单，并刷新各视图与 GitHub
  syncOrderFromPrice();
  renderPrice();
  renderOrder();
  scheduleSync();
  closeEditModal();
  showToast('✅ 已保存', 'success');
}

// 当前日期（YYYY/MM/DD），用于新增行默认建档日期
function todayStr() {
  var d = new Date();
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 返回真实当前日期时间 YY/MM/DD HH:mm（用于「变更时间」自动记录填写/保存时刻）
function nowStr() {
  var d = new Date();
  var y = String(d.getFullYear()).slice(-2);
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  var hh = String(d.getHours()).padStart(2, '0');
  var mm = String(d.getMinutes()).padStart(2, '0');
  return y + '/' + m + '/' + day + ' ' + hh + ':' + mm;
}
// 将「变更时间」等含时分秒的日期值统一显示为 YYYY/MM/DD（与「建档日期」格式、字号一致）
function dateOnlyStr(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (!s) return '';
  if (/^\d{4}\/\d{1,2}\/\d{1,2}$/.test(s)) return s; // 已是 YYYY/MM/DD 直接返回
  var d = new Date(s);
  if (isNaN(d.getTime())) return s; // 无法解析则原样返回，避免误清内容
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 将日期格式化为 YY/MM/DD（如 26/07/27）：四位年取后两位，月份/日补零
function fmtYYMMDD(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{2,4})\/(\d{1,2})\/(\d{1,2})/);
  if (m) {
    var y = parseInt(m[1], 10);
    if (y >= 100) y = y % 100;
    var mm = String(parseInt(m[2], 10)).padStart(2, '0');
    var dd = String(parseInt(m[3], 10)).padStart(2, '0');
    return String(y).padStart(2, '0') + '/' + mm + '/' + dd;
  }
  var d = new Date(s);
  if (isNaN(d.getTime())) return s;
  return String(d.getFullYear()).slice(-2) + '/' +
    String(d.getMonth() + 1).padStart(2, '0') + '/' +
    String(d.getDate()).padStart(2, '0');
}
// 价格申请日期输入解析：支持 Excel 式简写——「1-1」/「1/1」表示今年 1 月 1 日；
// 三段「26-1-1」表示 26 年 1 月 1 日（年-月-日）；已规范为 YY/MM/DD 则原样保留
function parsePriceDateInput(s) {
  s = (s == null ? '' : String(s)).trim();
  if (!s) return '';
  // 已是 YY/MM/DD 或 YYYY/MM/DD
  var m = s.match(/^(\d{2,4})\s*[\/\-]\s*(\d{1,2})\s*[\/\-]\s*(\d{1,2})$/);
  if (m) {
    var y = parseInt(m[1], 10); if (y >= 100) y = y % 100;
    var mm = String(parseInt(m[2], 10)).padStart(2, '0');
    var dd = String(parseInt(m[3], 10)).padStart(2, '0');
    return String(y).padStart(2, '0') + '/' + mm + '/' + dd;
  }
  // 简写：用 - / . 分隔
  var parts = s.split(/[\/\-\.]/).map(function (x) { return x.trim(); }).filter(function (x) { return x !== ''; });
  if (parts.length === 2) {
    var a2 = parseInt(parts[0], 10), b2 = parseInt(parts[1], 10);
    if (!isNaN(a2) && !isNaN(b2)) {
      var yy = String(new Date().getFullYear()).slice(-2);
      return yy + '/' + String(a2).padStart(2, '0') + '/' + String(b2).padStart(2, '0');
    }
  } else if (parts.length === 3) {
    var yr = parseInt(parts[0], 10), mo = parseInt(parts[1], 10), da = parseInt(parts[2], 10);
    if (!isNaN(yr) && !isNaN(mo) && !isNaN(da)) {
      if (yr >= 100) yr = yr % 100;
      return String(yr).padStart(2, '0') + '/' + String(mo).padStart(2, '0') + '/' + String(da).padStart(2, '0');
    }
  }
  return s; // 无法识别则原样返回
}
// 将日期时间格式化为 YY/MM/DD HH:mm（如 26/07/27 00:00）；缺失时间自动补 00:00，多余秒数去除
function fmtYYMMDDHHMM(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (!s) return '';
  var parts = s.split(/\s+/);
  var datePart = fmtYYMMDD(parts[0]) || s;
  var timePart = parts[1] || '';
  if (timePart) {
    var tm = timePart.match(/^(\d{1,2}):(\d{1,2})(?::\d{1,2})?/);
    if (tm) timePart = String(parseInt(tm[1], 10)).padStart(2, '0') + ':' + String(parseInt(tm[2], 10)).padStart(2, '0');
  } else {
    timePart = '00:00';
  }
  return datePart + ' ' + timePart;
}
// 给纯日期补上 00:00 时间（用于新增变更行，使变更时间显示形如 YY/MM/DD 00:00）
function withTime00(v) {
  var s = String(v || '').trim();
  if (!s) s = todayStr();
  if (/\d{1,2}:\d{1,2}/.test(s)) return s;
  return s + ' 00:00';
}
// 价格明细由 XM 数据自动生成，无需单独存储
// 双层持久化：① 写入页面内嵌 script（供 GitHub 上传） ② 写入 localStorage（本地即时缓存，重开优先读取）
var LS_KEY_RAW = 'xm_rawData_v1';
var LS_KEY_ORDER = 'xm_orderData_v1';
var LS_KEY_DIRTY = 'xm_dirty_v1';
function persistData() {
  document.getElementById('xmData').textContent = 'var rawData = ' + JSON.stringify(rawData) + ';';
  var od = document.getElementById('orderData');
  if (od) od.textContent = 'var orderData = ' + JSON.stringify(orderData) + ';';
  // 同步写入 localStorage（同设备重开的即时缓存）
  try { localStorage.setItem(LS_KEY_RAW, JSON.stringify(rawData)); } catch(e) {}
  try { localStorage.setItem(LS_KEY_ORDER, JSON.stringify(orderData)); } catch(e) {}
  // 标记本机有改动（尚未同步到 GitHub），供打开时自动拉取判断是否需保护本地数据
  try { localStorage.setItem(LS_KEY_DIRTY, '1'); } catch(e) {}
  // 列宽一并写入文件内存储（随整个 HTML 上传 GitHub），列数一致才写入
  try {
    var _cwEl = document.getElementById('xmColW');
    if (_cwEl && xmResizerInited && xmColW.length) {
      _cwEl.textContent = 'var XM_SAVED_W = ' + JSON.stringify(xmColW) + ';';
    }
    var _pcwEl = document.getElementById('priceColW');
    if (_pcwEl && priceResizerInited && priceColW.length) {
      _pcwEl.textContent = 'var PRICE_SAVED_W = ' + JSON.stringify(priceColW) + ';';
    }
  } catch(e) {}
}
// 清除本机改动标记：表示本机已与 GitHub 一致
function clearDirty() { try { localStorage.setItem(LS_KEY_DIRTY, '0'); } catch(e) {} }
function isDirty() { try { return localStorage.getItem(LS_KEY_DIRTY) === '1'; } catch(e) { return false; } }

// ==================== GitHub 配置 ====================
// 默认仓库/文件路径取自 XM方案明细（项目资产）。Token 仅通过头部输入框填入，不写入文件内容。
var DEFAULT_GH = {
  user: 'maidang0706',
  repo: 'OPP3',
  token: '',
  filePath: 'data.json',  // 统一同步通道：电脑端和手机端都读写 data.json（内容为本页面 HTML 快照）
  commitMsg: 'Update data.json'
};

function loadGitHubSettings() {
  try {
    var saved = localStorage.getItem('xm_github_settings');
    if (!saved) {
      saved = JSON.stringify(DEFAULT_GH);
      localStorage.setItem('xm_github_settings', saved);
    }
    updateSyncStatus('idle', '已配置');
  } catch (e) {}
}

// 获取配置：user/repo/filePath 固定，token 从 localStorage 读取，未设置则弹窗输入
function getGitHubSettings() {
  var saved = localStorage.getItem('xm_github_settings');
  var s = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT_GH));
  // 强制迁移：无论本机 localStorage 里存的是旧路径(XM方案明细.html)还是别的，
  // 一律统一为 data.json，保证电脑端/手机端读写同一个文件，杜绝双通道分裂
  if (s.filePath !== DEFAULT_GH.filePath || s.user !== DEFAULT_GH.user || s.repo !== DEFAULT_GH.repo) {
    s.filePath = DEFAULT_GH.filePath;
    s.user = DEFAULT_GH.user;
    s.repo = DEFAULT_GH.repo;
    s.commitMsg = DEFAULT_GH.commitMsg;
    try { localStorage.setItem('xm_github_settings', JSON.stringify(s)); } catch (e) {}
  }
  return s;
}

// ==================== GitHub同步 ====================
function updateSyncStatus(status, text) {
  var dot = document.querySelector('#syncStatus .sync-dot');
  var txt = document.getElementById('syncText');
  var el = document.getElementById('syncStatus');
  el.className = 'sync-status ' + status;
  // 在状态里显示当前读写分支，便于一眼发现「两端分支不一致」导致的数据分歧
  var settings = getGitHubSettings();
  var br = settings.branch || 'main';
  txt.textContent = (text || (status === 'idle' ? '已配置' : status === 'syncing' ? '同步中...' : '同步失败')) + ' · 分支:' + br + ' · 文件:' + (settings.filePath || '?');
}

async function syncToGitHub() {
  var settings = getGitHubSettings();
  if (!settings.token) {
    var t = prompt('请输入 GitHub Token：');
    if (!t) return;
    settings.token = t.trim();
    localStorage.setItem('xm_github_settings', JSON.stringify(settings));
  }
  if (!settings.user || !settings.repo) { showToast('配置错误', 'error'); return; }
  updateSyncStatus('syncing', '同步中...');
  var btn = document.getElementById('syncBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 同步中...';

  try {
    // 同步前确保脚本中的 rawData 为最新
    persistData();
    var htmlContent = document.documentElement.outerHTML;
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var branch = settings.branch || 'main';
    var headers = {
      'Authorization': 'token ' + settings.token,
      'Accept': 'application/vnd.github.v3+json',
      'Content-Type': 'application/json'
    };

    // 诊断：先查 Token 是否具备仓库写权限（最常见「上传不了」的原因）
    try {
      var meResp = await fetch('https://api.github.com/user', { headers: { 'Authorization': 'token ' + settings.token, 'Accept': 'application/vnd.github.v3+json' } });
      var meScopes = meResp.headers.get('X-OAuth-Scopes') || '';
      if (meResp.ok && !/(^|,\s*)(repo|public_repo)(,|$)/.test(meScopes)) {
        showToast('⚠️ Token 缺少仓库写权限（当前: ' + (meScopes || '无') + '），上传会失败。请到 GitHub 重新生成带 repo 权限的 Token', 'error');
      } else if (!meResp.ok) {
        showToast('⚠️ Token 无效或已过期（' + meResp.status + '），请重新点「🔄 同步到 GitHub」输入', 'error');
      }
    } catch (e) {}

    // 文件超过 1MB 时 Contents API（PUT /contents）会被 GitHub 拒绝，
    // 故改用 Git Data API（blob + tree + commit），支持最大 100MB，可稳定同步大文件。
    var base64Content = btoa(unescape(encodeURIComponent(htmlContent)));

    // 1) 创建 blob
    var blobResp = await fetch(base + '/git/blobs', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ content: base64Content, encoding: 'base64' })
    });
    if (!blobResp.ok) {
      var be = await blobResp.json().catch(function(){return {};});
      throw new Error('创建 blob 失败(' + blobResp.status + '): ' + (be.message || ''));
    }
    var blob = await blobResp.json();

    // 2) 获取分支最新 commit
    var refResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), { headers: headers });
    if (!refResp.ok) { var re = await refResp.json().catch(function(){return{};}); throw new Error('获取分支失败(' + refResp.status + '): ' + (re.message || '请确认分支名是否为 ' + branch)); }
    var refData = await refResp.json();
    var latestCommitSha = refData.object.sha;

    // 3) 获取该 commit 的 tree
    var commitResp = await fetch(base + '/git/commits/' + latestCommitSha, { headers: headers });
    if (!commitResp.ok) throw new Error('获取 commit 失败');
    var commitData = await commitResp.json();
    var baseTreeSha = commitData.tree.sha;

    // 4) 用新 blob 创建新 tree（替换/新增目标文件）
    var treeResp = await fetch(base + '/git/trees', {
      method: 'POST', headers: headers,
      body: JSON.stringify({
        base_tree: baseTreeSha,
        tree: [ { path: settings.filePath, mode: '100644', type: 'blob', sha: blob.sha } ]
      })
    });
    if (!treeResp.ok) { var te = await treeResp.json().catch(function(){return{};}); throw new Error('创建 tree 失败(' + treeResp.status + '): ' + (te.message || '')); }
    var newTree = await treeResp.json();

    // 5) 创建 commit
    var newCommitResp = await fetch(base + '/git/commits', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ message: settings.commitMsg, tree: newTree.sha, parents: [latestCommitSha] })
    });
    if (!newCommitResp.ok) throw new Error('创建 commit 失败(' + newCommitResp.status + ')');
    var newCommit = await newCommitResp.json();

    // 6) 更新分支引用
    var updateRefResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), {
      method: 'PATCH', headers: headers,
      body: JSON.stringify({ sha: newCommit.sha, force: false })
    });
    if (!updateRefResp.ok) throw new Error('更新分支引用失败(' + updateRefResp.status + ')');

    clearDirty();
    updateSyncStatus('idle', '已同步');
    showToast('✅ 同步成功！', 'success');
  } catch (e) {
    updateSyncStatus('error', '同步失败');
    showToast('❌ 同步失败: ' + e.message, 'error');
  }
  btn.disabled = false;
  btn.textContent = '🔄 同步到 GitHub';
}

// 编辑后自动（防抖）同步
var _syncTimer = null;
function scheduleSync() {
  // 已改为「手动同步」：编辑/新增/删除仅写入本地缓存（persistData 中的 localStorage），
  // 不再自动上传 GitHub。需要跨设备同步时，由用户手动点击「🔄 同步到 GitHub」按钮触发。
}

// ==================== 从 GitHub 下载（两步 Git Data API，无 1MB 限制，CORS 兼容 file://） ====================
// auto=true 时为打开文件时自动调用：404（仓库中尚无文件）静默跳过，不弹错误
async function downloadFromGitHub(auto) {
  var settings = getGitHubSettings();
  if (!settings.user || !settings.repo) { if (!auto) showToast('配置错误', 'error'); return; }
  if (!auto) {
    updateSyncStatus('syncing', '下载中...');
    var btn = document.getElementById('downloadBtn');
    btn.disabled = true;
    btn.textContent = '⏳ 下载中...';
  }
  try {
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var headers = { 'Accept': 'application/vnd.github.v3+json' };
    if (settings.token) headers['Authorization'] = 'token ' + settings.token;

    // 第一步：GET /contents 拿 blob SHA（大文件 ≥1MB 时 content 为空，但 SHA 照常返回）
    // 关键修复：下载必须与上传使用同一分支。上传使用 settings.branch || 'main'，
    // 此处也必须带 ?ref= 读取同一分支，否则会读到仓库「默认分支」(可能是 master)，
    // 导致上传到 main、下载读默认分支，两台电脑从不同分支取数而对不齐。
    var branch = settings.branch || 'main';
    var contentsUrl = base + '/contents/' + encodeURIComponent(settings.filePath) + '?ref=' + encodeURIComponent(branch);
    var resp1 = await fetch(contentsUrl, { headers: headers });
    if (!resp1.ok && resp1.status === 404) {
      // 兼容：若该分支无此文件，回退读取仓库默认分支
      var resp1b = await fetch(base + '/contents/' + encodeURIComponent(settings.filePath), { headers: headers });
      if (resp1b.ok) resp1 = resp1b;
    }
    if (!resp1.ok) {
      if (auto && resp1.status === 404) return;
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: HTTP ' + resp1.status, 'error'); }
      return;
    }
    var fileInfo = await resp1.json();
    if (!fileInfo.sha) throw new Error('未获取到文件 SHA');

    // 第二步：GET /git/blobs/{sha} 拿完整内容（支持任意大小，有 CORS 头）
    var resp2 = await fetch(base + '/git/blobs/' + fileInfo.sha, { headers: headers });
    if (!resp2.ok) throw new Error('获取文件内容失败 HTTP ' + resp2.status);
    var blobData = await resp2.json();
    if (!blobData.content) throw new Error('blob 内容为空');
    // GitHub 返回的 base64 可能有换行，需清理
    var htmlStr = decodeURIComponent(escape(atob(blobData.content.replace(/\s/g, ''))));
    if (!htmlStr || htmlStr.length < 100) throw new Error('解码后内容为空或过小');
    // 提取仓库文件中的 rawData
    var m = htmlStr.match(/<script id="xmData">([\s\S]*?)<\/script>/);
    if (!m) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 文件中未找到数据', 'error'); }
      return;
    }
    var newData = new Function(m[1] + '\n; return rawData;')();
    if (!Array.isArray(newData)) throw new Error('数据格式错误');
    // 先解析 GitHub 上的订单明细
    var newOrder = orderData;
    var mo = htmlStr.match(/<script id="orderData">([\s\S]*?)<\/script>/);
    if (mo) {
      try {
        var od = new Function(mo[1] + '\n; return orderData;')();
        if (Array.isArray(od)) newOrder = od;
      } catch (e) {}
    }
    // 打开时自动拉取：以 GitHub 为准，覆盖本机缓存，保证跨设备一致。
    // 唯一例外——本机有未同步改动(dirty)且与 GitHub 不同时，保护本地不覆盖，提示用户先同步。
    var _changed = JSON.stringify(newData) !== JSON.stringify(rawData) || JSON.stringify(newOrder) !== JSON.stringify(orderData);
    if (auto && isDirty() && _changed) {
      // 注意：此处并未与 GitHub 同步，而是保留了本机缓存，故状态绝不能显示“已同步”
      updateSyncStatus('warn', '⚠️ 本地有未同步改动');
      showToast('⚠️ 本机有未同步改动，未自动覆盖（当前显示的是本机缓存）。请先点「🔄 同步到 GitHub」上传，或手动点「📥 从 GitHub 下载」放弃本机改动', 'info');
      return;
    }
    rawData = newData;
    orderData = newOrder;
    _orderModelCache = null; // 订单数据已更新，失效规格型号/单价缓存，保证成交价匹配最新
    renumberOrders();
    // 价格明细由 rawData 中已定型行自动生成，无需单独提取
    syncOrderFromPrice();
    // 恢复 GitHub 上保存的列宽（列数一致才应用；不一致则保持本机列宽）
    try {
      var mw = htmlStr.match(/var XM_SAVED_W\s*=\s*(\[[\s\S]*?\])\s*;/);
      if (mw) {
        var w = JSON.parse(mw[1]);
        if (Array.isArray(w) && w.length) applyXmColWidths(w);
        var pmw = htmlStr.match(/var PRICE_SAVED_W\s*=\s*(\[[\s\S]*?\])\s*;/);
        if (pmw) { var pw = JSON.parse(pmw[1]); if (Array.isArray(pw) && pw.length) applyPriceColWidths(pw); }
      }
    } catch (e) {}
    render();
    renderPrice();
    renderOrder();
    // 从 GitHub 下载后写回本地缓存，并清除改动标记（此刻本机与 GitHub 一致）
    persistData();
    clearDirty();
    updateSyncStatus('idle', '已同步');
    if (!auto) showToast('✅ 已从 GitHub 下载 方案 ' + rawData.length + ' 条 / 订单 ' + orderData.length + ' 条', 'success');
    else if (_changed) showToast('🔄 打开时已自动载入 GitHub 最新数据', 'info');
  } catch (e) {
    if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + e.message, 'error'); }
  }
  if (!auto) {
    btn.disabled = false;
    btn.textContent = '📥 从 GitHub 下载';
  }
}

// ==================== Toast ====================
function showToast(msg, type) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + (type || 'info') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(function () { toast.classList.remove('show'); }, 3000);
}

// ==================== 初始化 ====================
loadGitHubSettings();
// 即时渲染：先用本机缓存快速显示（离线也能先看到内容），随后自动从 GitHub 拉取最新覆盖
// 【一次性合并保护】2026-07-27 已将手机端(data.json通道)与电脑端数据合并为505条写入本文件。
// 首次打开时忽略旧缓存、以文件内嵌合并数据为准，并置"未同步"标记，防止被 GitHub 旧版覆盖，直到用户点「🔄 同步」推上去。
var MERGE_VER = 'merge-20260811-price-refactor';
var _mergeApplied = false;
(function () {
  try {
    if (localStorage.getItem('xm_merge_ver') !== MERGE_VER) {
      localStorage.setItem('xm_merge_ver', MERGE_VER);
      _mergeApplied = true;
      persistData(); // 内嵌合并数据写入缓存，并置 dirty 保护
      return;
    }
    var lr = localStorage.getItem(LS_KEY_RAW);
    var lo = localStorage.getItem(LS_KEY_ORDER);
    if (lr) { var d = JSON.parse(lr); if (Array.isArray(d) && d.length > 0) rawData = d; }
    if (lo) { var o = JSON.parse(lo); if (Array.isArray(o) && o.length > 0) orderData = o; }
    _orderModelCache = null; // 订单数据从缓存载入后失效缓存，保证成交价匹配最新
  } catch (e) {}
})();
syncOrderFromPrice();
buildXmHead();
buildPriceHead();
initAllFilterBars();
initXmColResizer();
initPriceColResizer();
currentView = 'xm'; // 初始化当前视图，否则 applyFilters 不会刷新方案明细表
render();
renderPrice();
renderOrder();
// 窗口尺寸变化时重新对齐筛选栏（仅对可见视图生效）
window.addEventListener('resize', function () {
  layoutXmFilterWidths();
  layoutPriceFilterWidths();
  layoutFilterBar('orderTable');
});
// 点击遮罩关闭弹窗：仅当 mousedown 也在遮罩上（即真正点击遮罩关闭）才触发，
// 避免「在输入框内选词、鼠标拖到遮罩外松开」这类文本选择拖动误关弹窗。
function bindBackdropClose(modalId, closeFn) {
  var modal = document.getElementById(modalId);
  var downOnBackdrop = false;
  modal.addEventListener('mousedown', function (e) {
    downOnBackdrop = (e.target === modal);
  });
  modal.addEventListener('click', function (e) {
    if (downOnBackdrop && e.target === modal) closeFn();
  });
}
bindBackdropClose('changeModal', closeChangeModal);
bindBackdropClose('editModal', closeEditModal);
bindBackdropClose('priceTextModal', closePriceTextModal);
bindBackdropClose('elecTextModal', closeElecTextModal);
// Esc 关闭编辑方案弹窗
document.getElementById('editModal').addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeEditModal();
});
// 打开文件时自动从 GitHub 拉取最新数据（以 GitHub 为准，覆盖本机缓存），保证跨设备一致。
// 例外：本机有未同步改动时会自动保护并提示先同步；离线或仓库无文件(404)时静默保留本机缓存。
if (_mergeApplied) {
  // 合并数据首次生效：不自动拉取（GitHub 上还是旧版），提示用户先同步推送合并结果
  updateSyncStatus('warn', '合并数据待上传');
  showToast('✅ 已载入合并后的 505 条数据（含手机端最新记录），请点「🔄 同步到 GitHub」推送，之后手机端重新下载即可一致', 'info');
} else {
  downloadFromGitHub(true);
}
</script>


