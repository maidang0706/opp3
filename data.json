<script>
// ==================== 列定义 ====================
var allColumns = ["序列", "建档日期", "客户", "项目号", "项目名称", "工程师", "变更时间", "工况", "型号", "配置", "其他"];
// 同一方案的固定列（同一序列号的多条变更合并显示）
var MERGE_COLS = ["序列", "建档日期", "客户", "项目号", "项目名称", "工程师"];

// ==================== 配置列模板 ====================
// 固定文字 + （）可填入；（）内文本蓝底
var CONFIG_FIELDS = ["电机", "动子个数", "驱动器型号", "光电开关", "导轨品牌", "读头", "动力线", "编码器线", "图纸来源", "刹车电阻", "其他备注"];

function escapeHtml(s) {
  s = String(s == null ? '' : s);
  if (s.indexOf('&') === -1 && s.indexOf('<') === -1 && s.indexOf('>') === -1) return s;
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// 将存储的「配置」字符串解析为 { 字段: 值 }
function parseConfig(str) {
  var obj = {};
  CONFIG_FIELDS.forEach(function (f) {
    var re = new RegExp(f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '（([^）]*)）');
    var m = (str || '').match(re);
    obj[f] = m ? m[1] : '';
  });
  return obj;
}

// 将 { 字段: 值 } 序列化回模板字符串
function serializeConfig(obj) {
  return CONFIG_FIELDS.map(function (f) { return f + '（' + (obj[f] || '') + '）'; }).join('，');
}

// 非编辑态展示：固定文字 + 蓝底（）内容（旧版自由文本原样显示，避免丢失）
function configDisplay(val) {
  if (val && !CONFIG_FIELDS.some(function (f) { return String(val).indexOf(f) !== -1; })) {
    return escapeHtml(val);
  }
  var obj = parseConfig(val || '');
  return CONFIG_FIELDS.map(function (f) {
    return f + '（<span class="cfg-fill">' + escapeHtml(obj[f] || '') + '</span>）';
  }).join('，');
}

// 编辑态：每个（）渲染为蓝底输入框，失焦即保存对应字段
function buildConfigEditor(td, rowIdx, isPrice) {
  td.className = '';
  td.style.padding = '4px 6px';
  td.style.textAlign = 'left';
  td.style.verticalAlign = 'top';
  var current = parseConfig(rawData[rowIdx]['配置']);
  CONFIG_FIELDS.forEach(function (f) {
    var wrap = document.createElement('div');
    wrap.style.margin = '2px 0';
    var label = document.createElement('span');
    label.textContent = f;
    var open = document.createTextNode('（');
    var input = document.createElement('input');
    input.value = current[f] || '';
    input.className = 'cfg-input';
    input.setAttribute('placeholder', '填写');
    var close = document.createTextNode('）');
    wrap.appendChild(label); wrap.appendChild(open); wrap.appendChild(input); wrap.appendChild(close);
    input.onblur = (function (ri, field, inp) {
      return function () {
        var o = parseConfig(rawData[ri]['配置']);
        o[field] = inp.value;
        rawData[ri]['配置'] = serializeConfig(o);
        persistData();
        scheduleSync();
      };
    })(rowIdx, f, input);
    input.onkeydown = function (e) {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      else if (e.key === 'Escape') { if (isPrice) { priceEditingIdx = null; renderPrice(); } else { editingIdx = null; render(); } }
    };
    td.appendChild(wrap);
  });
}

// 重新连续编号：同一方案（序列号相同）共享一个编号；自底向上编号，使最小的序列号在表格最下方，依次向上递增
function renumberSchemes() {
  var counter = 0;
  var currentSeq = null;
  for (var i = rawData.length - 1; i >= 0; i--) {
    var r = rawData[i];
    if (String(r['序列']) !== String(currentSeq)) {
      counter++;
      currentSeq = r['序列'];
    }
    r['序列'] = counter;
  }
}

// ==================== 渲染 ====================
var tableBody = document.getElementById('tableBody');

// 自动缩放「建档日期 / 变更时间」列的文字大小，使其在不换行的前提下适配固定列宽
// 仅适配选定表（或可见表）中需要字号自适应的列；按列缓存样式，消除逐单元格 getComputedStyle 重排风暴
var _AUTOFIT_SEL = 'th.col-time,td.col-time,th.col-date,td.col-date,th.col-date-sm,td.col-date-sm,th.col-fixed,td.col-fixed,th.col-half,td.col-half,th.col-cust,td.col-cust';

function autoFitColumnText(scope) {
  var tables;
  if (scope) {
    tables = [scope];
  } else {
    // 未指定时仅处理可见表，跳过被隐藏视图（避免对另一张表的数万单元格做无谓计算）
    tables = [document.getElementById('priceTable'), document.getElementById('orderTable'), document.getElementById('tableBody')];
    tables = tables.filter(function (t) { return t && t.offsetParent !== null; });
  }
  for (var t = 0; t < tables.length; t++) autoFitTable(tables[t]);
}

function autoFitTable(table) {
  var cells = table.querySelectorAll(_AUTOFIT_SEL);
  if (!cells || !cells.length) return;
  // 写阶段①：统一重置字号（仅触发一次布局）
  for (var i = 0; i < cells.length; i++) {
    var c = cells[i];
    if (c.querySelector('input')) continue; // 编辑态（输入框）跳过
    c.style.whiteSpace = 'nowrap';
    c.style.fontSize = '';
  }
  // 按列缓存 padding / 可用宽 / 基准字号：每列仅 1 次 getComputedStyle（原来每单元格 1 次）
  var colInfo = {};
  function colInfoOf(cell) {
    var idx = cell.cellIndex;
    if (colInfo[idx]) return colInfo[idx];
    var cs = getComputedStyle(cell);
    var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
    var avail = cell.clientWidth - pad;
    var base = parseFloat(cs.fontSize) || 13;
    var info = { avail: avail, base: base };
    colInfo[idx] = info;
    return info;
  }
  // 读阶段：仅逐单元格读 scrollWidth（无穿插写，整表仅一次重排）
  var targets = [];
  for (var j = 0; j < cells.length; j++) {
    var cell = cells[j];
    if (cell.querySelector('input')) continue;
    var info = colInfoOf(cell);
    if (info.avail <= 0) continue; // 隐藏列跳过
    var textW = cell.scrollWidth;
    if (textW > info.avail + 0.5) {
      var size = Math.max(6, info.base * (info.avail / textW));
      targets.push([cell, size.toFixed(1) + 'px']);
    }
  }
  // 写阶段②：回写目标字号（再触发一次布局）
  for (var k = 0; k < targets.length; k++) targets[k][0].style.fontSize = targets[k][1];
}

// 将字体自适应推迟到下一帧绘制之后：让表格内容先呈现，再微调字号，点击进入视图不再卡顿
function scheduleAutoFit(scope) {
  requestAnimationFrame(function () {
    autoFitColumnText(scope);
  });
}

// 单单元格自适应（供局部更新后调用，避免整表重排）
function fitSingleCell(cell) {
  if (!cell || cell.querySelector('input')) return;
  cell.style.whiteSpace = 'nowrap';
  cell.style.fontSize = '';
  var cs = getComputedStyle(cell);
  var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
  var avail = cell.clientWidth - pad;
  if (avail <= 0) return;
  var textW = cell.scrollWidth;
  if (textW > avail + 0.5) {
    var base = parseFloat(cs.fontSize) || 13;
    var size = Math.max(6, base * (avail / textW));
    cell.style.fontSize = size.toFixed(1) + 'px';
  }
}

// 订单日期统一显示为 YY/MM/DD（如 26/01/01）
function formatOrderDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 价格明细表建档日期统一显示为 YY/MM/DD（如 26/01/01）
function formatPriceDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})[\/-](\d{2})[\/-](\d{2})$/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 将订单日期统一解析为可比较的时间戳（兼容 26/01/01 与 2026-01-01）
function orderDateValue(v) {
  if (v === '' || v === null || v === undefined) return 0;
  var s = String(v).trim();
  var m = s.match(/^(\d{2})\/(\d{2})\/(\d{2})$/);
  if (m) s = '20' + m[1] + '-' + m[2] + '-' + m[3];
  var t = Date.parse(s);
  return isNaN(t) ? 0 : t;
}

function render() {
  tableBody.innerHTML = '';
  var list = getFiltered();
  if (list.length === 0) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="' + (allColumns.length + 1) + '" style="padding:14px;color:#999;">暂无数据，点击「＋ 新增行」添加</td>';
    tableBody.appendChild(tr);
    return;
  }
  // 计算每个方案块（序列连续相同）的起始行与跨度，用于合并单元格
  list.forEach(function (item, idx) {
    item._isStart = (idx === 0) || (String(item['序列']) !== String(list[idx - 1]['序列']));
    if (item._isStart) {
      var span = 1;
      while (idx + span < list.length && String(list[idx + span]['序列']) === String(item['序列'])) span++;
      item._span = span;
    }
  });
  list.forEach(function (item, idx) {
    var tr = document.createElement('tr');
    // 偶数序列号的方案行使用浅黄背景，便于区分
    var _seqNum = parseInt(item['序列'], 10);
    if (!isNaN(_seqNum) && _seqNum % 2 === 0) tr.className = 'row-even';
    if (rawData[item.__idx]['定型']) tr.className += ' finalized-row';
    // 操作列：删除 / 编辑 / 定型 三个按钮纵向排列
    var tdOp = document.createElement('td');
    tdOp.className = 'op-cell';
    var rowIdx = item.__idx;
    var isEditing = (editingIdx === rowIdx);
    // 删除
    var del = document.createElement('button');
    del.className = 'op-btn del-btn';
    del.textContent = '删除';
    del.onclick = (function (ri) { return function () { deleteRow(ri); }; })(rowIdx);
    tdOp.appendChild(del);
    // 编辑 / 完成（编辑模式下切换为「完成」）
    var editBtn = document.createElement('button');
    editBtn.className = 'op-btn edit-btn';
    editBtn.textContent = '编辑';
    editBtn.onclick = (function (ri) { return function () { openEditModal(ri); }; })(rowIdx);
    tdOp.appendChild(editBtn);
    // 定型（勾选按钮，按变更行独立）
    var finalized = !!rawData[rowIdx]['定型'];
    var finBtn = document.createElement('button');
    finBtn.className = 'op-btn finalize-btn' + (finalized ? ' finalized' : '');
    finBtn.textContent = finalized ? '☑定' : '☐定';
    finBtn.onclick = (function (ri) { return function () { toggleFinalize(ri); }; })(rowIdx);
    tdOp.appendChild(finBtn);
    tr.appendChild(tdOp);
    // 数据列
    allColumns.forEach(function (col) {
      // 合并列：非方案起始行不渲染该单元格（由起始行的 rowspan 覆盖）
      if (MERGE_COLS.indexOf(col) !== -1 && !item._isStart) return;
      var td = document.createElement('td');
      if (col === '变更时间') td.className = 'col-time';
      if (col === '建档日期') td.className = 'col-date';
      if (col === '型号') td.className = 'col-model';
      if (editingIdx === item.__idx) {
        if (col === '配置') {
          // 配置列：模板编辑器（固定文字 + 蓝底输入框）
          buildConfigEditor(td, item.__idx, false);
        } else {
          // 整行编辑模式：渲染输入框
          var input = document.createElement('input');
          input.className = 'cell-input';
          input.value = (rawData[item.__idx][col] === undefined || rawData[item.__idx][col] === null) ? '' : rawData[item.__idx][col];
          td.appendChild(input);
          input.onblur = (function (ri, c, inp) { return function () { commitEdit(inp, ri, c); }; })(item.__idx, col, input);
          input.onkeydown = function (e) {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            else if (e.key === 'Escape') { editingIdx = null; render(); }
          };
        }
      } else {
        var val = item[col];
        if (col === '配置') {
          // 配置列：固定文字 + 蓝底（）内容，点击进入整行编辑
          td.innerHTML = configDisplay(val);
          td.style.cursor = 'pointer';
          td.style.textAlign = 'left';
          td.onclick = (function (ri) { return function () { editRow(ri); }; })(item.__idx);
        } else if (col === '序列') {
          // 序列列：同一方案合并显示，点击弹出「新增变更」对话框
          td.className = 'seq-cell';
          td.rowSpan = item._span;
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
          td.onclick = (function (rowIdx) { return function () { openChangeDialog(rowIdx); }; })(item.__idx);
        } else if (MERGE_COLS.indexOf(col) !== -1) {
          // 合并列：起始行带 rowspan，可点击编辑（编辑会同步到该方案所有变更）
          td.rowSpan = item._span;
          td.className = 'merge-cell' + (col === '建档日期' ? ' col-date' : '');
          td.style.cursor = 'pointer';
          td.onclick = (function (rowIdx, c) { return function () { startEdit(td, rowIdx, c); }; })(item.__idx, col);
        } else {
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
          td.style.cursor = 'pointer';
          td.onclick = (function (rowIdx, c) { return function () { startEdit(td, rowIdx, c); }; })(item.__idx, col);
          if (col === '型号') td.title = (val === '' || val === null || val === undefined) ? '' : val;
        }
      }
      tr.appendChild(td);
    });
    tableBody.appendChild(tr);
  });
  scheduleAutoFit(tableBody);
}

function getFiltered() {
  var f = {};
  allColumns.forEach(function (c) {
    var el = document.getElementById('f_' + c);
    if (el && el.value.trim()) f[c] = el.value.trim().toLowerCase();
  });
  return rawData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    if (row['定型']) return false;  // 已定型方案归入「价格明细」，方案明细视图不再显示
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function applyFilters() {
  if (currentView === 'xm') render();
  else if (currentView === 'price') renderPrice();
  else renderOrder();
}
// 清除当前筛选栏的所有输入并重新渲染（仅作用于该筛选栏所在的视图）
function clearFilters(btn) {
  var bar = btn.closest('.filters');
  if (bar) { var ins = bar.querySelectorAll('input'); for (var i = 0; i < ins.length; i++) ins[i].value = ''; }
  if (btn.closest('#priceView')) { priceModelFilter = null; updatePriceModelFilterBar(); }
  if (btn.closest('#orderView')) { orderModelFilter = null; updateOrderModelFilterBar(); }
  applyFilters();
}

// ==================== 编辑 ====================
function startEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  input.value = rawData[rowIdx][col] || '';
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishEdit(td, rowIdx, col, input.value); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { render(); }
  };
}

function finishEdit(td, rowIdx, col, val) {
  if (rawData[rowIdx][col] !== val) {
    rawData[rowIdx][col] = val;
    // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(col) !== -1) {
      var pid = String(rawData[rowIdx]['序列']);
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
    }
    persistData();
    applyFilters();
    scheduleSync();
  }
}

// ==================== 整行编辑（编辑按钮） ====================
var editingIdx = null; // 当前处于整行编辑模式的 rawData 下标

function editRow(rowIdx) {
  editingIdx = rowIdx;
  render();
}

// 编辑模式下提交单个单元格（仅保存数据，不重渲染，避免输入框失焦引发的按钮点击竞态；由「完成」统一退出编辑）
function commitEdit(input, rowIdx, col) {
  var val = input.value;
  rawData[rowIdx][col] = val;
  // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  // 仅本地保存；同步（订单回填 + GitHub）推迟到点击「完成」按钮时统一触发
  persistData();
}

// 定型勾选（按变更行独立）；切换后会自动刷新两侧视图（价格明细由定型行生成）
function toggleFinalize(rowIdx) {
  rawData[rowIdx]['定型'] = !rawData[rowIdx]['定型'];
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 价格明细视图（由 XM 中已「定型」的行自动生成） ====================
// 列标题与 XM 视图完全一致
var priceViewColumns = ["序列", "建档日期", "客户", "项目号", "项目名称", "工程师", "变更时间", "工况", "型号", "配置", "成交价", "成交价备注", "价格申请日期", "何健价格", "何健价格备注"];
var priceEditingIdx = null;
var currentView = 'xm';
var priceTableBody = document.getElementById('priceTableBody');
var priceTable = document.getElementById('priceTable');
var priceModelFilter = null;  // 型号筛选：null 表示不过滤；非 null 为被点击的重复型号值

// 由 XM 数据筛选出已定型（定型 === true）的行，并自底向上重新编号：
// 表格最下方为序列 1，向上依次递增（与 XM 视图「最小的在下面、从小到大」排序一致）
function getPriceList() {
  var fin = [];
  rawData.forEach(function (r, i) { if (r && r['定型']) fin.push({ row: r, idx: i }); });
  var counter = 0;
  for (var i = fin.length - 1; i >= 0; i--) { counter++; fin[i].newSeq = counter; }
  return fin.map(function (o) {
    var r = Object.assign({}, o.row);
    r['序列'] = o.newSeq;     // 价格视图内独立的自增序列号
    r.__idx = o.idx;          // 指向 XM 源数据的下标，操作会同步回源
    return r;
  });
}

function getPriceFiltered() {
  var f = {};
  priceViewColumns.forEach(function (c) {
    var el = document.getElementById('pf_' + c);
    if (el && el.value.trim()) f[c] = el.value.trim().toLowerCase();
  });
  return getPriceList().filter(function (row) {
    if (priceModelFilter && (row['型号'] || '').toString().trim() !== priceModelFilter) return false;
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

// 返回价格表中「型号」出现次数 > 1 的值集合（仅用于红色标记；基于全量定型行，不受文本筛选影响，保证高亮稳定）
function getDuplicateModels() {
  var counts = {};
  getPriceList().forEach(function (r) {
    var m = (r['型号'] || '').toString().trim();
    if (m) counts[m] = (counts[m] || 0) + 1;
  });
  var dup = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dup[k] = true; });
  return dup;
}

function updatePriceModelFilterBar() {
  var bar = document.getElementById('priceModelFilterBar');
  if (!bar) return;
  if (priceModelFilter) {
    bar.style.display = '';
    var t = document.getElementById('priceModelFilterText');
    if (t) t.textContent = priceModelFilter;
  } else {
    bar.style.display = 'none';
  }
}

function clearPriceModelFilter() {
  priceModelFilter = null;
  renderPrice();
}
function updateOrderModelFilterBar() {
  var bar = document.getElementById('orderModelFilterBar');
  if (!bar) return;
  if (orderModelFilter) {
    bar.style.display = '';
    var t = document.getElementById('orderModelFilterText');
    if (t) t.textContent = orderModelFilter;
  } else {
    bar.style.display = 'none';
  }
}
function clearOrderModelFilter() {
  orderModelFilter = null;
  updateOrderModelFilterBar();
  renderOrder();
}

function renderPrice() {
  priceTableBody.innerHTML = '';
  var dupModels = getDuplicateModels();
  var orderModelSet = getOrderModelInfo().modelSet;
  updatePriceModelFilterBar();
  var list = getPriceFiltered();
  if (list.length === 0) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="' + (priceViewColumns.length + 1) + '" style="padding:14px;color:#999;">暂无定型方案，请在「XM方案明细」中将方案勾选为「定型」</td>';
    priceTableBody.appendChild(tr);
    return;
  }
  list.forEach(function (item) {
    var tr = document.createElement('tr');
    tr.dataset.idx = item.__idx; // 供局部更新按行定位（性能优化）
    var _seqNum = parseInt(item['序列'], 10);
    if (!isNaN(_seqNum) && _seqNum % 2 === 0) tr.className = 'row-even';
    // 操作列：删除 / 编辑 / 定型 三个按钮纵向排列（操作同步作用于 XM 源数据）
    var tdOp = document.createElement('td');
    tdOp.className = 'op-cell';
    var rowIdx = item.__idx;
    var isEditing = (priceEditingIdx === rowIdx);
    var del = document.createElement('button');
    del.className = 'op-btn del-btn';
    del.textContent = '删除';
    del.onclick = (function (ri) { return function () { deleteRow(ri); }; })(rowIdx);
    tdOp.appendChild(del);
    var editBtn = document.createElement('button');
    if (isEditing) {
      editBtn.className = 'op-btn done-btn';
      editBtn.textContent = '完成';
      editBtn.onclick = (function () { return function () {
        priceEditingIdx = null;
        // 仅在点击「完成」后触发同步：把价格明细的项目名称/配置回填到订单明细，并刷新各视图与 GitHub
        syncOrderFromPrice();
        persistData();
        renderPrice();
        renderOrder();
        scheduleSync();
      }; })();
    } else {
      editBtn.className = 'op-btn edit-btn';
      editBtn.textContent = '编辑';
      editBtn.onclick = (function (ri) { return function () { priceEditingIdx = rowIdx; renderPrice(); }; })(rowIdx);
    }
    tdOp.appendChild(editBtn);
    var finalized = !!rawData[rowIdx]['定型'];
    var finBtn = document.createElement('button');
    finBtn.className = 'op-btn finalize-btn' + (finalized ? ' finalized' : '');
    finBtn.textContent = finalized ? '☑定' : '☐定';
    finBtn.onclick = (function (ri) { return function () { toggleFinalize(ri); }; })(rowIdx);
    tdOp.appendChild(finBtn);
    tr.appendChild(tdOp);
    // 数据列（列标题与 XM 一致）
    priceViewColumns.forEach(function (col) {
      var td = document.createElement('td');
      td.dataset.idx = item.__idx; // 供局部更新按单元格定位（性能优化）
      td.dataset.col = col;
      if (col === '变更时间') td.className = 'col-time';
      if (col === '建档日期' || col === '价格申请日期') td.className = 'col-date-sm';
      if (col === '型号') td.className = 'col-model';
      if (priceEditingIdx === item.__idx) {
        if (col === '配置') {
          buildConfigEditor(td, item.__idx, true);
        } else {
          var input = document.createElement('input');
          input.className = 'cell-input';
          var initVal = rawData[item.__idx][col];
          if (col === '建档日期' || col === '价格申请日期') initVal = formatPriceDate(initVal);
          input.value = (initVal === undefined || initVal === null) ? '' : initVal;
          td.appendChild(input);
          input.onblur = (function (ri, c, inp) { return function () { commitPriceEdit(inp, ri, c); }; })(item.__idx, col, input);
          input.onkeydown = function (e) {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            else if (e.key === 'Escape') { priceEditingIdx = null; renderPrice(); }
          };
        }
      } else {
        var val = item[col];
        if (col === '配置') {
          td.innerHTML = configDisplay(val);
          td.style.textAlign = 'left';
          td.style.fontSize = '10px';  // 价格明细配置列字体再小2号（基准13px→12px→10px）
        } else if (col === '建档日期' || col === '价格申请日期') {
          td.textContent = formatPriceDate(val);
        } else if (col === '序列') {
          // 序列号在价格视图中为自动生成，仅展示（不可点击新增变更，避免与 XM 源混淆）
          td.style.fontWeight = '600';
          td.style.color = '#1a73e8';
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
        } else {
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
          if (col === '型号') {
            var mkey = (val === '' || val === null || val === undefined) ? '' : String(val).trim();
            td.title = mkey;
            var mcls = 'col-model';
            if (dupModels[mkey]) mcls += ' model-dup';
            if (orderModelSet[mkey]) mcls += ' model-in-order';
            td.className = mcls;
            if (dupModels[mkey]) {
              td.onclick = (function (mv) {
                return function () {
                  // 再次点击同一型号 → 取消筛选；否则切换为该型号筛选
                  priceModelFilter = (priceModelFilter === mv) ? null : mv;
                  renderPrice();
                };
              })(mkey);
            }
          }
        }
      }
      tr.appendChild(td);
    });
      priceTableBody.appendChild(tr);
  });
  scheduleAutoFit(priceTable);
}

function startPriceEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var iv = rawData[rowIdx][col];
  if (col === '建档日期') iv = formatPriceDate(iv);
  input.value = iv || '';
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishPriceEdit(td, rowIdx, col, input.value); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderPrice(); }
  };
}

function finishPriceEdit(td, rowIdx, col, val) {
  if (rawData[rowIdx][col] !== val) {
    rawData[rowIdx][col] = val;
    // 合并列编辑时，同步到同一方案（XM 序列号相同）的所有变更行
    var affected = [rowIdx];
    if (MERGE_COLS.indexOf(col) !== -1) {
      var pid = String(rawData[rowIdx]['序列']);
      rawData.forEach(function (r, i) { if (String(r['序列']) === pid) { r[col] = val; affected.push(i); } });
    }
    persistData();
    // 局部更新受影响行的对应单元格，避免整表重建（性能优化）
    affected.forEach(function (ri) {
      var tr = priceTableBody.querySelector('tr[data-idx="' + ri + '"]');
      if (!tr) return;
      var cell = tr.querySelector('td[data-col="' + col + '"]');
      if (!cell) return;
      if (col === '建档日期' || col === '价格申请日期') cell.textContent = formatPriceDate(val);
      else if (col === '配置') cell.innerHTML = configDisplay(val);
      else cell.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      fitSingleCell(cell);
    });
    scheduleSync();
  } else {
    // 值未变，仍把输入框还原为文本显示
    if (col === '建档日期' || col === '价格申请日期') td.textContent = formatPriceDate(val);
    else if (col === '配置') td.innerHTML = configDisplay(val);
    else td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
    fitSingleCell(td);
  }
}

function editPriceRow(rowIdx) { priceEditingIdx = rowIdx; renderPrice(); }

// 编辑模式下提交单个单元格（仅保存，不重渲染，避免失焦竞态；由「完成」统一退出）
function commitPriceEdit(input, rowIdx, col) {
  var val = input.value;
  rawData[rowIdx][col] = val;
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  // 仅本地保存；同步（订单回填 + GitHub）推迟到点击「完成」按钮时统一触发
  persistData();
}

// 价格视图不再单独维护数据：所有操作都作用于 XM 源数据（deleteRow/toggleFinalize 已复用）

// ==================== 订单明细视图（由上传的订单明细.xlsx 生成，独立维护数据） ====================
var orderColumns = ["订单类型", "订单状态", "内部订单号（必填）", "订单日期", "客户查找关联", "规格型号", "数量", "单位", "单价", "金额", "负责人", "价格申请日期", "项目名称", "配置"];
var orderEditingIdx = null;
var orderTableBody = document.getElementById('orderTableBody');
var orderTable = document.getElementById('orderTable');
// 性能优化：订单表点击高亮改用事件委托（整表一个监听），避免给每个单元格挂 onclick 闭包（2756 行约 3.8 万单元格）
if (orderTableBody && !orderTableBody._delegated) {
  orderTableBody.addEventListener('click', function (e) {
    var cell = e.target.closest ? e.target.closest('td') : null;
    if (cell && cell.tagName === 'TD') {
      if (cell.getAttribute('data-col') === '规格型号' && cell.classList.contains('order-model-dup')) {
        var mv = (cell.textContent || '').trim();
        orderModelFilter = (orderModelFilter === mv) ? null : mv;
        updateOrderModelFilterBar();
        renderOrder();
        return;
      }
      highlightOrderCell(cell);
    }
  });
  orderTableBody._delegated = true;
}
// 窗口尺寸变化会使缓存的列宽失效，下次渲染重新测量
window.addEventListener('resize', invalidateOrderColWidths);
// 数据字段重命名迁移：列标题调整后兼容旧订单数据（幂等，可重复执行）
(function migrateOrderColumns() {
  var renameMap = { '订单负责人': '负责人', '订单数量': '数量' };
  orderData.forEach(function (r) {
    Object.keys(renameMap).forEach(function (oldK) {
      if (oldK in r) { r[renameMap[oldK]] = r[oldK]; delete r[oldK]; }
    });
    if ('客户订单号' in r) delete r['客户订单号'];
  });
})();
// ===== 订单 ↔ 价格 联动 =====
var orderModelFilter = null; // 订单表按型号筛选：null 不过滤

function normalizeDate(v) {
  if (v === undefined || v === null) return '';
  var s = String(v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{2,4})[/\-.](\d{1,2})[/\-.](\d{1,2})$/);
  if (m) {
    var y = parseInt(m[1], 10); if (y < 100) y += 2000;
    var mo = String(parseInt(m[2], 10)).padStart(2, '0');
    var d = String(parseInt(m[3], 10)).padStart(2, '0');
    return y + '-' + mo + '-' + d;
  }
  return s;
}

// 统计订单表规格型号出现次数 → {counts, dupSet(>1), modelSet(全部)}
var _orderModelCache = null; // 缓存规格型号统计结果，避免每次渲染重复遍历 2756 行
function getOrderModelInfo() {
  if (_orderModelCache) return _orderModelCache;
  var counts = {}, modelSet = {};
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m) return;
    counts[m] = (counts[m] || 0) + 1;
    modelSet[m] = true;
  });
  var dupSet = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dupSet[k] = true; });
  _orderModelCache = { counts: counts, dupSet: dupSet, modelSet: modelSet };
  return _orderModelCache;
}

// 把价格明细的项目名称/配置 同步到订单明细（按规格型号匹配；订单中该型号唯一直接填，重复则需价格申请日期一致）
function syncOrderFromPrice() {
  var priceByModel = {};
  getPriceList().forEach(function (p) {
    var m = (p['型号'] || '').toString().trim();
    if (!m) return;
    (priceByModel[m] = priceByModel[m] || []).push(p);
  });
  if (!Object.keys(priceByModel).length) return;
  var info = getOrderModelInfo();
  var changed = false;
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m || !priceByModel[m]) return;
    var candidates = priceByModel[m];
    var orderCount = info.counts[m];
    var pick = null;
    if (orderCount === 1) {
      var od = normalizeDate(r['价格申请日期']);
      pick = (od && candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od; })[0]) || candidates[0];
    } else {
      var od2 = normalizeDate(r['价格申请日期']);
      if (!od2) return;
      pick = candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od2; })[0];
      if (!pick) return;
    }
    if (pick['项目名称'] && pick['项目名称'] !== r['项目名称']) { r['项目名称'] = pick['项目名称']; changed = true; }
    if (pick['配置'] && pick['配置'] !== r['配置']) { r['配置'] = pick['配置']; changed = true; }
  });
  if (changed) persistData();
}
// 订单明细：列宽比例调整。每次渲染都基于“当前自然宽 × 比例”计算，不依赖跨渲染状态，确定可靠。
var orderFilterCols = [
  { id: 'of_customer', col: '客户查找关联' },
  { id: 'of_model', col: '规格型号' },
  { id: 'of_owner', col: '负责人' }
];

// 连续编号：序列 = 行序（从 1 开始，顶部为 1）
function renumberOrders() {
  for (var i = 0; i < orderData.length; i++) orderData[i]['序列'] = i + 1;
}

function getOrderFiltered() {
  var f = {};
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el && el.value.trim()) f[o.col] = el.value.trim().toLowerCase();
  });
  return orderData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    if (orderModelFilter) {
      var m = (row['规格型号'] || '').toString().trim();
      if (m !== orderModelFilter) return false;
    }
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function orderCellClass(col) {
  if (col === '内部订单号（必填）') return 'col-fixed';
  if (col === '订单日期' || col === '价格申请日期') return 'col-date';
  if (col === '订单类型' || col === '订单状态' || col === '数量' || col === '单价' || col === '负责人') return 'col-half w40';
  if (col === '单位') return 'col-half w30';
  if (col === '金额') return 'col-half w50';
  if (col === '客户查找关联' || col === '规格型号') return 'col-cust';
  return '';
}

function renderOrder() {
  var list = getOrderFiltered();
  var orderModelInfo = getOrderModelInfo();
  // 预计算每列元数据（只算一次，避免每次渲染 4 万次 orderCellClass 调用与分支判断）
  if (!renderOrder._meta) {
    var meta = [];
    for (var k = 0; k < orderColumns.length; k++) {
      var col = orderColumns[k];
      meta.push({
        col: col,
        cls: orderCellClass(col),
        isDate: (col === '订单日期' || col === '价格申请日期'),
        isModel: (col === '规格型号')
      });
    }
    renderOrder._meta = meta;
  }
  var META = renderOrder._meta;
  // 按订单日期倒序排列（最新日期在最上方）
  list.sort(function (a, b) {
    return orderDateValue(b['订单日期']) - orderDateValue(a['订单日期']);
  });
  if (list.length === 0) {
    orderTableBody.innerHTML = '<tr><td colspan="' + (orderColumns.length + 2) + '" style="padding:14px;color:#999;">暂无数据</td></tr>';
    return;
  }
  // 性能优化：用单次 innerHTML 批量构建 tbody（2756 行 × 15 列约 4 万单元格），避免逐个 createElement/appendChild
  var rows = new Array(list.length);
  for (var i = 0; i < list.length; i++) {
    var item = list[i];
    var mval = (item['规格型号'] || '').toString().trim();
    var cells = ['<td class="seq-cell col-half w30" data-col="序列">' + (i + 1) + '</td>'];
    for (var k = 0; k < META.length; k++) {
      var m = META[k];
      var val = item[m.col];
      if (m.isDate) val = formatOrderDate(val);
      var disp = (val === '' || val === null || val === undefined) ? '' : String(val);
      var cls = m.cls;
      if (m.isModel && orderModelInfo.dupSet[mval]) cls = (cls ? cls + ' ' : '') + 'order-model-dup';
      cells.push('<td' + (cls ? ' class="' + cls + '"' : '') + ' data-col="' + m.col + '">' + escapeHtml(disp) + '</td>');
    }
    rows[i] = '<tr' + (item['定型'] ? ' class="finalized-row"' : '') + '>' + cells.join('') + '</tr>';
  }
  orderTableBody.innerHTML = rows.join('');
  applyOrderColumnRatios();
  scheduleAutoFit(orderTable);
}

// 列宽比例调整：首次测量并缓存结果，之后直接套用（仅写不读，去除每次渲染对上万单元格的 offsetWidth 读取）
var _orderColWidths = null; // {col: targetPx}
var _orderColMeasuring = false; // 防止同帧重复安排测量
function invalidateOrderColWidths() { _orderColWidths = null; _orderModelCache = null; }

function applyOrderColumnRatios() {
  var ratios = {
    '订单状态': 2 / 3,
    '订单日期': 2 / 3,
    '客户查找关联': 3 / 4,
    '规格型号': 3 / 4,
    '负责人': 2 / 3,
    '价格申请日期': 2 / 3
  };
  // 已缓存：直接套用，不重新测量（无 layout 读取，仅一次重排）
  if (_orderColWidths) {
    for (var c in _orderColWidths) {
      if (!ratios.hasOwnProperty(c)) continue;
      var tw = _orderColWidths[c];
      var th = document.querySelector('#orderTable th[data-col="' + c + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = tw + 'px';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + c + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = tw + 'px';
    }
    return;
  }
  var cols = Object.keys(ratios);
  // 首次测量推迟到下一帧：先让表格以自然宽瞬时呈现（点击进入不卡），后台再测宽并缓存套用
  if (_orderColMeasuring) return; // 本帧已安排测量，避免重复
  _orderColMeasuring = true;
  requestAnimationFrame(function () {
    _orderColMeasuring = false;
    // 写阶段①：清除所有目标列的固定宽，量自然宽
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = '';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = '';
    });
    // 读阶段：量取每列最大自然宽（全部读，无穿插写，仅触发一次重排）
    var res = {};
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      if (!th || !cells.length) return;
      var natural = th.offsetWidth;
      for (var i = 0; i < cells.length; i++) { var w = cells[i].offsetWidth; if (w > natural) natural = w; }
      res[col] = { th: th, cells: cells, target: Math.max(18, Math.round(natural * ratios[col])) };
    });
    // 写阶段②：统一回写目标列宽，并缓存结果供后续渲染复用
    var store = {};
    cols.forEach(function (col) {
      var r = res[col];
      if (!r) return;
      r.th.style.width = r.th.style.minWidth = r.th.style.maxWidth = r.target + 'px';
      for (var i = 0; i < r.cells.length; i++) r.cells[i].style.width = r.cells[i].style.minWidth = r.cells[i].style.maxWidth = r.target + 'px';
      store[col] = r.target;
    });
    _orderColWidths = store;
  });
}

function highlightOrderCell(td) {
  // 清除上一次高亮（整表所有 .hl）
  var prev = orderTable.querySelectorAll('td.hl, th.hl');
  Array.prototype.forEach.call(prev, function (c) { c.classList.remove('hl'); });
  var tr = td.parentElement;
  var idx = td.cellIndex;
  // 高亮整行
  Array.prototype.forEach.call(tr.querySelectorAll('td'), function (c) { c.classList.add('hl'); });
  // 高亮整列（含表头，按列索引定位）
  Array.prototype.forEach.call(orderTable.querySelectorAll('tr'), function (row) {
    var cell = row.cells[idx];
    if (cell) cell.classList.add('hl');
  });
}
function startOrderEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var rawVal = (orderData[rowIdx][col] === undefined || orderData[rowIdx][col] === null) ? '' : orderData[rowIdx][col];
  input.value = (col === '订单日期') ? formatOrderDate(rawVal) : rawVal;
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishOrderEdit(input.value, rowIdx, col); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderOrder(); }
  };
}
function finishOrderEdit(val, rowIdx, col) {
  if (orderData[rowIdx][col] !== val) {
    orderData[rowIdx][col] = val;
    persistData();
    invalidateOrderColWidths();
    renderOrder();
    scheduleSync();
  }
}
function commitOrderEdit(input, rowIdx, col) {
  orderData[rowIdx][col] = input.value;
  persistData();
  scheduleSync();
}
function editOrderRow(rowIdx) { orderEditingIdx = rowIdx; renderOrder(); }
function addOrderRow() {
  // 清空当前筛选条件，确保新增的空白行一定可见（否则空行会被筛选隐藏，造成「点了没反应」）
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el) el.value = '';
  });
  var row = { 序列: 0, 定型: false };
  orderColumns.forEach(function (c) { row[c] = ''; });
  orderData.unshift(row);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}
function toggleOrderFinalize(rowIdx) {
  orderData[rowIdx]['定型'] = !orderData[rowIdx]['定型'];
  persistData();
  renderOrder();
  scheduleSync();
}
function deleteOrderRow(idx) {
  if (!confirm('确定删除这条订单记录吗？')) return;
  orderData.splice(idx, 1);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}

// 视图切换：三个界面共用同一标题栏（方案明细 / 价格明细 / 订单明细）
function showView(name) {
  currentView = name;
  document.getElementById('xmView').style.display = (name === 'xm') ? '' : 'none';
  document.getElementById('priceView').style.display = (name === 'price') ? '' : 'none';
  document.getElementById('orderView').style.display = (name === 'order') ? '' : 'none';
  document.getElementById('navXm').classList.toggle('active', name === 'xm');
  document.getElementById('navPrice').classList.toggle('active', name === 'price');
  document.getElementById('navOrder').classList.toggle('active', name === 'order');
  if (name === 'xm') render();
  else if (name === 'price') renderPrice();
  else renderOrder();
}

// ==================== 增删 ====================
// 序列 = 方案编号（同一方案的多条变更共享同一编号；新增取最大号+1，删除方案后由 renumberSchemes 重新连续编号）
function addRow() {
  var now = new Date().toLocaleString('zh-CN');
  var maxSeq = 0;
  rawData.forEach(function (r) { var n = parseFloat(r['序列']); if (!isNaN(n) && n > maxSeq) maxSeq = n; });
  rawData.unshift({
    序列: maxSeq + 1,
    建档日期: todayStr(),
    客户: '', 项目号: '', 项目名称: '', 工程师: '',
    变更时间: now, 工况: '', 型号: '', 配置: '', 其他: '', 价格申请日期: '',
    定型: false
  });
  persistData();
  applyFilters();
  scheduleSync();
}

function deleteRow(idx) {
  if (!confirm('确定删除这条记录吗？')) return;
  rawData.splice(idx, 1);
  renumberSchemes(); // 删除方案后，剩余方案重新连续编号
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 新增变更（点击序列列弹出） ====================
var chPlanSeq = null; // 当前操作的方案编号

function openChangeDialog(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  chPlanSeq = row['序列'];
  document.getElementById('chPlanId').textContent = row['序列'];
  document.getElementById('chSeq').textContent = row['序列'] || '';
  document.getElementById('chDate').textContent = row['建档日期'] || '';
  document.getElementById('chCustomer').textContent = row['客户'] || '';
  document.getElementById('chProjNo').textContent = row['项目号'] || '';
  document.getElementById('chProjName').textContent = row['项目名称'] || '';
  document.getElementById('chEngineer').textContent = row['工程师'] || '';
  document.getElementById('chChangeTime').value = new Date().toLocaleString('zh-CN');
  document.getElementById('chCond').value = '';
  document.getElementById('chModel').value = '';
  document.getElementById('chConfig').value = '';
  document.getElementById('chOther').value = '';
