","项目名称":"","产品品名":"","配置":"","规格型号":"X1C310-17-L5616-B-ZJ","单位":"台","单价":91142,"金额":182284,"负责人":"吕涛","数量":2,"序列":2751},{"订单类型":"合同订单","订单状态":"已结束","内部订单号（必填）":"211854","订单日期":"2021/08/31","客户查找关联":"深圳市中基自动化有限公司","项目名称":"","产品品名":"","配置":"","规格型号":"D-MA263x113-190A-05","单位":"套","单价":14500,"金额":14500,"负责人":"吕涛","数量":1,"序列":2752},{"订单类型":"合同订单","订单状态":"已结束","内部订单号（必填）":"211706","订单日期":"2021/08/12","客户查找关联":"深圳市信为科技发展有限公司","项目名称":"","产品品名":"","配置":"","规格型号":"E065-M1-L072-A-5.0-XW","单位":"台","单价":6388,"金额":12776,"负责人":"吕涛","数量":2,"序列":2753},{"订单类型":"合同订单","订单状态":"已结束","内部订单号（必填）":"211629","订单日期":"2021/07/27","客户查找关联":"深圳市中基自动化有限公司","项目名称":"","产品品名":"","配置":"","规格型号":"D-MA263x113-190A-05","单位":"套","单价":14500,"金额":14500,"负责人":"吕涛","数量":1,"序列":2754},{"订单类型":"合同订单","订单状态":"已结束","内部订单号（必填）":"211603","订单日期":"2021/07/22","客户查找关联":"深圳市易胜德机械设备有限公司","项目名称":"","产品品名":"","配置":"","规格型号":"E090-M1-L696-B-5.0-YSD","单位":"台","单价":6362,"金额":6362,"负责人":"吕涛","数量":1,"序列":2755},{"订单类型":"合同订单","订单状态":"已结束","内部订单号（必填）":"211463","订单日期":"2021/06/23","客户查找关联":"深圳市易胜德机械设备有限公司","项目名称":"","产品品名":"","配置":"","规格型号":"E090-M1-L840-B-5.0-YSD","单位":"台","单价":6722,"金额":6722,"负责人":"吕涛","数量":1,"序列":2756}];</script>

<script>
// ==================== 列定义 ====================
var allColumns = ["序列", "建档日期", "客户", "项目号", "项目名称", "工程师", "变更时间", "工况", "型号", "配置"];
// 同一方案的固定列（同一序列号的多条变更合并显示）；工程师不合并——每条变更独立显示/编辑
var MERGE_COLS = ["序列", "建档日期", "客户", "项目号", "项目名称"];

// ==================== 配置列模板 ====================
// 固定文字 + （）可填入；（）内文本蓝底
var CONFIG_FIELDS = ["电机", "动子个数", "驱动器型号", "光电开关", "导轨品牌", "读头", "动力线", "编码器线", "图纸来源", "刹车电阻", "其他备注"];

function escapeHtml(s) {
  s = String(s == null ? '' : s);
  if (s.indexOf('&') === -1 && s.indexOf('<') === -1 && s.indexOf('>') === -1) return s;
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// 将存储的「配置」字符串解析为 { 字段: 值 }
function parseConfig(str) {
  var obj = {};
  CONFIG_FIELDS.forEach(function (f) {
    var re = new RegExp(f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '（([^）]*)）');
    var m = (str || '').match(re);
    obj[f] = m ? m[1] : '';
  });
  return obj;
}

// 将 { 字段: 值 } 序列化回模板字符串
function serializeConfig(obj) {
  return CONFIG_FIELDS.map(function (f) { return f + '（' + (obj[f] || '') + '）'; }).join('，');
}

// 非编辑态展示：固定文字 + 蓝底（）内容（旧版自由文本原样显示，避免丢失）
function configDisplay(val) {
  if (val && !CONFIG_FIELDS.some(function (f) { return String(val).indexOf(f) !== -1; })) {
    return escapeHtml(val);
  }
  var obj = parseConfig(val || '');
  return CONFIG_FIELDS.map(function (f) {
    return f + '（<span class="cfg-fill">' + escapeHtml(obj[f] || '') + '</span>）';
  }).join('，');
}

// 方案明细「配置」列显示规则（新）：仅当（）或()内有内容时，其内部文字加浅蓝底；其余原样显示
// 同时支持全角（）与半角()，内容含特殊字符已先 escapeHtml，避免注入
function configDisplayXm(val) {
  var s = (val === undefined || val === null) ? '' : String(val);
  if (!s) return '';
  s = escapeHtml(s);
  s = s.replace(/（([^（）]+)）|\(([^()]+)\)/g, function (m, full, half) {
    if (full !== undefined) {
      return '（<span class="cfg-fill">' + full + '</span>）';
    }
    return '(<span class="cfg-fill">' + half + '</span>)';
  });
  return s;
}

// 编辑态：每个（）渲染为蓝底输入框，失焦即保存对应字段
function buildConfigEditor(td, rowIdx, isPrice) {
  td.className = '';
  td.style.padding = '4px 6px';
  td.style.textAlign = 'left';
  td.style.verticalAlign = 'top';
  var current = parseConfig(rawData[rowIdx]['配置']);
  CONFIG_FIELDS.forEach(function (f) {
    var wrap = document.createElement('div');
    wrap.style.margin = '2px 0';
    var label = document.createElement('span');
    label.textContent = f;
    var open = document.createTextNode('（');
    var input = document.createElement('input');
    input.value = current[f] || '';
    input.className = 'cfg-input';
    input.setAttribute('placeholder', '填写');
    var close = document.createTextNode('）');
    wrap.appendChild(label); wrap.appendChild(open); wrap.appendChild(input); wrap.appendChild(close);
    input.onblur = (function (ri, field, inp) {
      return function () {
        var o = parseConfig(rawData[ri]['配置']);
        o[field] = inp.value;
        rawData[ri]['配置'] = serializeConfig(o);
        persistData();
        scheduleSync();
      };
    })(rowIdx, f, input);
    input.onkeydown = function (e) {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      else if (e.key === 'Escape') { if (isPrice) { priceEditingIdx = null; renderPrice(); } else { editingIdx = null; render(); } }
    };
    td.appendChild(wrap);
  });
}

// 重新连续编号：同一方案（序列号相同）共享一个编号；自底向上编号，使最小的序列号在表格最下方，依次向上递增
function renumberSchemes() {
  var counter = 0;
  var currentSeq = null;
  for (var i = rawData.length - 1; i >= 0; i--) {
    var r = rawData[i];
    if (String(r['序列']) !== String(currentSeq)) {
      counter++;
      currentSeq = r['序列'];
    }
    r['序列'] = counter;
  }
}

// ==================== 渲染 ====================
var tableBody = document.getElementById('tableBody');

// 自动缩放「建档日期 / 变更时间」列的文字大小，使其在不换行的前提下适配固定列宽
// 仅适配选定表（或可见表）中需要字号自适应的列；按列缓存样式，消除逐单元格 getComputedStyle 重排风暴
var _AUTOFIT_SEL = 'th.col-time,td.col-time,th.col-date,td.col-date,th.col-date-sm,td.col-date-sm,th.col-fixed,td.col-fixed,th.col-half,td.col-half,th.col-cust,td.col-cust,th.col-headfit,th.col-combo-date,td.col-combo-date';

function autoFitColumnText(scope) {
  var tables;
  if (scope) {
    tables = [scope];
  } else {
    // 未指定时仅处理可见表，跳过被隐藏视图（避免对另一张表的数万单元格做无谓计算）
    tables = [document.getElementById('priceTable'), document.getElementById('orderTable'), document.getElementById('tableBody')];
    tables = tables.filter(function (t) { return t && t.offsetParent !== null; });
  }
  for (var t = 0; t < tables.length; t++) autoFitTable(tables[t]);
}

function autoFitTable(table) {
  var cells = table.querySelectorAll(_AUTOFIT_SEL);
  if (!cells || !cells.length) return;
  // 写阶段①：统一重置字号（仅触发一次布局）
  for (var i = 0; i < cells.length; i++) {
    var c = cells[i];
    if (c.querySelector('input')) continue; // 编辑态（输入框）跳过
    c.style.whiteSpace = 'nowrap';
    c.style.fontSize = '';
  }
  // 按列缓存 padding / 可用宽 / 基准字号：每列仅 1 次 getComputedStyle（原来每单元格 1 次）
  var colInfo = {};
  function colInfoOf(cell) {
    var idx = cell.cellIndex;
    if (colInfo[idx]) return colInfo[idx];
    var cs = getComputedStyle(cell);
    var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
    var avail = cell.clientWidth - pad;
    var base = parseFloat(cs.fontSize) || 13;
    var info = { avail: avail, base: base };
    colInfo[idx] = info;
    return info;
  }
  // 读阶段：仅逐单元格读 scrollWidth（无穿插写，整表仅一次重排）
  var targets = [];
  for (var j = 0; j < cells.length; j++) {
    var cell = cells[j];
    if (cell.querySelector('input')) continue;
    var info = colInfoOf(cell);
    if (info.avail <= 0) continue; // 隐藏列跳过
    var textW = cell.scrollWidth;
    if (textW > info.avail + 0.5) {
      var size = Math.max(6, info.base * (info.avail / textW));
      targets.push([cell, size.toFixed(1) + 'px']);
    }
  }
  // 写阶段②：回写目标字号（再触发一次布局）
  for (var k = 0; k < targets.length; k++) targets[k][0].style.fontSize = targets[k][1];
}

// 将字体自适应推迟到下一帧绘制之后：让表格内容先呈现，再微调字号，点击进入视图不再卡顿
function scheduleAutoFit(scope) {
  requestAnimationFrame(function () {
    autoFitColumnText(scope);
  });
}

// 方案明细：将「配置」列列宽设为当前渲染宽度的 1/2（存为 --cfgcolw）；「工况」列宽由 CSS 设为 calc(--cfgcolw/2)，即工况=配置/2。
// 仅首帧测量一次（--cfgcolw 未设置时列保持自适应，即可测到「当前宽度」），之后固定，避免每次渲染被不断减半。
var xmCfgHalfW = null;
function fitXmConfigColWidth() {
  var tbl = document.getElementById('dataTable');
  if (!tbl) return;
  if (xmCfgHalfW === null) {
    var cfgTh = tbl.querySelector('thead th.col-config');
    if (!cfgTh) return;
    var natural = cfgTh.offsetWidth;
    if (!natural) return; // 视图不可见（offsetWidth=0）时跳过，待可见时再测
    xmCfgHalfW = Math.max(60, Math.round(natural / 2));
  }
  tbl.style.setProperty('--cfgcolw', xmCfgHalfW + 'px');
}

// 价格明细：「何健价格备注」列显示标题重命名为「价格备注」后，
// 锁定列宽为「重命名前」的自然宽度，使更长的标题通过 autoFit 缩字适配（满足「列宽不变」）。
// 仅价格视图可见时测量一次；之后每次 renderPrice 重新把锁定宽度应用到表头与该列所有单元格。
var priceRenameColW = null; // { 新标题: { w: 像素宽, idx: 列索引 } }
function measurePriceRenameColWidths() {
  var tbl = document.getElementById('priceTable');
  if (!tbl || tbl.offsetParent === null) return; // 仅价格视图可见时测量
  var revert = { '价格备注': '何健价格备注' };
  var oldNew = { '何健价格备注': '价格备注' };
  var ths = tbl.querySelectorAll('thead th');
  var targets = [];
  ths.forEach(function (th) {
    var t = th.textContent.trim();
    if (revert[t]) targets.push({ th: th, old: revert[t] });
  });
  if (!targets.length) return;
  targets.forEach(function (m) { m.th.textContent = m.old; }); // 临时改回旧标题
  var map = {};
  targets.forEach(function (m) {
    var idx = m.th.cellIndex;
    var w = m.th.offsetWidth; // 同步布局，读到旧标题下的自然列宽
    map[m.old] = { w: w, idx: idx };
  });
  targets.forEach(function (m) { m.th.textContent = oldNew[m.old]; }); // 还原新标题
  priceRenameColW = {};
  Object.keys(map).forEach(function (old) { priceRenameColW[oldNew[old]] = map[old]; });
}
function applyPriceRenameColWidths() {
  if (!priceRenameColW) measurePriceRenameColWidths();
  if (!priceRenameColW) return;
  var tbl = document.getElementById('priceTable');
  if (!tbl) return;
  Object.keys(priceRenameColW).forEach(function (title) {
    var info = priceRenameColW[title];
    var th = tbl.querySelector('thead th:nth-child(' + (info.idx + 1) + ')');
    if (th) { th.style.width = info.w + 'px'; th.style.minWidth = info.w + 'px'; th.style.maxWidth = info.w + 'px'; }
    var rows = tbl.querySelectorAll('tbody tr');
    rows.forEach(function (r) {
      var c = r.cells[info.idx];
      if (c) { c.style.width = info.w + 'px'; c.style.minWidth = info.w + 'px'; c.style.maxWidth = info.w + 'px'; }
    });
  });
}

// 单单元格自适应（供局部更新后调用，避免整表重排）
function fitSingleCell(cell) {
  if (!cell || cell.querySelector('input')) return;
  cell.style.whiteSpace = 'nowrap';
  cell.style.fontSize = '';
  var cs = getComputedStyle(cell);
  var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
  var avail = cell.clientWidth - pad;
  if (avail <= 0) return;
  var textW = cell.scrollWidth;
  if (textW > avail + 0.5) {
    var base = parseFloat(cs.fontSize) || 13;
    var size = Math.max(6, base * (avail / textW));
    cell.style.fontSize = size.toFixed(1) + 'px';
  }
}

// 订单日期统一显示为 YY/MM/DD（如 26/01/01）
function formatOrderDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 价格明细表建档日期统一显示为 YY/MM/DD（如 26/01/01）
function formatPriceDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})[\/-](\d{2})[\/-](\d{2})$/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 将订单日期统一解析为可比较的时间戳（兼容 26/01/01 与 2026-01-01）
function orderDateValue(v) {
  if (v === '' || v === null || v === undefined) return 0;
  var s = String(v).trim();
  var m = s.match(/^(\d{2})\/(\d{2})\/(\d{2})$/);
  if (m) s = '20' + m[1] + '-' + m[2] + '-' + m[3];
  var t = Date.parse(s);
  return isNaN(t) ? 0 : t;
}

function render() {
  tableBody.innerHTML = '';
  var list = getFiltered();
  if (list.length === 0) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="' + (allColumns.length + 1) + '" style="padding:14px;color:#999;">暂无数据，点击「＋ 新增行」添加</td>';
    tableBody.appendChild(tr);
    return;
  }
  // 计算每个方案块（序列连续相同）的起始行与跨度，用于合并单元格
  list.forEach(function (item, idx) {
    item._isStart = (idx === 0) || (String(item['序列']) !== String(list[idx - 1]['序列']));
    if (item._isStart) {
      var span = 1;
      while (idx + span < list.length && String(list[idx + span]['序列']) === String(item['序列'])) span++;
      item._span = span;
    }
  });
  list.forEach(function (item, idx) {
    var tr = document.createElement('tr');
    // 偶数序列号的方案行使用浅黄背景，便于区分
    var _seqNum = parseInt(item['序列'], 10);
    if (!isNaN(_seqNum) && _seqNum % 2 === 0) tr.className = 'row-even';
    if (rawData[item.__idx]['定型']) tr.className += ' finalized-row';
    // 操作列：删除 / 编辑 / 定型 三个按钮纵向排列
    var tdOp = document.createElement('td');
    tdOp.className = 'op-cell';
    var rowIdx = item.__idx;
    var isEditing = (editingIdx === rowIdx);
    // 删除
    var del = document.createElement('button');
    del.className = 'op-btn del-btn';
    del.textContent = '删除';
    del.onclick = (function (ri) { return function () { deleteRow(ri); }; })(rowIdx);
    tdOp.appendChild(del);
    // 编辑 / 完成（编辑模式下切换为「完成」）
    var editBtn = document.createElement('button');
    editBtn.className = 'op-btn edit-btn';
    editBtn.textContent = '编辑';
    editBtn.onclick = (function (ri) { return function () { openEditModal(ri); }; })(rowIdx);
    tdOp.appendChild(editBtn);
    // 定型（勾选按钮，按变更行独立）
    var finalized = !!rawData[rowIdx]['定型'];
    var finBtn = document.createElement('button');
    finBtn.className = 'op-btn finalize-btn' + (finalized ? ' finalized' : '');
    finBtn.textContent = finalized ? '☑定' : '☐定';
    finBtn.onclick = (function (ri) { return function () { toggleFinalize(ri); }; })(rowIdx);
    tdOp.appendChild(finBtn);
    tr.appendChild(tdOp);
    // 数据列
    allColumns.forEach(function (col) {
      // 合并列：非方案起始行不渲染该单元格（由起始行的 rowspan 覆盖）
      if (MERGE_COLS.indexOf(col) !== -1 && !item._isStart) return;
      var td = document.createElement('td');
      if (col === '变更时间') td.className = 'col-time';
      if (col === '建档日期') td.className = 'col-date';
      if (col === '型号') td.className = 'col-model';
      if (editingIdx === item.__idx) {
        if (col === '配置') {
          // 配置列：模板编辑器（固定文字 + 蓝底输入框）
          buildConfigEditor(td, item.__idx, false);
          td.className = 'col-config';
        } else {
          // 整行编辑模式：渲染输入框
          var input = document.createElement('input');
          input.className = 'cell-input';
          input.value = (rawData[item.__idx][col] === undefined || rawData[item.__idx][col] === null) ? '' : rawData[item.__idx][col];
          td.appendChild(input);
          input.onblur = (function (ri, c, inp) { return function () { commitEdit(inp, ri, c); }; })(item.__idx, col, input);
          input.onkeydown = function (e) {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            else if (e.key === 'Escape') { editingIdx = null; render(); }
          };
        }
      } else {
        var val = item[col];
        if (col === '配置') {
          // 配置列（新规则）：（）内有内容才加浅蓝底；仅「编辑」按钮可编辑
          td.innerHTML = configDisplayXm(val);
          td.style.textAlign = 'left';
          td.className = 'col-config';
        } else if (col === '序列') {
          // 序列列：同一方案合并显示，点击弹出「新增变更」对话框
          td.className = 'seq-cell';
          td.rowSpan = item._span;
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
          td.style.cursor = 'pointer';
          td.onclick = (function (rowIdx) { return function () { openChangeDialog(rowIdx); }; })(item.__idx);
        } else if (MERGE_COLS.indexOf(col) !== -1) {
          // 合并列：起始行带 rowspan，仅展示（仅「编辑」按钮可编辑）
          td.rowSpan = item._span;
          td.className = 'merge-cell' + (col === '建档日期' ? ' col-date' : '');
          td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
        } else {
          // 其它列：仅展示，编辑须点「编辑」按钮
          if (col === '变更时间') {
            // 变更时间显示格式与建档日期保持一致（YYYY/MM/DD）；同为 60px 列，自动缩放后字号也与建档日期列一致
            td.textContent = dateOnlyStr(val);
          } else {
            td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
            if (col === '型号') td.title = (val === '' || val === null || val === undefined) ? '' : val;
            else if (col === '工况') td.className = 'col-cond';
          }
        }
      }
      tr.appendChild(td);
    });
    tableBody.appendChild(tr);
  });
  fitXmConfigColWidth();
  scheduleAutoFit(tableBody);
  layoutFilterBar('dataTable');
  measureXmRefColWidths(); // 记录方案明细表「建档日期/项目名称/配置/工况」列宽，供价格明细表对齐
}

// 记录方案明细表作为对齐基准的列宽（在方案明细视图可见时测量）
function measureXmRefColWidths() {
  var tbl = document.getElementById('dataTable');
  if (!tbl || tbl.offsetParent === null) return; // 视图不可见时跳过，待可见时再测
  var ths = tbl.querySelectorAll('thead th');
  for (var i = 0; i < ths.length; i++) {
    var t = (ths[i].textContent || '').trim();
    if (t === '建档日期') _xmDateColW = ths[i].offsetWidth;
    else if (t === '项目名称') _xmProjColW = ths[i].offsetWidth;
  }
  // 配置列（th.col-config）/ 工况列（th.col-cond）按 th 实际渲染宽记录（含 fitXmConfigColWidth 已应用的 --cfgcolw）
  var cfgTh = tbl.querySelector('thead th.col-config');
  var condTh = tbl.querySelector('thead th.col-cond');
  if (cfgTh) _xmConfigColW = cfgTh.offsetWidth;
  if (condTh) _xmCondColW = condTh.offsetWidth;
}

function getFiltered() {
  var f = {};
  allColumns.forEach(function (c) {
    var el = document.getElementById('f_' + c);
    if (el && el.value.trim()) f[c] = el.value.trim().toLowerCase();
  });
  return rawData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    // 已定型方案仍保留在「方案明细」视图（带浅绿「定型」标识），同时也会出现在「价格明细」视图
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function applyFilters() {
  if (currentView === 'xm') render();
  else if (currentView === 'price') renderPrice();
  else renderOrder();
}
// 清除当前筛选栏的所有输入并重新渲染（仅作用于该筛选栏所在的视图）
function clearFilters(btn) {
  var bar = btn.closest('.filters');
  if (bar) { var ins = bar.querySelectorAll('input'); for (var i = 0; i < ins.length; i++) ins[i].value = ''; }
  if (btn.closest('#priceView')) { priceModelFilter = null; updatePriceModelFilterBar(); }
  if (btn.closest('#orderView')) { orderModelFilter = null; updateOrderModelFilterBar(); }
  applyFilters();
}

// ==================== 编辑 ====================
function startEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  input.value = rawData[rowIdx][col] || '';
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishEdit(td, rowIdx, col, input.value); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { render(); }
  };
}

function finishEdit(td, rowIdx, col, val) {
  if (rawData[rowIdx][col] !== val) {
    rawData[rowIdx][col] = val;
    // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(col) !== -1) {
      var pid = String(rawData[rowIdx]['序列']);
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
    }
    persistData();
    applyFilters();
    scheduleSync();
  }
}

// ==================== 整行编辑（编辑按钮） ====================
var editingIdx = null; // 当前处于整行编辑模式的 rawData 下标

function editRow(rowIdx) {
  editingIdx = rowIdx;
  render();
}

// 编辑模式下提交单个单元格（仅保存数据，不重渲染，避免输入框失焦引发的按钮点击竞态；由「完成」统一退出编辑）
function commitEdit(input, rowIdx, col) {
  var val = input.value;
  rawData[rowIdx][col] = val;
  // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  // 仅本地保存；同步（订单回填 + GitHub）推迟到点击「完成」按钮时统一触发
  persistData();
}

// 定型勾选（按变更行独立）；切换后会自动刷新两侧视图（价格明细由定型行生成）
function toggleFinalize(rowIdx) {
  rawData[rowIdx]['定型'] = !rawData[rowIdx]['定型'];
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 价格明细视图（由 XM 中已「定型」的行自动生成） ====================
// 显示列定义：字符串=普通单列（字段名）；对象=合并列 { combine:[字段...], label, cls, filterId? }
// 新顺序：序列 → 客户 → [建档日期+变更时间+价格申请日期] → [项目号+项目名称] → 工程师 → 工况 → 型号 → 配置 → [成交价+成交价备注] → [何健价格+价格备注]
var priceDisplayCols = [
  '序列',
  '客户',
  { combine: ['建档日期', '变更时间', '价格申请日期'], label: '建档时间/变更时间/价格日期', cls: 'col-combo col-combo-date', filterId: null },
  { combine: ['项目号', '项目名称'], label: '项目号/项目名称', cls: 'col-combo', filterId: 'pf_项目' },
  '工程师',
  '工况',
  '型号',
  '配置',
  { combine: ['成交价', '成交价备注'], label: '成交价/成交价备注', cls: 'col-combo', filterId: null },
  { combine: ['何健价格', '何健价格备注'], label: '何健价格/价格备注', cls: 'col-combo', filterId: null }
];
// 取某显示列对应的字段列表
function priceColFields(c) { return typeof c === 'string' ? [c] : c.combine; }
// 取某显示列的表头标题
function priceColLabel(c) { return typeof c === 'string' ? c : c.label; }
// 价格明细「编辑」按钮仅允许编辑的列；其余列一律只读
var priceEditableCols = ["何健价格", "何健价格备注", "价格申请日期"];
var priceEditingIdx = null;
var _cjDirty = false; // 价格明细「成交价」本次渲染是否被自动匹配刷新（用于决定是否持久化）
var currentView = 'xm';
var _xmDateColW = 0;   // 方案明细表「建档日期」列宽（价格明细日期合并列的对齐基准）
var _xmProjColW = 0;   // 方案明细表「项目名称」列宽（价格明细项目/成交价合并列的对齐基准）
var _xmConfigColW = 0; // 方案明细表「配置」列宽（价格明细配置列的对齐基准）
var _xmCondColW = 0;   // 方案明细表「工况」列宽（= 配置列宽/2；价格明细工况列的对齐基准）
var priceTableBody = document.getElementById('priceTableBody');
var priceTable = document.getElementById('priceTable');
var priceModelFilter = null;  // 型号筛选：null 表示不过滤；非 null 为被点击的重复型号值

// 由 XM 数据筛选出已定型（定型 === true）的行，并自底向上重新编号：
// 表格最下方为序列 1，向上依次递增（与 XM 视图「最小的在下面、从小到大」排序一致）
function getPriceList() {
  var fin = [];
  rawData.forEach(function (r, i) { if (r && r['定型']) fin.push({ row: r, idx: i }); });
  var counter = 0;
  for (var i = fin.length - 1; i >= 0; i--) { counter++; fin[i].newSeq = counter; }
  return fin.map(function (o) {
    var r = Object.assign({}, o.row);
    r['序列'] = o.newSeq;     // 价格视图内独立的自增序列号
    r.__idx = o.idx;          // 指向 XM 源数据的下标，操作会同步回源
    return r;
  });
}

function getPriceFiltered() {
  var filters = [];
  priceDisplayCols.forEach(function (c) {
    var fid = (typeof c === 'object') ? (c.filterId || null) : ('pf_' + c);
    if (!fid) return;
    var el = document.getElementById(fid);
    if (el && el.value.trim()) filters.push({ fields: priceColFields(c), text: el.value.trim().toLowerCase() });
  });
  return getPriceList().filter(function (row) {
    if (priceModelFilter && (row['型号'] || '').toString().trim() !== priceModelFilter) return false;
    return filters.every(function (flt) {
      return flt.fields.some(function (field) {
        return (row[field] || '').toString().toLowerCase().indexOf(flt.text) !== -1;
      });
    });
  });
}

// 返回价格表中「型号」出现次数 > 1 的值集合（仅用于红色标记；基于全量定型行，不受文本筛选影响，保证高亮稳定）
function getDuplicateModels() {
  var counts = {};
  getPriceList().forEach(function (r) {
    var m = (r['型号'] || '').toString().trim();
    if (m) counts[m] = (counts[m] || 0) + 1;
  });
  var dup = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dup[k] = true; });
  return dup;
}

function updatePriceModelFilterBar() {
  var bar = document.getElementById('priceModelFilterBar');
  if (!bar) return;
  if (priceModelFilter) {
    bar.style.display = '';
    var t = document.getElementById('priceModelFilterText');
    if (t) t.textContent = priceModelFilter;
  } else {
    bar.style.display = 'none';
  }
}

function clearPriceModelFilter() {
  priceModelFilter = null;
  renderPrice();
}
function updateOrderModelFilterBar() {
  var bar = document.getElementById('orderModelFilterBar');
  if (!bar) return;
  if (orderModelFilter) {
    bar.style.display = '';
    var t = document.getElementById('orderModelFilterText');
    if (t) t.textContent = orderModelFilter;
  } else {
    bar.style.display = 'none';
  }
}
function clearOrderModelFilter() {
  orderModelFilter = null;
  updateOrderModelFilterBar();
  renderOrder();
}

// 价格明细：只读单元格展示（非编辑态，以及编辑态下不可编辑列，均复用此函数）
function priceCellDisplay(td, item, col, dupModels, orderModelSet) {
  var val = item[col];
  // 何健价格/何健价格备注/成交价备注/工况 列内容字号与「配置」列一致（10px）；标题列不应用此规则
  if (col === '何健价格' || col === '何健价格备注' || col === '成交价备注' || col === '工况') {
    td.style.fontSize = '10px';
  }
  if (col === '配置') {
    // 与方案明细表统一：仅（）/()内有内容才加浅蓝底，自由文本原样显示（修复新行勾选定型后配置列显示多余空模板字段的问题）
    td.innerHTML = configDisplayXm(val);
    td.style.textAlign = 'left';
    td.style.fontSize = '10px';  // 价格明细配置列字体再小2号（基准13px→12px→10px）
  } else if (col === '建档日期' || col === '价格申请日期') {
    td.textContent = formatPriceDate(val);
  } else if (col === '序列') {
    td.style.fontWeight = '600';
    td.style.color = '#1a73e8';
    td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
  } else if (col === '成交价') {
    // 成交价由订单明细按「型号」↔「规格型号」匹配后自动填入（只读、不可手动编辑）
    var _cj = lookupChengJiaPrice(item['型号'], item['价格申请日期']);
    var _src = rawData[item.__idx];
    if (_src && (_src['成交价'] || '') !== _cj) { _src['成交价'] = _cj; _cjDirty = true; }
    if (_cj === '' || _cj === null || _cj === undefined) {
      td.textContent = '';
    } else {
      td.textContent = _cj;
      td.style.fontWeight = '700';
      td.style.color = '#0a7d3b';
      td.title = '由订单明细按「规格型号」匹配对应「单价」自动填入';
    }
  } else {
    td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
    if (col === '型号') {
      var mkey = (val === '' || val === null || val === undefined) ? '' : String(val).trim();
      td.title = mkey;
      var mcls = 'col-model';
      if (dupModels[mkey]) mcls += ' model-dup';
      if (orderModelSet[mkey]) mcls += ' model-in-order';
      td.className = mcls;
      if (dupModels[mkey]) {
        td.onclick = (function (mv) {
          return function () {
            // 再次点击同一型号 → 取消筛选；否则切换为该型号筛选
            priceModelFilter = (priceModelFilter === mv) ? null : mv;
            renderPrice();
          };
        })(mkey);
      }
    }
  }
}

// 合并列渲染：多个字段上下堆叠显示，单元格内容居中，不含字段前缀标签
// （如 建档时间+变更时间、项目号+项目名称、成交价+成交价备注）
function renderCombinedCell(td, item, dc, dupModels, orderModelSet, editing) {
  td.style.textAlign = 'center';
  td.style.verticalAlign = 'middle';
  td.style.lineHeight = '1.4';
  var isDateCombo = (dc.cls || '').indexOf('col-combo-date') !== -1;
  // 日期合并列（建档时间/变更时间/价格日期）交由 autoFit 在 60px 列宽下缩字，与方案明细「建档日期」内容字号保持一致；其余合并列保持 10px
  if (!isDateCombo) td.style.fontSize = '10px';
  var html = '';
  dc.combine.forEach(function (field) {
    var disp = '', style = '';
    if (editing && (field === '价格申请日期' || field === '何健价格' || field === '何健价格备注')) {
      // 编辑态：价格申请日期 / 何健价格 / 何健价格备注 可编辑（其余字段只读），input 失焦写入源数据
      var initVal = field === '价格申请日期' ? formatPriceDate(item[field]) : (item[field] || '');
      var _fs = field === '价格申请日期' ? '12px' : '10px';
      html += '<div class="combo-line"><input class="cell-input" data-field="' + field + '" style="width:100%;box-sizing:border-box;font-size:' + _fs + ';" value="' + escapeHtml(initVal) + '"></div>';
    } else if (field === '建档日期' || field === '变更时间' || field === '价格申请日期') {
      disp = formatPriceDate(item[field]);
      html += '<div class="combo-line"' + (style ? ' style="' + style + '"' : '') + '>' + escapeHtml(disp) + '</div>';
    } else if (field === '成交价') {
      // 成交价由订单明细按「型号」↔「规格型号」匹配后自动填入（只读、不可手动编辑）
      var _cj = lookupChengJiaPrice(item['型号'], item['价格申请日期']);
      var _src = rawData[item.__idx];
      if (_src && (_src['成交价'] || '') !== _cj) { _src['成交价'] = _cj; _cjDirty = true; }
      disp = (_cj === '' || _cj === null || _cj === undefined) ? '' : String(_cj);
      if (disp !== '') style = 'font-weight:700;color:#0a7d3b;';
      html += '<div class="combo-line"' + (style ? ' style="' + style + '"' : '') + '>' + escapeHtml(disp) + '</div>';
    } else {
      var v = item[field];
      disp = (v === '' || v === null || v === undefined) ? '' : String(v);
      html += '<div class="combo-line"' + (style ? ' style="' + style + '"' : '') + '>' + escapeHtml(disp) + '</div>';
    }
  });
  td.innerHTML = html;
  if (dc.combine.indexOf('成交价') !== -1) {
    td.title = '成交价：由订单明细按「规格型号」匹配对应「单价」自动填入';
  }
  // 编辑态：合并列内所有可编辑 input（价格申请日期 / 何健价格 / 何健价格备注 等）绑定提交
  if (editing) {
    td.querySelectorAll('input.cell-input').forEach(function (inp) {
      var f = inp.getAttribute('data-field') || '价格申请日期';
      inp.onblur = (function (ri, cf) { return function () { commitPriceEdit(inp, ri, cf); }; })(item.__idx, f);
      inp.onkeydown = function (e) {
        if (e.key === 'Enter') { e.preventDefault(); inp.blur(); }
        else if (e.key === 'Escape') { priceEditingIdx = null; renderPrice(); }
      };
    });
  }
}

// 价格明细：使「配置」「工况」列宽 = 方案明细「配置」「工况」列宽（用户要求两表对齐）
// 价格明细表列宽对齐（配置/工况直接用方案明细实测固定基准宽，不受本表其他列加宽影响）：
//  · 日期合并列(建档时间/变更时间)   = 方案明细「建档日期」列宽
//  · 项目合并列(项目号/名称)         = 方案明细「项目名称」列宽
//  · 成交价合并列(成交价/成交价备注)  = 方案明细「项目名称」列宽
//  · 配置列                         = 方案明细「配置」列宽(_xmConfigColW)
//  · 工况列                         = 方案明细「工况」列宽(_xmCondColW，已为配置/2)
//  · 何健价格合并列(何健价格/价格备注)= 成交价合并列宽（即末列与倒数第二列一致，须最后加宽）
//  · 工况列                          = 配置列宽 / 2
function syncPriceColWidths() {
  var tbl = document.getElementById('priceTable');
  if (!tbl || tbl.offsetParent === null) return;
  var ths = tbl.querySelectorAll('thead th');
  var idx = {};
  for (var i = 0; i < ths.length; i++) {
    idx[(ths[i].textContent || '').trim()] = i; // 合并列表头 textContent 为「建档时间变更时间」等（div 堆叠无空格）
  }
  function setW(title, w) {
    if (!w) return;
    var j = idx[title];
    if (j === undefined) return;
    var th = ths[j];
    th.style.width = w + 'px'; th.style.minWidth = w + 'px'; th.style.maxWidth = w + 'px';
    var rows = tbl.querySelectorAll('tbody tr');
    rows.forEach(function (r) { var c = r.cells[j]; if (c) { c.style.width = w + 'px'; c.style.minWidth = w + 'px'; c.style.maxWidth = w + 'px'; } });
  }
  // 1) 日期合并列 = 方案明细「建档日期」列宽
  if (_xmDateColW) setW('建档时间变更时间价格日期', _xmDateColW);
  // 2) 项目合并列 = 方案明细「项目名称」列宽
  if (_xmProjColW) setW('项目号项目名称', _xmProjColW);
  // 3) 成交价合并列 = 方案明细「项目名称」列宽（与项目列同宽）
  if (_xmProjColW) setW('成交价成交价备注', _xmProjColW);
  // 4) 价格明细「配置」「工况」列宽 = 方案明细「配置」「工况」列宽（用户要求两表对齐）。
  //    直接用方案明细已测得的固定基准宽（_xmConfigColW/_xmCondColW），不再以本表自然宽测量，避免被其他列加宽连带影响。
  if (_xmConfigColW) setW('配置', _xmConfigColW);
  if (_xmCondColW) setW('工况', _xmCondColW);
  // 5) 何健价格合并列（末列）= 成交价合并列宽（倒数第二列），即末列与倒数第二列一致
  if (_xmProjColW) setW('何健价格价格备注', _xmProjColW);
}

function renderPrice() {
  _cjDirty = false; // 先重置，渲染过程中若成交价被自动匹配刷新再置位
  priceTableBody.innerHTML = '';
  var dupModels = getDuplicateModels();
  var orderModelSet = getOrderModelInfo().modelSet;
  updatePriceModelFilterBar();
  var list = getPriceFiltered();
  if (list.length === 0) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="' + (priceDisplayCols.length + 1) + '" style="padding:14px;color:#999;">暂无定型方案，请在「XM方案明细」中将方案勾选为「定型」</td>';
    priceTableBody.appendChild(tr);
    return;
  }
  list.forEach(function (item) {
    var tr = document.createElement('tr');
    tr.dataset.idx = item.__idx; // 供局部更新按行定位（性能优化）
    var _seqNum = parseInt(item['序列'], 10);
    if (!isNaN(_seqNum) && _seqNum % 2 === 0) tr.className = 'row-even';
    // 操作列：删除 / 编辑 / 定型 三个按钮纵向排列（操作同步作用于 XM 源数据）
    var tdOp = document.createElement('td');
    tdOp.className = 'op-cell';
    var rowIdx = item.__idx;
    var isEditing = (priceEditingIdx === rowIdx);
    var del = document.createElement('button');
    del.className = 'op-btn del-btn';
    del.textContent = '删除';
    del.onclick = (function (ri) { return function () { deleteRow(ri); }; })(rowIdx);
    tdOp.appendChild(del);
    var editBtn = document.createElement('button');
    if (isEditing) {
      editBtn.className = 'op-btn done-btn';
      editBtn.textContent = '完成';
      editBtn.onclick = (function () { return function () {
        priceEditingIdx = null;
        // 仅在点击「完成」后触发同步：把价格明细的项目名称/配置回填到订单明细，并刷新各视图与 GitHub
        syncOrderFromPrice();
        persistData();
        renderPrice();
        renderOrder();
        scheduleSync();
      }; })();
    } else {
      editBtn.className = 'op-btn edit-btn';
      editBtn.textContent = '编辑';
      editBtn.onclick = (function (ri) { return function () { priceEditingIdx = rowIdx; renderPrice(); }; })(rowIdx);
    }
    tdOp.appendChild(editBtn);
    var finalized = !!rawData[rowIdx]['定型'];
    var finBtn = document.createElement('button');
    finBtn.className = 'op-btn finalize-btn' + (finalized ? ' finalized' : '');
    finBtn.textContent = finalized ? '☑定' : '☐定';
    finBtn.onclick = (function (ri) { return function () { toggleFinalize(ri); }; })(rowIdx);
    tdOp.appendChild(finBtn);
    tr.appendChild(tdOp);
    // 数据列（列顺序见 priceDisplayCols；合并列一个单元格内堆叠多个字段）
    priceDisplayCols.forEach(function (dc) {
      // 合并列：直接渲染堆叠单元格
      if (typeof dc === 'object') {
        var tdc = document.createElement('td');
        tdc.dataset.idx = item.__idx; // 供局部更新按单元格定位（性能优化）
        tdc.dataset.col = dc.label;
        tdc.className = dc.cls || '';
        renderCombinedCell(tdc, item, dc, dupModels, orderModelSet, (priceEditingIdx === item.__idx));
        tr.appendChild(tdc);
        return;
      }
      var col = dc;
      var td = document.createElement('td');
      td.dataset.idx = item.__idx; // 供局部更新按单元格定位（性能优化）
      td.dataset.col = col;
      if (col === '变更时间') td.className = 'col-time';
      if (col === '建档日期' || col === '价格申请日期') td.className = 'col-date-sm';
      if (col === '型号') td.className = 'col-model';
      if (priceEditingIdx === item.__idx) {
        // 编辑态：仅「何健价格」「何健价格备注」「价格申请日期」可编辑，其余列只读展示（带锁定样式）
        if (priceEditableCols.indexOf(col) !== -1) {
          var input = document.createElement('input');
          input.className = 'cell-input';
          if (col === '何健价格' || col === '何健价格备注') {
            input.style.fontSize = '10px'; // 编辑框字号与配置列内容一致
          }
          var initVal = rawData[item.__idx][col];
          if (col === '建档日期' || col === '价格申请日期') initVal = formatPriceDate(initVal);
          input.value = (initVal === undefined || initVal === null) ? '' : initVal;
          if (col === '价格申请日期') {
            // 该列窄（40px），编辑框加宽以便输入日期
            input.style.width = '110px';
            input.style.minWidth = '110px';
          }
          td.appendChild(input);
          input.onblur = (function (ri, c, inp) { return function () { commitPriceEdit(inp, ri, c); }; })(item.__idx, col, input);
          input.onkeydown = function (e) {
            if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
            else if (e.key === 'Escape') { priceEditingIdx = null; renderPrice(); }
          };
        } else {
          priceCellDisplay(td, item, col, dupModels, orderModelSet);
          td.classList.add('cell-locked');
        }
      } else {
        priceCellDisplay(td, item, col, dupModels, orderModelSet);
      }
      tr.appendChild(td);
    });
      priceTableBody.appendChild(tr);
  });
  applyPriceRenameColWidths(); // 锁定重命名列宽为「重命名前」宽度
  syncPriceColWidths(); // 先对齐列宽（日期合并列=方案明细建档日期宽），再交给 autoFit 在该列宽下缩字，使内容与方案明细建档日期字号一致
  scheduleAutoFit(priceTable);
  if (_cjDirty) persistData(); // 成交价被订单匹配刷新后写回源数据并持久化
  layoutFilterBar('priceTable');
}

function startPriceEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var iv = rawData[rowIdx][col];
  if (col === '建档日期') iv = formatPriceDate(iv);
  input.value = iv || '';
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishPriceEdit(td, rowIdx, col, input.value); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderPrice(); }
  };
}

function finishPriceEdit(td, rowIdx, col, val) {
  if (rawData[rowIdx][col] !== val) {
    rawData[rowIdx][col] = val;
    // 合并列编辑时，同步到同一方案（XM 序列号相同）的所有变更行
    var affected = [rowIdx];
    if (MERGE_COLS.indexOf(col) !== -1) {
      var pid = String(rawData[rowIdx]['序列']);
      rawData.forEach(function (r, i) { if (String(r['序列']) === pid) { r[col] = val; affected.push(i); } });
    }
    persistData();
    // 局部更新受影响行的对应单元格，避免整表重建（性能优化）
    affected.forEach(function (ri) {
      var tr = priceTableBody.querySelector('tr[data-idx="' + ri + '"]');
      if (!tr) return;
      var cell = tr.querySelector('td[data-col="' + col + '"]');
      if (!cell) return;
      if (col === '建档日期' || col === '价格申请日期') cell.textContent = formatPriceDate(val);
      else if (col === '配置') cell.innerHTML = configDisplay(val);
      else cell.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      fitSingleCell(cell);
    });
    scheduleSync();
  } else {
    // 值未变，仍把输入框还原为文本显示
    if (col === '建档日期' || col === '价格申请日期') td.textContent = formatPriceDate(val);
    else if (col === '配置') td.innerHTML = configDisplay(val);
    else td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
    fitSingleCell(td);
  }
}

function editPriceRow(rowIdx) { priceEditingIdx = rowIdx; renderPrice(); }

// 编辑模式下提交单个单元格（仅保存，不重渲染，避免失焦竞态；由「完成」统一退出）
function commitPriceEdit(input, rowIdx, col) {
  var val = input.value;
  rawData[rowIdx][col] = val;
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  // 仅本地保存；同步（订单回填 + GitHub）推迟到点击「完成」按钮时统一触发
  persistData();
}

// 价格视图不再单独维护数据：所有操作都作用于 XM 源数据（deleteRow/toggleFinalize 已复用）

// ==================== 订单明细视图（由上传的订单明细.xlsx 生成，独立维护数据） ====================
var orderColumns = ["订单类型", "订单状态", "内部订单号（必填）", "订单日期", "客户查找关联", "规格型号", "数量", "单位", "单价", "金额", "负责人", "价格申请日期", "项目名称", "配置"];
var orderEditingIdx = null;
var orderTableBody = document.getElementById('orderTableBody');
var orderTable = document.getElementById('orderTable');
// 性能优化：订单表点击高亮改用事件委托（整表一个监听），避免给每个单元格挂 onclick 闭包（2756 行约 3.8 万单元格）
if (orderTableBody && !orderTableBody._delegated) {
  orderTableBody.addEventListener('click', function (e) {
    var cell = e.target.closest ? e.target.closest('td') : null;
    if (cell && cell.tagName === 'TD') {
      if (cell.getAttribute('data-col') === '规格型号' && cell.classList.contains('order-model-dup')) {
        var mv = (cell.textContent || '').trim();
        orderModelFilter = (orderModelFilter === mv) ? null : mv;
        updateOrderModelFilterBar();
        renderOrder();
        return;
      }
      highlightOrderCell(cell);
    }
  });
  orderTableBody._delegated = true;
}
// 窗口尺寸变化会使缓存的列宽失效，下次渲染重新测量
window.addEventListener('resize', invalidateOrderColWidths);
// 数据字段重命名迁移：列标题调整后兼容旧订单数据（幂等，可重复执行）
(function migrateOrderColumns() {
  var renameMap = { '订单负责人': '负责人', '订单数量': '数量' };
  orderData.forEach(function (r) {
    Object.keys(renameMap).forEach(function (oldK) {
      if (oldK in r) { r[renameMap[oldK]] = r[oldK]; delete r[oldK]; }
    });
    if ('客户订单号' in r) delete r['客户订单号'];
  });
})();
// ===== 订单 ↔ 价格 联动 =====
var orderModelFilter = null; // 订单表按型号筛选：null 不过滤

function normalizeDate(v) {
  if (v === undefined || v === null) return '';
  var s = String(v).trim();
  if (!s) return '';
  var m = s.match(/^(\d{2,4})[/\-.](\d{1,2})[/\-.](\d{1,2})$/);
  if (m) {
    var y = parseInt(m[1], 10); if (y < 100) y += 2000;
    var mo = String(parseInt(m[2], 10)).padStart(2, '0');
    var d = String(parseInt(m[3], 10)).padStart(2, '0');
    return y + '-' + mo + '-' + d;
  }
  return s;
}

// 统计订单表规格型号出现次数 → {counts, dupSet(>1), modelSet(全部)}
var _orderModelCache = null; // 缓存规格型号统计结果，避免每次渲染重复遍历 2756 行
function getOrderModelInfo() {
  if (_orderModelCache) return _orderModelCache;
  var counts = {}, modelSet = {}, byModel = {};
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m) return;
    counts[m] = (counts[m] || 0) + 1;
    modelSet[m] = true;
    (byModel[m] = byModel[m] || []).push({ 单价: r['单价'], 价格申请日期: r['价格申请日期'] });
  });
  var dupSet = {};
  Object.keys(counts).forEach(function (k) { if (counts[k] > 1) dupSet[k] = true; });
  _orderModelCache = { counts: counts, dupSet: dupSet, modelSet: modelSet, byModel: byModel };
  return _orderModelCache;
}

// 按「型号」从订单明细匹配 单价 → 价格明细的「成交价」。
// 匹配规则与 syncOrderFromPrice 反向一致：同型号在订单中唯一则直接取；
// 多个匹配时按「价格申请日期」精确匹配；日期也无法确定唯一时返回空，避免误填。
function lookupChengJiaPrice(model, applyDate) {
  if (model === undefined || model === null) return '';
  var m = String(model).trim();
  if (!m) return '';
  var info = getOrderModelInfo();
  var arr = info.byModel[m];
  if (!arr || !arr.length) return '';
  var getPrice = function (x) {
    var v = (x && x['单价']);
    return (v === undefined || v === null) ? '' : String(v);
  };
  if (arr.length === 1) {
    var od = normalizeDate(applyDate);
    if (od) {
      var hit = arr.filter(function (x) { return normalizeDate(x['价格申请日期']) === od; })[0];
      if (hit) return getPrice(hit);
    }
    return getPrice(arr[0]);
  }
  var ad = normalizeDate(applyDate);
  if (ad) {
    for (var i = 0; i < arr.length; i++) {
      if (normalizeDate(arr[i]['价格申请日期']) === ad) return getPrice(arr[i]);
    }
  }
  return ''; // 多匹配且日期无法唯一确定 → 不填，避免填错成交价
}

// 批量刷新：把订单明细匹配到的单价写入价格明细源数据的「成交价」，仅变更时持久化。
// 在切换/刷新价格视图时调用，保证成交价始终与订单最新状态一致。
function syncChengJiaToPrice() {
  var changed = false;
  rawData.forEach(function (r) {
    if (!r || !r['定型']) return;
    var cj = lookupChengJiaPrice(r['型号'], r['价格申请日期']);
    if ((r['成交价'] || '') !== cj) { r['成交价'] = cj; changed = true; }
  });
  if (changed) persistData();
}

// 把价格明细的项目名称/配置 同步到订单明细（按规格型号匹配；订单中该型号唯一直接填，重复则需价格申请日期一致）
function syncOrderFromPrice() {
  var priceByModel = {};
  getPriceList().forEach(function (p) {
    var m = (p['型号'] || '').toString().trim();
    if (!m) return;
    (priceByModel[m] = priceByModel[m] || []).push(p);
  });
  if (!Object.keys(priceByModel).length) return;
  var info = getOrderModelInfo();
  var changed = false;
  orderData.forEach(function (r) {
    var m = (r['规格型号'] || '').toString().trim();
    if (!m || !priceByModel[m]) return;
    var candidates = priceByModel[m];
    var orderCount = info.counts[m];
    var pick = null;
    if (orderCount === 1) {
      var od = normalizeDate(r['价格申请日期']);
      pick = (od && candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od; })[0]) || candidates[0];
    } else {
      var od2 = normalizeDate(r['价格申请日期']);
      if (!od2) return;
      pick = candidates.filter(function (c) { return normalizeDate(c['价格申请日期']) === od2; })[0];
      if (!pick) return;
    }
    if (pick['项目名称'] && pick['项目名称'] !== r['项目名称']) { r['项目名称'] = pick['项目名称']; changed = true; }
    if (pick['配置'] && pick['配置'] !== r['配置']) { r['配置'] = pick['配置']; changed = true; }
  });
  if (changed) persistData();
}
// 订单明细：列宽比例调整。每次渲染都基于“当前自然宽 × 比例”计算，不依赖跨渲染状态，确定可靠。
var orderFilterCols = [
  { id: 'of_customer', col: '客户查找关联' },
  { id: 'of_model', col: '规格型号' },
  { id: 'of_owner', col: '负责人' }
];

// 筛选栏与表格列对齐：每表按表头列顺序生成等宽单元格，对应列的单元格放入筛选输入框，
// 输入框宽度 = 该列宽，从而【位置】与【列宽】都和对应表格列保持一致。
var FILTER_INPUTS = {
  dataTable:  { '客户': 'f_客户', '项目号': 'f_项目号', '项目名称': 'f_项目名称', '工程师': 'f_工程师', '规格型号': 'f_型号' },
  priceTable: { '客户': 'pf_客户', '项目号项目名称': 'pf_项目', '工程师': 'pf_工程师', '规格型号': 'pf_型号' },
  orderTable: { '客户查找关联': 'of_customer', '规格型号': 'of_model', '负责人': 'of_owner' }
};

function initFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  if (!bar || bar.dataset.built) return;
  var table = document.getElementById(tableId);
  if (!table) return;
  var ths = table.querySelectorAll('thead th');
  var map = FILTER_INPUTS[tableId] || {};
  // 先取出已有输入框与按钮（避免清空后丢失节点）
  var inputs = {};
  Object.keys(map).forEach(function (k) {
    var el = document.getElementById(map[k]);
    if (el) inputs[k] = el;
  });
  var btns = [];
  var bNodes = bar.querySelectorAll('button');
  for (var b = 0; b < bNodes.length; b++) btns.push(bNodes[b]);
  bar.innerHTML = '';
  for (var i = 0; i < ths.length; i++) {
    var key = (ths[i].textContent || '').trim();
    var cell = document.createElement('div');
    cell.className = 'fcell';
    var inp = inputs[key];
    if (inp) cell.appendChild(inp);
    bar.appendChild(cell);
  }
  var actions = document.createElement('div');
  actions.className = 'fbar-actions';
  for (var j = 0; j < btns.length; j++) actions.appendChild(btns[j]);
  bar.appendChild(actions);
  bar.dataset.built = '1';
}

// 按表头列宽同步每个筛选单元格宽度（隐藏视图跳过，待显示时再布局）
function layoutFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  var table = document.getElementById(tableId);
  if (!bar || !table || !bar.dataset.built) return;
  if (table.offsetParent === null) return; // 视图隐藏时跳过
  var ths = table.querySelectorAll('thead th');
  var cells = bar.children;
  for (var i = 0; i < ths.length && i < cells.length; i++) {
    if (!cells[i].classList || !cells[i].classList.contains('fcell')) continue;
    var w = ths[i].offsetWidth;
    if (w) cells[i].style.width = w + 'px';
  }
}

function initAllFilterBars() {
  initFilterBar('dataTable');
  initFilterBar('priceTable');
  initFilterBar('orderTable');
}

// 连续编号：序列 = 行序（从 1 开始，顶部为 1）
function renumberOrders() {
  for (var i = 0; i < orderData.length; i++) orderData[i]['序列'] = i + 1;
}

function getOrderFiltered() {
  var f = {};
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el && el.value.trim()) f[o.col] = el.value.trim().toLowerCase();
  });
  return orderData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    if (orderModelFilter) {
      var m = (row['规格型号'] || '').toString().trim();
      if (m !== orderModelFilter) return false;
    }
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function orderCellClass(col) {
  if (col === '内部订单号（必填）') return 'col-fixed';
  if (col === '订单日期' || col === '价格申请日期') return 'col-date';
  if (col === '订单类型' || col === '订单状态' || col === '数量' || col === '单价' || col === '负责人') return 'col-half w40';
  if (col === '单位') return 'col-half w30';
  if (col === '金额') return 'col-half w50';
  if (col === '客户查找关联' || col === '规格型号') return 'col-cust';
  return '';
}

function renderOrder() {
  var list = getOrderFiltered();
  var orderModelInfo = getOrderModelInfo();
  // 预计算每列元数据（只算一次，避免每次渲染 4 万次 orderCellClass 调用与分支判断）
  if (!renderOrder._meta) {
    var meta = [];
    for (var k = 0; k < orderColumns.length; k++) {
      var col = orderColumns[k];
      meta.push({
        col: col,
        cls: orderCellClass(col),
        isDate: (col === '订单日期' || col === '价格申请日期'),
        isModel: (col === '规格型号')
      });
    }
    renderOrder._meta = meta;
  }
  var META = renderOrder._meta;
  // 按订单日期倒序排列（最新日期在最上方）
  list.sort(function (a, b) {
    return orderDateValue(b['订单日期']) - orderDateValue(a['订单日期']);
  });
  if (list.length === 0) {
    orderTableBody.innerHTML = '<tr><td colspan="' + (orderColumns.length + 2) + '" style="padding:14px;color:#999;">暂无数据</td></tr>';
    return;
  }
  // 性能优化：用单次 innerHTML 批量构建 tbody（2756 行 × 15 列约 4 万单元格），避免逐个 createElement/appendChild
  var rows = new Array(list.length);
  for (var i = 0; i < list.length; i++) {
    var item = list[i];
    var mval = (item['规格型号'] || '').toString().trim();
    var cells = ['<td class="seq-cell col-half w30" data-col="序列">' + (i + 1) + '</td>'];
    for (var k = 0; k < META.length; k++) {
      var m = META[k];
      var val = item[m.col];
      if (m.isDate) val = formatOrderDate(val);
      var disp = (val === '' || val === null || val === undefined) ? '' : String(val);
      var cls = m.cls;
      if (m.isModel && orderModelInfo.dupSet[mval]) cls = (cls ? cls + ' ' : '') + 'order-model-dup';
      cells.push('<td' + (cls ? ' class="' + cls + '"' : '') + ' data-col="' + m.col + '">' + escapeHtml(disp) + '</td>');
    }
    rows[i] = '<tr' + (item['定型'] ? ' class="finalized-row"' : '') + '>' + cells.join('') + '</tr>';
  }
  orderTableBody.innerHTML = rows.join('');
  applyOrderColumnRatios();
  scheduleAutoFit(orderTable);
  layoutFilterBar('orderTable');
}

// 列宽比例调整：首次测量并缓存结果，之后直接套用（仅写不读，去除每次渲染对上万单元格的 offsetWidth 读取）
var _orderColWidths = null; // {col: targetPx}
var _orderColMeasuring = false; // 防止同帧重复安排测量
function invalidateOrderColWidths() { _orderColWidths = null; _orderModelCache = null; }

function applyOrderColumnRatios() {
  var ratios = {
    '订单状态': 2 / 3,
    '订单日期': 2 / 3,
    '客户查找关联': 3 / 4,
    '规格型号': 3 / 4,
    '负责人': 2 / 3,
    '价格申请日期': 2 / 3
  };
  // 已缓存：直接套用，不重新测量（无 layout 读取，仅一次重排）
  if (_orderColWidths) {
    for (var c in _orderColWidths) {
      if (!ratios.hasOwnProperty(c)) continue;
      var tw = _orderColWidths[c];
      var th = document.querySelector('#orderTable th[data-col="' + c + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = tw + 'px';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + c + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = tw + 'px';
    }
    return;
  }
  var cols = Object.keys(ratios);
  // 首次测量推迟到下一帧：先让表格以自然宽瞬时呈现（点击进入不卡），后台再测宽并缓存套用
  if (_orderColMeasuring) return; // 本帧已安排测量，避免重复
  _orderColMeasuring = true;
  requestAnimationFrame(function () {
    _orderColMeasuring = false;
    // 若订单表当前不可见（例如正在「方案明细」视图中编辑、保存时触发了 renderOrder），
    // 隐藏表的 offsetWidth 为 0，测得自然宽 0 会把列宽错误锁成 18px。此时放弃测量、不写缓存，
    // 待订单视图真正显示时由 showView → renderOrder 重新触发测量（已先 invalidateOrderColWidths）。
    var _ov = document.getElementById('orderView');
    if (!_ov || _ov.offsetParent === null) return;
    // 写阶段①：清除所有目标列的固定宽，量自然宽
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      if (th) th.style.width = th.style.minWidth = th.style.maxWidth = '';
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      for (var i = 0; i < cells.length; i++) cells[i].style.width = cells[i].style.minWidth = cells[i].style.maxWidth = '';
    });
    // 读阶段：量取每列最大自然宽（全部读，无穿插写，仅触发一次重排）
    var res = {};
    cols.forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      if (!th || !cells.length) return;
      var natural = th.offsetWidth;
      for (var i = 0; i < cells.length; i++) { var w = cells[i].offsetWidth; if (w > natural) natural = w; }
      res[col] = { th: th, cells: cells, target: Math.max(18, Math.round(natural * ratios[col])) };
    });
    // 写阶段②：统一回写目标列宽，并缓存结果供后续渲染复用
    var store = {};
    cols.forEach(function (col) {
      var r = res[col];
      if (!r) return;
      r.th.style.width = r.th.style.minWidth = r.th.style.maxWidth = r.target + 'px';
      for (var i = 0; i < r.cells.length; i++) r.cells[i].style.width = r.cells[i].style.minWidth = r.cells[i].style.maxWidth = r.target + 'px';
      store[col] = r.target;
    });
    _orderColWidths = store;
  });
}

function highlightOrderCell(td) {
  // 清除上一次高亮（整表所有 .hl）
  var prev = orderTable.querySelectorAll('td.hl, th.hl');
  Array.prototype.forEach.call(prev, function (c) { c.classList.remove('hl'); });
  var tr = td.parentElement;
  var idx = td.cellIndex;
  // 高亮整行
  Array.prototype.forEach.call(tr.querySelectorAll('td'), function (c) { c.classList.add('hl'); });
  // 高亮整列（含表头，按列索引定位）
  Array.prototype.forEach.call(orderTable.querySelectorAll('tr'), function (row) {
    var cell = row.cells[idx];
    if (cell) cell.classList.add('hl');
  });
}
function startOrderEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var rawVal = (orderData[rowIdx][col] === undefined || orderData[rowIdx][col] === null) ? '' : orderData[rowIdx][col];
  input.value = (col === '订单日期') ? formatOrderDate(rawVal) : rawVal;
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishOrderEdit(input.value, rowIdx, col); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderOrder(); }
  };
}
function finishOrderEdit(val, rowIdx, col) {
  if (orderData[rowIdx][col] !== val) {
    orderData[rowIdx][col] = val;
    persistData();
    invalidateOrderColWidths();
    renderOrder();
    scheduleSync();
  }
}
function commitOrderEdit(input, rowIdx, col) {
  orderData[rowIdx][col] = input.value;
  persistData();
  scheduleSync();
}
function editOrderRow(rowIdx) { orderEditingIdx = rowIdx; renderOrder(); }
function addOrderRow() {
  // 清空当前筛选条件，确保新增的空白行一定可见（否则空行会被筛选隐藏，造成「点了没反应」）
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el) el.value = '';
  });
  var row = { 序列: 0, 定型: false };
  orderColumns.forEach(function (c) { row[c] = ''; });
  orderData.unshift(row);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}
function toggleOrderFinalize(rowIdx) {
  orderData[rowIdx]['定型'] = !orderData[rowIdx]['定型'];
  persistData();
  renderOrder();
  scheduleSync();
}
function deleteOrderRow(idx) {
  if (!confirm('确定删除这条订单记录吗？')) return;
  orderData.splice(idx, 1);
  renumberOrders();
  persistData();
  invalidateOrderColWidths();
  renderOrder();
  scheduleSync();
}

// 视图切换：三个界面共用同一标题栏（方案明细 / 价格明细 / 订单明细）
function showView(name) {
  currentView = name;
  document.getElementById('xmView').style.display = (name === 'xm') ? '' : 'none';
  document.getElementById('priceView').style.display = (name === 'price') ? '' : 'none';
  document.getElementById('orderView').style.display = (name === 'order') ? '' : 'none';
  document.getElementById('navXm').classList.toggle('active', name === 'xm');
  document.getElementById('navPrice').classList.toggle('active', name === 'price');
  document.getElementById('navOrder').classList.toggle('active', name === 'order');
  if (name === 'xm') render();
  else if (name === 'price') renderPrice();
  else { invalidateOrderColWidths(); renderOrder(); }
}

// ==================== 增删 ====================
// 序列 = 方案编号（同一方案的多条变更共享同一编号；新增取最大号+1，删除方案后由 renumberSchemes 重新连续编号）
function addRow() {
  var now = new Date().toLocaleString('zh-CN');
  var maxSeq = 0;
  rawData.forEach(function (r) { var n = parseFloat(r['序列']); if (!isNaN(n) && n > maxSeq) maxSeq = n; });
  rawData.unshift({
    序列: maxSeq + 1,
    建档日期: todayStr(),
    客户: '', 项目号: '', 项目名称: '', 工程师: '',
    变更时间: now, 工况: '', 型号: '', 配置: '', 价格申请日期: '',
    定型: false
  });
  persistData();
  applyFilters();
  scheduleSync();
}

function deleteRow(idx) {
  if (!confirm('确定删除这条记录吗？')) return;
  rawData.splice(idx, 1);
  renumberSchemes(); // 删除方案后，剩余方案重新连续编号
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 新增变更（点击序列列弹出） ====================
// 与编辑对话框同构：建档日期/客户/项目号/项目名称 锁定（只读），工程师可编辑，变更时间默认当前时间，其余可编辑
var chPlanSeq = null; // 当前操作的方案编号
var CHANGE_FIELDS = [
  { key: '建档日期', id: 'ch_date', locked: true },
  { key: '客户', id: 'ch_customer', locked: true },
  { key: '项目号', id: 'ch_projno', locked: true },
  { key: '项目名称', id: 'ch_projname', locked: true },
  { key: '工程师', id: 'ch_engineer' },
  { key: '变更时间', id: 'ch_changetime', locked: true },
  { key: '工况', id: 'ch_cond', multiline: true, rows: 2 },
  { key: '型号', id: 'ch_model' },
  { key: '配置', id: 'ch_config', multiline: true, rows: 4 }
];

function buildChangeModal() {
  var box = document.getElementById('chFields');
  if (!box || box.dataset.built) return;
  var html = '';
  CHANGE_FIELDS.forEach(function (f) {
    var cls = 'ch-field';
    if (f.key === '工况' || f.key === '配置') cls += ' ch-big';
    else if (f.key === '型号') cls += ' ch-wide';
    else cls += ' ch-small';
    html += '<div class="' + cls + '">';
    html += '<label>' + f.key + (f.multiline ? '（多行）' : '') + (f.locked ? '（只读）' : '') + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="' + (f.rows || 3) + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '>';
    }
    html += '</div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
}

function openChangeDialog(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  chPlanSeq = row['序列'];
  buildChangeModal();
  document.getElementById('chPlanId').textContent = row['序列'];
  CHANGE_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    if (f.key === '变更时间') {
      el.value = todayStr(); // 默认当前日期（YYYY/MM/DD，与建档日期格式一致），且只读
    } else {
      el.value = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
    }
  });
  document.getElementById('changeModal').classList.add('show');
  // 焦点放到第一个可编辑字段（工况）
  setTimeout(function () { var c = document.getElementById('ch_cond'); if (c) c.focus(); }, 50);
}

function closeChangeModal() {
  document.getElementById('changeModal').classList.remove('show');
  chPlanSeq = null;
}

function submitChange() {
  if (chPlanSeq === null && chPlanSeq !== 0) { showToast('无效方案', 'error'); return; }
  var pid = chPlanSeq;
  // 从现有方案第一条读取固定字段（建档日期/客户/项目号/项目名称/工程师），变更行继承且锁定
  var src = rawData.find(function (r) { return String(r['序列']) === String(pid); });
  if (!src) { showToast('未找到该方案', 'error'); return; }
  var newRow = {
    序列: pid,
    建档日期: src['建档日期'],
    客户: src['客户'], 项目号: src['项目号'], 项目名称: src['项目名称'], 工程师: (document.getElementById('ch_engineer').value || '').trim(),
    变更时间: dateOnlyStr(document.getElementById('ch_changetime').value || todayStr()),
    工况: (document.getElementById('ch_cond').value || '').trim(),
    型号: (document.getElementById('ch_model').value || '').trim(),
    配置: (document.getElementById('ch_config').value || '').trim(),
    定型: false
  };
  // 插入到该方案在表格中的最上方（同一序列号合并显示时位于块首）
  var topIdx = rawData.findIndex(function (r) { return String(r['序列']) === String(pid); });
  if (topIdx === -1) topIdx = 0;
  rawData.splice(topIdx, 0, newRow);
  closeChangeModal();
  persistData();
  applyFilters();
  scheduleSync();
  showToast('✅ 已为方案 #' + pid + ' 新增变更', 'success');
}

// ==================== 编辑方案弹窗 ====================
// 点击「编辑」按钮弹出独立对话框，输入内容后点「保存」显式写回 rawData 并刷新表格，
// 不再依赖单元格失焦来提交，彻底避免「输入内容表格显示不了」的问题
var editModalIdx = null;
var EDIT_FIELDS = [
  { key: '建档日期', id: 'em_date' },
  { key: '客户', id: 'em_customer' },
  { key: '项目号', id: 'em_projno' },
  { key: '项目名称', id: 'em_projname' },
  { key: '工程师', id: 'em_engineer' },
  { key: '变更时间', id: 'em_changetime' },
  { key: '工况', id: 'em_cond', multiline: true, rows: 2 },
  { key: '型号', id: 'em_model' },
  { key: '配置', id: 'em_config', multiline: true, rows: 6 }
];

function buildEditModal() {
  var box = document.getElementById('emFields');
  if (!box || box.dataset.built) return;
  var html = '';
  EDIT_FIELDS.forEach(function (f) {
    var cls = 'em-field';
    if (f.key === '工况' || f.key === '配置') cls += ' em-big';
    else if (f.key === '型号') cls += ' em-wide';
    else cls += ' em-small';
    html += '<div class="' + cls + '">';
    html += '<label>' + f.key + (f.multiline ? '（多行）' : '') + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="' + (f.rows || 5) + '" placeholder="输入' + f.key + '"></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '">';
    }
    html += '</div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
}

function openEditModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  editModalIdx = rowIdx;
  buildEditModal();
  document.getElementById('emSeq').textContent = row['序列'] || '';
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    if (!el) return;
    var raw = (row[f.key] === undefined || row[f.key] === null) ? '' : row[f.key];
    // 变更时间显示/保存为 YYYY/MM/DD，与建档日期格式、字号一致
    el.value = (f.key === '变更时间') ? dateOnlyStr(raw) : raw;
  });
  document.getElementById('editModal').classList.add('show');
}

function closeEditModal() {
  document.getElementById('editModal').classList.remove('show');
  editModalIdx = null;
}

function saveEditModal() {
  if (editModalIdx === null) return;
  var row = rawData[editModalIdx];
  if (!row) { closeEditModal(); return; }
  var pid = String(row['序列']);
  EDIT_FIELDS.forEach(function (f) {
    var el = document.getElementById(f.id);
    var val = el ? el.value : '';
    // 变更时间保存为 YYYY/MM/DD（与建档日期一致），避免残留时分秒
    row[f.key] = (f.key === '变更时间') ? dateOnlyStr(val) : val;
    // 合并列同步到同方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(f.key) !== -1) {
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[f.key] = val; });
    }
  });
  persistData();
  applyFilters();
  // 仅在点击「保存」后触发同步：价格明细项目名称/配置回填订单，并刷新各视图与 GitHub
  syncOrderFromPrice();
  renderPrice();
  renderOrder();
  scheduleSync();
  closeEditModal();
  showToast('✅ 已保存', 'success');
}

// 当前日期（YYYY/MM/DD），用于新增行默认建档日期
function todayStr() {
  var d = new Date();
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 将「变更时间」等含时分秒的日期值统一显示为 YYYY/MM/DD（与「建档日期」格式、字号一致）
function dateOnlyStr(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (!s) return '';
  if (/^\d{4}\/\d{1,2}\/\d{1,2}$/.test(s)) return s; // 已是 YYYY/MM/DD 直接返回
  var d = new Date(s);
  if (isNaN(d.getTime())) return s; // 无法解析则原样返回，避免误清内容
  var y = d.getFullYear();
  var m = String(d.getMonth() + 1).padStart(2, '0');
  var day = String(d.getDate()).padStart(2, '0');
  return y + '/' + m + '/' + day;
}
// 价格明细由 XM 数据自动生成，无需单独存储
// 双层持久化：① 写入页面内嵌 script（供 GitHub 上传） ② 写入 localStorage（本地即时缓存，重开优先读取）
var LS_KEY_RAW = 'xm_rawData_v1';
var LS_KEY_ORDER = 'xm_orderData_v1';
var LS_KEY_DIRTY = 'xm_dirty_v1';
function persistData() {
  document.getElementById('xmData').textContent = 'var rawData = ' + JSON.stringify(rawData) + ';';
  var od = document.getElementById('orderData');
  if (od) od.textContent = 'var orderData = ' + JSON.stringify(orderData) + ';';
  // 同步写入 localStorage（同设备重开的即时缓存）
  try { localStorage.setItem(LS_KEY_RAW, JSON.stringify(rawData)); } catch(e) {}
  try { localStorage.setItem(LS_KEY_ORDER, JSON.stringify(orderData)); } catch(e) {}
  // 标记本机有改动（尚未同步到 GitHub），供打开时自动拉取判断是否需保护本地数据
  try { localStorage.setItem(LS_KEY_DIRTY, '1'); } catch(e) {}
}
// 清除本机改动标记：表示本机已与 GitHub 一致
function clearDirty() { try { localStorage.setItem(LS_KEY_DIRTY, '0'); } catch(e) {} }
function isDirty() { try { return localStorage.getItem(LS_KEY_DIRTY) === '1'; } catch(e) { return false; } }

// ==================== GitHub 配置 ====================
// 默认仓库/文件路径取自 XM方案明细（项目资产）。Token 仅通过头部输入框填入，不写入文件内容。
var DEFAULT_GH = {
  user: 'maidang0706',
  repo: 'OPP3',
  token: '',
  filePath: 'data.json',  // 统一同步通道：电脑端和手机端都读写 data.json（内容为本页面 HTML 快照）
  commitMsg: 'Update data.json'
};

function loadGitHubSettings() {
  try {
    var saved = localStorage.getItem('xm_github_settings');
    if (!saved) {
      saved = JSON.stringify(DEFAULT_GH);
      localStorage.setItem('xm_github_settings', saved);
    }
    updateSyncStatus('idle', '已配置');
  } catch (e) {}
}

// 获取配置：user/repo/filePath 固定，token 从 localStorage 读取，未设置则弹窗输入
function getGitHubSettings() {
  var saved = localStorage.getItem('xm_github_settings');
  var s = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT_GH));
  // 强制迁移：无论本机 localStorage 里存的是旧路径(XM方案明细.html)还是别的，
  // 一律统一为 data.json，保证电脑端/手机端读写同一个文件，杜绝双通道分裂
  if (s.filePath !== DEFAULT_GH.filePath || s.user !== DEFAULT_GH.user || s.repo !== DEFAULT_GH.repo) {
    s.filePath = DEFAULT_GH.filePath;
    s.user = DEFAULT_GH.user;
    s.repo = DEFAULT_GH.repo;
    s.commitMsg = DEFAULT_GH.commitMsg;
    try { localStorage.setItem('xm_github_settings', JSON.stringify(s)); } catch (e) {}
  }
  return s;
}

// ==================== GitHub同步 ====================
function updateSyncStatus(status, text) {
  var dot = document.querySelector('#syncStatus .sync-dot');
  var txt = document.getElementById('syncText');
  var el = document.getElementById('syncStatus');
  el.className = 'sync-status ' + status;
  // 在状态里显示当前读写分支，便于一眼发现「两端分支不一致」导致的数据分歧
  var settings = getGitHubSettings();
  var br = settings.branch || 'main';
  txt.textContent = (text || (status === 'idle' ? '已配置' : status === 'syncing' ? '同步中...' : '同步失败')) + ' · 分支:' + br + ' · 文件:' + (settings.filePath || '?');
}

async function syncToGitHub() {
  var settings = getGitHubSettings();
  if (!settings.token) {
    var t = prompt('请输入 GitHub Token：');
    if (!t) return;
    settings.token = t.trim();
    localStorage.setItem('xm_github_settings', JSON.stringify(settings));
  }
  if (!settings.user || !settings.repo) { showToast('配置错误', 'error'); return; }
  updateSyncStatus('syncing', '同步中...');
  var btn = document.getElementById('syncBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 同步中...';

  try {
    // 同步前确保脚本中的 rawData 为最新
    persistData();
    var htmlContent = document.documentElement.outerHTML;
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var branch = settings.branch || 'main';
    var headers = {
      'Authorization': 'token ' + settings.token,
      'Accept': 'application/vnd.github.v3+json',
      'Content-Type': 'application/json'
    };

    // 诊断：先查 Token 是否具备仓库写权限（最常见「上传不了」的原因）
    try {
      var meResp = await fetch('https://api.github.com/user', { headers: { 'Authorization': 'token ' + settings.token, 'Accept': 'application/vnd.github.v3+json' } });
      var meScopes = meResp.headers.get('X-OAuth-Scopes') || '';
      if (meResp.ok && !/(^|,\s*)(repo|public_repo)(,|$)/.test(meScopes)) {
        showToast('⚠️ Token 缺少仓库写权限（当前: ' + (meScopes || '无') + '），上传会失败。请到 GitHub 重新生成带 repo 权限的 Token', 'error');
      } else if (!meResp.ok) {
        showToast('⚠️ Token 无效或已过期（' + meResp.status + '），请重新点「🔄 同步到 GitHub」输入', 'error');
      }
    } catch (e) {}

    // 文件超过 1MB 时 Contents API（PUT /contents）会被 GitHub 拒绝，
    // 故改用 Git Data API（blob + tree + commit），支持最大 100MB，可稳定同步大文件。
    var base64Content = btoa(unescape(encodeURIComponent(htmlContent)));

    // 1) 创建 blob
    var blobResp = await fetch(base + '/git/blobs', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ content: base64Content, encoding: 'base64' })
    });
    if (!blobResp.ok) {
      var be = await blobResp.json().catch(function(){return {};});
      throw new Error('创建 blob 失败(' + blobResp.status + '): ' + (be.message || ''));
    }
    var blob = await blobResp.json();

    // 2) 获取分支最新 commit
    var refResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), { headers: headers });
    if (!refResp.ok) { var re = await refResp.json().catch(function(){return{};}); throw new Error('获取分支失败(' + refResp.status + '): ' + (re.message || '请确认分支名是否为 ' + branch)); }
    var refData = await refResp.json();
    var latestCommitSha = refData.object.sha;

    // 3) 获取该 commit 的 tree
    var commitResp = await fetch(base + '/git/commits/' + latestCommitSha, { headers: headers });
    if (!commitResp.ok) throw new Error('获取 commit 失败');
    var commitData = await commitResp.json();
    var baseTreeSha = commitData.tree.sha;

    // 4) 用新 blob 创建新 tree（替换/新增目标文件）
    var treeResp = await fetch(base + '/git/trees', {
      method: 'POST', headers: headers,
      body: JSON.stringify({
        base_tree: baseTreeSha,
        tree: [ { path: settings.filePath, mode: '100644', type: 'blob', sha: blob.sha } ]
      })
    });
    if (!treeResp.ok) { var te = await treeResp.json().catch(function(){return{};}); throw new Error('创建 tree 失败(' + treeResp.status + '): ' + (te.message || '')); }
    var newTree = await treeResp.json();

    // 5) 创建 commit
    var newCommitResp = await fetch(base + '/git/commits', {
      method: 'POST', headers: headers,
      body: JSON.stringify({ message: settings.commitMsg, tree: newTree.sha, parents: [latestCommitSha] })
    });
    if (!newCommitResp.ok) throw new Error('创建 commit 失败(' + newCommitResp.status + ')');
    var newCommit = await newCommitResp.json();

    // 6) 更新分支引用
    var updateRefResp = await fetch(base + '/git/refs/heads/' + encodeURIComponent(branch), {
      method: 'PATCH', headers: headers,
      body: JSON.stringify({ sha: newCommit.sha, force: false })
    });
    if (!updateRefResp.ok) throw new Error('更新分支引用失败(' + updateRefResp.status + ')');

    clearDirty();
    updateSyncStatus('idle', '已同步');
    showToast('✅ 同步成功！', 'success');
  } catch (e) {
    updateSyncStatus('error', '同步失败');
    showToast('❌ 同步失败: ' + e.message, 'error');
  }
  btn.disabled = false;
  btn.textContent = '🔄 同步到 GitHub';
}

// 编辑后自动（防抖）同步
var _syncTimer = null;
function scheduleSync() {
  // 已改为「手动同步」：编辑/新增/删除仅写入本地缓存（persistData 中的 localStorage），
  // 不再自动上传 GitHub。需要跨设备同步时，由用户手动点击「🔄 同步到 GitHub」按钮触发。
}

// ==================== 从 GitHub 下载（两步 Git Data API，无 1MB 限制，CORS 兼容 file://） ====================
// auto=true 时为打开文件时自动调用：404（仓库中尚无文件）静默跳过，不弹错误
async function downloadFromGitHub(auto) {
  var settings = getGitHubSettings();
  if (!settings.user || !settings.repo) { if (!auto) showToast('配置错误', 'error'); return; }
  if (!auto) {
    updateSyncStatus('syncing', '下载中...');
    var btn = document.getElementById('downloadBtn');
    btn.disabled = true;
    btn.textContent = '⏳ 下载中...';
  }
  try {
    var base = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo);
    var headers = { 'Accept': 'application/vnd.github.v3+json' };
    if (settings.token) headers['Authorization'] = 'token ' + settings.token;

    // 第一步：GET /contents 拿 blob SHA（大文件 ≥1MB 时 content 为空，但 SHA 照常返回）
    // 关键修复：下载必须与上传使用同一分支。上传使用 settings.branch || 'main'，
    // 此处也必须带 ?ref= 读取同一分支，否则会读到仓库「默认分支」(可能是 master)，
    // 导致上传到 main、下载读默认分支，两台电脑从不同分支取数而对不齐。
    var branch = settings.branch || 'main';
    var contentsUrl = base + '/contents/' + encodeURIComponent(settings.filePath) + '?ref=' + encodeURIComponent(branch);
    var resp1 = await fetch(contentsUrl, { headers: headers });
    if (!resp1.ok && resp1.status === 404) {
      // 兼容：若该分支无此文件，回退读取仓库默认分支
      var resp1b = await fetch(base + '/contents/' + encodeURIComponent(settings.filePath), { headers: headers });
      if (resp1b.ok) resp1 = resp1b;
    }
    if (!resp1.ok) {
      if (auto && resp1.status === 404) return;
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: HTTP ' + resp1.status, 'error'); }
      return;
    }
    var fileInfo = await resp1.json();
    if (!fileInfo.sha) throw new Error('未获取到文件 SHA');

    // 第二步：GET /git/blobs/{sha} 拿完整内容（支持任意大小，有 CORS 头）
    var resp2 = await fetch(base + '/git/blobs/' + fileInfo.sha, { headers: headers });
    if (!resp2.ok) throw new Error('获取文件内容失败 HTTP ' + resp2.status);
    var blobData = await resp2.json();
    if (!blobData.content) throw new Error('blob 内容为空');
    // GitHub 返回的 base64 可能有换行，需清理
    var htmlStr = decodeURIComponent(escape(atob(blobData.content.replace(/\s/g, ''))));
    if (!htmlStr || htmlStr.length < 100) throw new Error('解码后内容为空或过小');
    // 提取仓库文件中的 rawData
    var m = htmlStr.match(/<script id="xmData">([\s\S]*?)<\/script>/);
    if (!m) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 文件中未找到数据', 'error'); }
      return;
    }
    var newData = new Function(m[1] + '\n; return rawData;')();
    if (!Array.isArray(newData)) throw new Error('数据格式错误');
    // 先解析 GitHub 上的订单明细
    var newOrder = orderData;
    var mo = htmlStr.match(/<script id="orderData">([\s\S]*?)<\/script>/);
    if (mo) {
      try {
        var od = new Function(mo[1] + '\n; return orderData;')();
        if (Array.isArray(od)) newOrder = od;
      } catch (e) {}
    }
    // 打开时自动拉取：以 GitHub 为准，覆盖本机缓存，保证跨设备一致。
    // 唯一例外——本机有未同步改动(dirty)且与 GitHub 不同时，保护本地不覆盖，提示用户先同步。
    var _changed = JSON.stringify(newData) !== JSON.stringify(rawData) || JSON.stringify(newOrder) !== JSON.stringify(orderData);
    if (auto && isDirty() && _changed) {
      // 注意：此处并未与 GitHub 同步，而是保留了本机缓存，故状态绝不能显示“已同步”
      updateSyncStatus('warn', '⚠️ 本地有未同步改动');
      showToast('⚠️ 本机有未同步改动，未自动覆盖（当前显示的是本机缓存）。请先点「🔄 同步到 GitHub」上传，或手动点「📥 从 GitHub 下载」放弃本机改动', 'info');
      return;
    }
    rawData = newData;
    orderData = newOrder;
    _orderModelCache = null; // 订单数据已更新，失效规格型号/单价缓存，保证成交价匹配最新
    renumberOrders();
    // 价格明细由 rawData 中已定型行自动生成，无需单独提取
    syncOrderFromPrice();
    render();
    renderPrice();
    renderOrder();
    // 从 GitHub 下载后写回本地缓存，并清除改动标记（此刻本机与 GitHub 一致）
    persistData();
    clearDirty();
    updateSyncStatus('idle', '已同步');
    if (!auto) showToast('✅ 已从 GitHub 下载 方案 ' + rawData.length + ' 条 / 订单 ' + orderData.length + ' 条', 'success');
    else if (_changed) showToast('🔄 打开时已自动载入 GitHub 最新数据', 'info');
  } catch (e) {
    if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + e.message, 'error'); }
  }
  if (!auto) {
    btn.disabled = false;
    btn.textContent = '📥 从 GitHub 下载';
  }
}

// ==================== Toast ====================
function showToast(msg, type) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + (type || 'info') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(function () { toast.classList.remove('show'); }, 3000);
}

// ==================== 初始化 ====================
loadGitHubSettings();
// 即时渲染：先用本机缓存快速显示（离线也能先看到内容），随后自动从 GitHub 拉取最新覆盖
// 【一次性合并保护】2026-07-27 已将手机端(data.json通道)与电脑端数据合并为505条写入本文件。
// 首次打开时忽略旧缓存、以文件内嵌合并数据为准，并置"未同步"标记，防止被 GitHub 旧版覆盖，直到用户点「🔄 同步」推上去。
var MERGE_VER = 'merge-20260727-505';
var _mergeApplied = false;
(function () {
  try {
    if (localStorage.getItem('xm_merge_ver') !== MERGE_VER) {
      localStorage.setItem('xm_merge_ver', MERGE_VER);
      _mergeApplied = true;
      persistData(); // 内嵌合并数据写入缓存，并置 dirty 保护
      return;
    }
    var lr = localStorage.getItem(LS_KEY_RAW);
    var lo = localStorage.getItem(LS_KEY_ORDER);
    if (lr) { var d = JSON.parse(lr); if (Array.isArray(d) && d.length > 0) rawData = d; }
    if (lo) { var o = JSON.parse(lo); if (Array.isArray(o) && o.length > 0) orderData = o; }
    _orderModelCache = null; // 订单数据从缓存载入后失效缓存，保证成交价匹配最新
  } catch (e) {}
})();
syncOrderFromPrice();
initAllFilterBars();
render();
renderPrice();
renderOrder();
// 窗口尺寸变化时重新对齐筛选栏（仅对可见视图生效）
window.addEventListener('resize', function () {
  layoutFilterBar('dataTable');
  layoutFilterBar('priceTable');
  layoutFilterBar('orderTable');
});
// 点击遮罩关闭弹窗：仅当 mousedown 也在遮罩上（即真正点击遮罩关闭）才触发，
// 避免「在输入框内选词、鼠标拖到遮罩外松开」这类文本选择拖动误关弹窗。
function bindBackdropClose(modalId, closeFn) {
  var modal = document.getElementById(modalId);
  var downOnBackdrop = false;
  modal.addEventListener('mousedown', function (e) {
    downOnBackdrop = (e.target === modal);
  });
  modal.addEventListener('click', function (e) {
    if (downOnBackdrop && e.target === modal) closeFn();
  });
}
bindBackdropClose('changeModal', closeChangeModal);
bindBackdropClose('editModal', closeEditModal);
// Esc 关闭编辑方案弹窗
document.getElementById('editModal').addEventListener('keydown', function (e) {
  if (e.key === 'Escape') closeEditModal();
});
// 打开文件时自动从 GitHub 拉取最新数据（以 GitHub 为准，覆盖本机缓存），保证跨设备一致。
// 例外：本机有未同步改动时会自动保护并提示先同步；离线或仓库无文件(404)时静默保留本机缓存。
if (_mergeApplied) {
  // 合并数据首次生效：不自动拉取（GitHub 上还是旧版），提示用户先同步推送合并结果
  updateSyncStatus('warn', '合并数据待上传');
  showToast('✅ 已载入合并后的 505 条数据（含手机端最新记录），请点「🔄 同步到 GitHub」推送，之后手机端重新下载即可一致', 'info');
} else {
  downloadFromGitHub(true);
}
</script>


