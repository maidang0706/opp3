];

// 筛选栏与表格列对齐：每表按表头列顺序生成等宽单元格，对应列的单元格放入筛选输入框，
// 输入框宽度 = 该列宽，从而【位置】与【列宽】都和对应表格列保持一致。
var FILTER_INPUTS = {
  // 订单明细筛选已改为与其它页面一致的顶部工具栏内联（.filter-inline），不再按列对齐
};

function initFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  if (!bar || bar.dataset.built) return;
  var table = document.getElementById(tableId);
  if (!table) return;
  var ths = table.querySelectorAll('thead th');
  var map = FILTER_INPUTS[tableId] || {};
  // 先取出已有输入框与按钮（避免清空后丢失节点）；支持「一列多个输入框」堆叠
  var inputs = {};
  Object.keys(map).forEach(function (k) {
    var ids = map[k];
    if (!Array.isArray(ids)) ids = [ids];
    inputs[k] = ids.map(function (id) { return document.getElementById(id); }).filter(Boolean);
  });
  var btns = [];
  var bNodes = bar.querySelectorAll('button');
  for (var b = 0; b < bNodes.length; b++) btns.push(bNodes[b]);
  bar.innerHTML = '';
  for (var i = 0; i < ths.length; i++) {
    var key = (ths[i].textContent || '').trim();
    var cell = document.createElement('div');
    cell.className = 'fcell';
    var cols = inputs[key];
    if (cols && cols.length) {
      if (cols.length === 1) {
        cell.appendChild(cols[0]);
      } else {
        var stack = document.createElement('div');
        stack.className = 'fcell-stack';
        for (var s = 0; s < cols.length; s++) stack.appendChild(cols[s]);
        cell.appendChild(stack);
      }
    }
    bar.appendChild(cell);
  }
  var actions = document.createElement('div');
  actions.className = 'fbar-actions';
  for (var j = 0; j < btns.length; j++) actions.appendChild(btns[j]);
  bar.appendChild(actions);
  bar.dataset.built = '1';
}

// 按表头列宽同步每个筛选单元格宽度（隐藏视图跳过，待显示时再布局）
function layoutFilterBar(tableId) {
  var bar = document.getElementById('fbar-' + tableId);
  var table = document.getElementById(tableId);
  if (!bar || !table || !bar.dataset.built) return;
  if (table.offsetParent === null) return; // 视图隐藏时跳过
  var ths = table.querySelectorAll('thead th');
  var cells = bar.children;
  for (var i = 0; i < ths.length && i < cells.length; i++) {
    if (!cells[i].classList || !cells[i].classList.contains('fcell')) continue;
    var w = ths[i].offsetWidth;
    if (w) cells[i].style.width = w + 'px';
  }
}

// 方案明细：顶部工具栏内联筛选框宽度跟随对应列列宽（客户 / 项目号 / 项目名称 / 模组下单型号）
// 「项目号/项目名称」在表格中是合并列，这里拆成两个输入框，均分该列宽度，并随该列宽变化同步变化
