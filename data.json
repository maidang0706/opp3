//   - 操作列（价格明细表头单独添加，不在 PRICE_DISPLAY 内）不纳入
// 其余列（序列/客户/项目号·名称/工程师/型号/电机/驱动/光电/导轨/读头/动力线/编码器线/图纸/刹车/其他）原样展示。
var ELEC_DISPLAY = PRICE_DISPLAY.filter(function (d) {
