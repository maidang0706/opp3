// 电气配置筛选：按「客户 / 项目号 / 项目名称 / 工程师 / 模组下单型号」五列过滤（对应数据键）
function getElecFiltered() {
  var f = {};
  var map = { '客户': 'ef_客户', '项目号': 'ef_项目号', '项目名称': 'ef_项目名称', '工程师': 'ef_工程师', '型号': 'ef_型号' };
  Object.keys(map).forEach(function (k) {
    var el = document.getElementById(map[k]);
    if (el && el.value.trim()) f[k] = el.value.trim().toLowerCase();
  });
  var list = getPriceList();
  if (Object.keys(f).length === 0) return list;
  return list.filter(function (row) {
    return Object.keys(f).every(function (k) {
      return (row[k] || '').toString().toLowerCase().indexOf(f[k]) !== -1;
    });
  });
}
// 电气配置：展示「价格明细」全部定型行（列已剔除价格/报价类字段），原列之后、4 个可编辑列之前为「编辑」列，
// 末尾 4 列（驱动器功率/配套电源线/配套编码器线/配套刹车电阻）可通过「编辑」按钮行内编辑。
function renderElec() {
  if (!elecTableBody) return;
  elecTableBody.innerHTML = '';
  var _elecFrag = document.createDocumentFragment();
  var list = getElecFiltered();
  if (list.length === 0) {
    var tr0 = document.createElement('tr');
    tr0.innerHTML = '<td colspan="' + ELEC_DISPLAY.length + '" style="padding:14px;color:#999;">暂无定型方案，请在「XM方案明细」中将方案勾选为「定型」</td>';
    elecTableBody.appendChild(tr0);
    return;
  }
  var _prevSerial = null, _grpIdx = -1;
  list.forEach(function (item) {
    var tr = document.createElement('tr');
    // 按「连续不同序列号分组」交替浅黄背景：筛选后相邻的不同序列号也一定异色（不再依赖序列号奇偶）
    var _serial = String(item['序列']);
    if (_serial !== _prevSerial) { _grpIdx++; _prevSerial = _serial; }
    if (_grpIdx % 2 === 1) tr.className = 'row-even';
    var isEditing = (elecEditingIdx === item.__idx);
    if (isEditing) tr.setAttribute('data-edit', '1');

    ELEC_DISPLAY.forEach(function (d) {
      // 编辑列（位于原列之后、4 个可编辑列之前）：编辑 / 保存·取消
      if (d.type === 'elec-op') {
        var opTd = document.createElement('td');
        opTd.className = 'col-op';
        if (isEditing) {
          var opActions = document.createElement('div');
          opActions.className = 'op-actions';
          var saveBtn = document.createElement('button');
          saveBtn.className = 'btn btn-primary btn-xs';
          saveBtn.textContent = '保存';
          saveBtn.onclick = function () { saveElecRowEdit(item.__idx); };
          var cancelBtn = document.createElement('button');
          cancelBtn.className = 'btn btn-outline btn-xs';
          cancelBtn.textContent = '取消';
          cancelBtn.onclick = function () { elecEditingIdx = null; renderElec(); };
          opActions.appendChild(saveBtn);
          opActions.appendChild(cancelBtn);
          opTd.appendChild(opActions);
        } else {
          var editBtn = document.createElement('button');
          editBtn.className = 'btn btn-outline btn-xs';
          editBtn.textContent = '编辑';
          editBtn.onclick = function () { elecEditingIdx = item.__idx; renderElec(); };
          opTd.appendChild(editBtn);
        }
        tr.appendChild(opTd);
        return;
      }
      var td = document.createElement('td');
      if (d.cls) td.className = d.cls;
      // 驱动器电压等级：仅编辑态下显示可下拉选择（220V / 380V）；非编辑态仅展示、不可选择、无外框
      if (d.type === 'elec-select') {
        var selCur = (item[d.key] === undefined || item[d.key] === null) ? '' : item[d.key];
        if (isEditing) {
          var sel = document.createElement('select');
          sel.className = 'elec-sel';
          sel.setAttribute('data-es', d.key);
          var _opts = d.options || ['', '220V', '380V'];
          _opts.forEach(function (o) {
            var op = document.createElement('option');
            op.value = o;
            op.textContent = (o === '') ? '（未选）' : o;
            if (selCur === o) op.selected = true;
            sel.appendChild(op);
          });
          sel.onchange = (function (ri, k) {
            return function () {
              var _s = rawData[ri];
              if (_s) { _s[k] = sel.value; persistData(); scheduleSync(); }
            };
          })(item.__idx, d.key);
          td.classList.add('edit-cell');
          td.appendChild(sel);
        } else {
          // 非编辑态：仅展示文本，无外框、不可修改
          td.className = (td.className ? td.className + ' ' : '') + 'elec-sel-display';
          td.textContent = (selCur === '' || selCur === null || selCur === undefined) ? '' : selCur;
        }
        tr.appendChild(td);
        return;
      }
      // 4 个可编辑新增列：编辑态渲染输入框（无外框、字体与展示一致），否则只读展示
      if (d.elecEdit) {
        var cur = item[d.key];
        if (isEditing) {
          var inp = document.createElement('input');
          inp.className = 'elec-cell-input';
          inp.setAttribute('data-ef', d.key);
          inp.value = (cur === '' || cur === null || cur === undefined) ? '' : cur;
          td.appendChild(inp);
          td.classList.add('edit-cell');
        } else {
          td.textContent = (cur === '' || cur === null || cur === undefined) ? '' : cur;
        }
        tr.appendChild(td);
        return;
      }
      var val = xmDisplayValue(item, d);
      // 序列列：点击弹出「电气配置文本」弹窗（可一键复制）
      if (d.key === '序列') {
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
        td.style.cursor = 'pointer';
        td.title = '点击查看/复制方案文本';
        td.onclick = (function (ri) { return function () { openElecTextModal(ri); }; })(item.__idx);
        tr.appendChild(td);
        return;
      }
      if (d.type === 'combo') {
        var _pv1 = item[d.keys[0]] || '';
        var _pv2 = item[d.keys[1]] || '';
        td.innerHTML = escapeHtml(_pv1) + '<br>' + escapeHtml(_pv2);
      } else if (d.type === 'cfg') {
        td.className = (td.className ? td.className + ' ' : '') + 'col-config';
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      } else {
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      }
      tr.appendChild(td);
    });
    _elecFrag.appendChild(tr);
  });
  elecTableBody.appendChild(_elecFrag);
}
