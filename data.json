    <button class="btn btn-success" id="downloadBtn" onclick="downloadFromGitHub()">📥 从 GitHub 下载</button>
    <button class="btn btn-primary" id="syncBtn" onclick="syncToGitHub()" disabled="">⏳ 同步中...</button>
    <button class="btn" id="tokenBtn" onclick="toggleTokenView()">🔑 显示 Token</button>
