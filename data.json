  rawData[rowIdx][col] = val;
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  persistData();
  scheduleSync();
}

// 价格视图不再单独维护数据：所有操作都作用于 XM 源数据（deleteRow/toggleFinalize 已复用）

// ==================== 订单明细视图（由上传的订单明细.xlsx 生成，独立维护数据） ====================
var orderColumns = ["订单类型", "订单状态", "内部订单号（必填）", "客户订单号", "订单日期", "客户查找关联", "规格型号", "订单数量", "单位", "单价", "金额", "订单负责人", "项目名称", "配置"];
var orderEditingIdx = null;
var orderTableBody = document.getElementById('orderTableBody');
var orderTable = document.getElementById('orderTable');
// 订单明细：列宽比例调整。每次渲染都基于“当前自然宽 × 比例”计算，不依赖跨渲染状态，确定可靠。
var orderFilterCols = [
  { id: 'of_customer', col: '客户查找关联' },
  { id: 'of_model', col: '规格型号' },
  { id: 'of_owner', col: '订单负责人' }
];

// 连续编号：序列 = 行序（从 1 开始，顶部为 1）
function renumberOrders() {
  for (var i = 0; i < orderData.length; i++) orderData[i]['序列'] = i + 1;
}

function getOrderFiltered() {
  var f = {};
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el && el.value.trim()) f[o.col] = el.value.trim().toLowerCase();
  });
  return orderData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(function (row) {
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  });
}

function renderOrder() {
  orderTableBody.innerHTML = '';
  var list = getOrderFiltered();
  // 按订单日期倒序排列（最新日期在最上方）
  list.sort(function (a, b) {
    return orderDateValue(b['订单日期']) - orderDateValue(a['订单日期']);
  });
  if (list.length === 0) {
    var tr = document.createElement('tr');
    tr.innerHTML = '<td colspan="' + (orderColumns.length + 2) + '" style="padding:14px;color:#999;">暂无数据</td>';
    orderTableBody.appendChild(tr);
    return;
  }
  list.forEach(function (item, idx) {
    var tr = document.createElement('tr');
    if (item['定型']) tr.className = 'finalized-row';
    // 序列列（按订单日期倒序后的展示序号）
    var tdSeq = document.createElement('td');
    tdSeq.className = 'seq-cell col-half w30';
    tdSeq.textContent = idx + 1;
    tdSeq.style.fontWeight = '600';
    tdSeq.setAttribute('data-col', '序列');
    tdSeq.style.cursor = 'pointer';
    tdSeq.onclick = (function (cell) { return function () { highlightOrderCell(cell); }; })(tdSeq);
    tr.appendChild(tdSeq);
    // 数据列（整表只读，点击仅高亮当前行/列）
    orderColumns.forEach(function (col) {
      var td = document.createElement('td');
      td.setAttribute('data-col', col);
      if (col === '内部订单号（必填）' || col === '客户订单号') td.className = 'col-fixed';
      else if (col === '订单日期') td.className = 'col-date';
      else if (col === '订单类型') td.className = 'col-half w40';
      else if (col === '订单状态') td.className = 'col-half w40';
      else if (col === '订单数量') td.className = 'col-half w40';
      else if (col === '单位') td.className = 'col-half w30';
      else if (col === '单价') td.className = 'col-half w40';
      else if (col === '金额') td.className = 'col-half w50';
      else if (col === '订单负责人') td.className = 'col-half w40';
      else if (col === '客户查找关联') td.className = 'col-cust';
      else if (col === '规格型号') td.className = 'col-cust';
      var val = item[col];
      if (col === '订单日期') val = formatOrderDate(val);
      td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      td.style.cursor = 'pointer';
      td.onclick = (function (cell) { return function () { highlightOrderCell(cell); }; })(td);
      tr.appendChild(td);
    });
    orderTableBody.appendChild(tr);
  });
  // 按列宽比例调整指定列：每次都量取该列的真实自然宽度，再 × 比例固定列宽（不依赖跨渲染状态，确定可靠）
  (function () {
    var ratios = {
      '订单状态': 2 / 3,
      '订单日期': 2 / 3,
      '客户查找关联': 3 / 4,
      '规格型号': 3 / 4,
      '订单负责人': 2 / 3
    };
    var entries = [];
    Object.keys(ratios).forEach(function (col) {
      var th = document.querySelector('#orderTable th[data-col="' + col + '"]');
      var cells = orderTableBody.querySelectorAll('td[data-col="' + col + '"]');
      if (!th || !cells.length) return;
      // 暂时清除固定宽，量出自然宽
      th.style.width = th.style.minWidth = th.style.maxWidth = '';
      cells.forEach(function (c) { c.style.width = c.style.minWidth = c.style.maxWidth = ''; });
      var natural = th.offsetWidth;
      cells.forEach(function (c) { var w = c.offsetWidth; if (w > natural) natural = w; });
      var target = Math.max(18, Math.round(natural * ratios[col]));
      entries.push({ th: th, cells: cells, target: target });
    });
    entries.forEach(function (e) {
      e.th.style.width = e.th.style.minWidth = e.th.style.maxWidth = e.target + 'px';
      e.cells.forEach(function (c) { c.style.width = c.style.minWidth = c.style.maxWidth = e.target + 'px'; });
    });
  })();
  autoFitColumnText();
}

function highlightOrderCell(td) {
  // 清除上一次高亮（整表所有 .hl）
  var prev = orderTable.querySelectorAll('td.hl, th.hl');
  Array.prototype.forEach.call(prev, function (c) { c.classList.remove('hl'); });
  var tr = td.parentElement;
  var idx = td.cellIndex;
  // 高亮整行
  Array.prototype.forEach.call(tr.querySelectorAll('td'), function (c) { c.classList.add('hl'); });
  // 高亮整列（含表头，按列索引定位）
  Array.prototype.forEach.call(orderTable.querySelectorAll('tr'), function (row) {
    var cell = row.cells[idx];
    if (cell) cell.classList.add('hl');
  });
}
function startOrderEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  var rawVal = (orderData[rowIdx][col] === undefined || orderData[rowIdx][col] === null) ? '' : orderData[rowIdx][col];
  input.value = (col === '订单日期') ? formatOrderDate(rawVal) : rawVal;
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishOrderEdit(input.value, rowIdx, col); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { renderOrder(); }
  };
}
function finishOrderEdit(val, rowIdx, col) {
  if (orderData[rowIdx][col] !== val) {
    orderData[rowIdx][col] = val;
    persistData();
    renderOrder();
    scheduleSync();
  }
}
function commitOrderEdit(input, rowIdx, col) {
  orderData[rowIdx][col] = input.value;
  persistData();
  scheduleSync();
}
function editOrderRow(rowIdx) { orderEditingIdx = rowIdx; renderOrder(); }
function addOrderRow() {
  // 清空当前筛选条件，确保新增的空白行一定可见（否则空行会被筛选隐藏，造成「点了没反应」）
  orderFilterCols.forEach(function (o) {
    var el = document.getElementById(o.id);
    if (el) el.value = '';
  });
  var row = { 序列: 0, 定型: false };
  orderColumns.forEach(function (c) { row[c] = ''; });
  orderData.unshift(row);
  renumberOrders();
  persistData();
  renderOrder();
  scheduleSync();
}
function toggleOrderFinalize(rowIdx) {
  orderData[rowIdx]['定型'] = !orderData[rowIdx]['定型'];
  persistData();
  renderOrder();
  scheduleSync();
}
function deleteOrderRow(idx) {
  if (!confirm('确定删除这条订单记录吗？')) return;
  orderData.splice(idx, 1);
  renumberOrders();
  persistData();
  renderOrder();
  scheduleSync();
}

// 视图切换：三个界面共用同一标题栏（方案明细 / 价格明细 / 订单明细）
function showView(name) {
  currentView = name;
  document.getElementById('xmView').style.display = (name === 'xm') ? '' : 'none';
  document.getElementById('priceView').style.display = (name === 'price') ? '' : 'none';
  document.getElementById('orderView').style.display = (name === 'order') ? '' : 'none';
  document.getElementById('navXm').classList.toggle('active', name === 'xm');
  document.getElementById('navPrice').classList.toggle('active', name === 'price');
  document.getElementById('navOrder').classList.toggle('active', name === 'order');
  if (name === 'xm') render();
  else if (name === 'price') renderPrice();
  else renderOrder();
}

// ==================== 增删 ====================
// 序列 = 方案编号（同一方案的多条变更共享同一编号；新增取最大号+1，删除方案后由 renumberSchemes 重新连续编号）
function addRow() {
  var now = new Date().toLocaleString('zh-CN');
  var maxSeq = 0;
  rawData.forEach(function (r) { var n = parseFloat(r['序列']); if (!isNaN(n) && n > maxSeq) maxSeq = n; });
  rawData.unshift({
    序列: maxSeq + 1,
    建档日期: now,
    客户: '', 项目号: '', 项目名称: '', 工程师: '',
    变更时间: now, 工况: '', 型号: '', 配置: '', 其他: '',
    定型: false
  });
  persistData();
  applyFilters();
  scheduleSync();
}

function deleteRow(idx) {
  if (!confirm('确定删除这条记录吗？')) return;
  rawData.splice(idx, 1);
  renumberSchemes(); // 删除方案后，剩余方案重新连续编号
  persistData();
  applyFilters();
  scheduleSync();
}

// ==================== 新增变更（点击序列列弹出） ====================
var chPlanSeq = null; // 当前操作的方案编号

function openChangeDialog(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  chPlanSeq = row['序列'];
  document.getElementById('chPlanId').textContent = row['序列'];
  document.getElementById('chSeq').textContent = row['序列'] || '';
  document.getElementById('chDate').textContent = row['建档日期'] || '';
  document.getElementById('chCustomer').textContent = row['客户'] || '';
  document.getElementById('chProjNo').textContent = row['项目号'] || '';
  document.getElementById('chProjName').textContent = row['项目名称'] || '';
  document.getElementById('chEngineer').textContent = row['工程师'] || '';
  document.getElementById('chChangeTime').value = new Date().toLocaleString('zh-CN');
  document.getElementById('chCond').value = '';
  document.getElementById('chModel').value = '';
  document.getElementById('chConfig').value = '';
  document.getElementById('chOther').value = '';
  document.getElementById('changeModal').classList.add('show');
  setTimeout(function () { document.getElementById('chCond').focus(); }, 50);
}

function closeChangeModal() {
  document.getElementById('changeModal').classList.remove('show');
  chPlanSeq = null;
}

function submitChange() {
  if (chPlanSeq === null && chPlanSeq !== 0) { showToast('无效方案', 'error'); return; }
  var pid = chPlanSeq;
  // 从现有方案第一条读取固定字段（建档日期/客户/项目号/项目名称/工程师）
  var src = rawData.find(function (r) { return String(r['序列']) === String(pid); });
  if (!src) { showToast('未找到该方案', 'error'); return; }
  var now = new Date().toLocaleString('zh-CN');
  var newRow = {
    序列: pid,
    建档日期: src['建档日期'],
    客户: src['客户'], 项目号: src['项目号'], 项目名称: src['项目名称'], 工程师: src['工程师'],
    变更时间: now,
    工况: document.getElementById('chCond').value.trim(),
    型号: document.getElementById('chModel').value.trim(),
    配置: document.getElementById('chConfig').value.trim(),
    其他: document.getElementById('chOther').value.trim(),
    定型: false
  };
  // 插入到该方案在表格中的最上方
  var topIdx = rawData.findIndex(function (r) { return String(r['序列']) === String(pid); });
  if (topIdx === -1) topIdx = 0;
  rawData.splice(topIdx, 0, newRow);
  closeChangeModal();
  persistData();
  applyFilters();
  scheduleSync();
  showToast('✅ 已为方案 #' + pid + ' 新增变更', 'success');
}

// ==================== 数据持久化（同步前更新脚本内容） ====================
// 价格明细由 XM 数据自动生成，无需单独存储
function persistData() {
  document.getElementById('xmData').textContent = 'var rawData = ' + JSON.stringify(rawData) + ';';
  var od = document.getElementById('orderData');
  if (od) od.textContent = 'var orderData = ' + JSON.stringify(orderData) + ';';
}

// ==================== GitHub 配置 ====================
// 默认仓库/文件路径取自 XM方案明细（项目资产）。Token 仅通过头部输入框填入，不写入文件内容。
var DEFAULT_GH = {
  user: 'maidang0706',
  repo: 'OPP3',
  token: '',
  filePath: 'XM方案明细.html',
  commitMsg: 'Update XM方案明细'
};

function loadGitHubSettings() {
  try {
    var saved = localStorage.getItem('xm_github_settings');
    if (!saved) {
      saved = JSON.stringify(DEFAULT_GH);
      localStorage.setItem('xm_github_settings', saved);
    }
    updateSyncStatus('idle', '已配置');
  } catch (e) {}
}

// 获取配置：user/repo/filePath 固定，token 从 localStorage 读取，未设置则弹窗输入
function getGitHubSettings() {
  var saved = localStorage.getItem('xm_github_settings');
  var s = saved ? JSON.parse(saved) : JSON.parse(JSON.stringify(DEFAULT_GH));
  return s;
}

// ==================== GitHub同步 ====================
function updateSyncStatus(status, text) {
  var dot = document.querySelector('#syncStatus .sync-dot');
  var txt = document.getElementById('syncText');
  var el = document.getElementById('syncStatus');
  el.className = 'sync-status ' + status;
  txt.textContent = text || (status === 'idle' ? '已配置' : status === 'syncing' ? '同步中...' : '同步失败');
}

async function syncToGitHub() {
  var settings = getGitHubSettings();
  if (!settings.token) {
    var t = prompt('请输入 GitHub Token：');
    if (!t) return;
    settings.token = t.trim();
    localStorage.setItem('xm_github_settings', JSON.stringify(settings));
  }
  if (!settings.user || !settings.repo) { showToast('配置错误', 'error'); return; }
  updateSyncStatus('syncing', '同步中...');
  var btn = document.getElementById('syncBtn');
  btn.disabled = true;
  btn.textContent = '⏳ 同步中...';

  try {
    // 同步前确保脚本中的 rawData 为最新
    persistData();
    var htmlContent = document.documentElement.outerHTML;
    // 先获取文件 SHA（若已存在）
    var sha = null;
    var url = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo) + '/contents/' + encodeURIComponent(settings.filePath);
    var headers = {
      'Authorization': 'token ' + settings.token,
      'Accept': 'application/vnd.github.v3+json'
    };
    try {
      var getResp = await fetch(url, { headers: headers });
      if (getResp.ok) {
        var getData = await getResp.json();
        sha = getData.sha;
      }
    } catch (e) {}

    var base64Content = btoa(unescape(encodeURIComponent(htmlContent)));
    var body = {
      message: settings.commitMsg,
      content: base64Content,
      branch: 'main'
    };
    if (sha) body.sha = sha;

    var putResp = await fetch(url, {
      method: 'PUT',
      headers: headers,
      body: JSON.stringify(body)
    });

    if (putResp.ok) {
      var result = await putResp.json();
      updateSyncStatus('idle', '已同步');
      showToast('✅ 同步成功！' + (result.content.html_url || ''), 'success');
    } else {
      var errData = await putResp.json();
      updateSyncStatus('error', '同步失败');
      showToast('❌ 同步失败: ' + (errData.message || '未知错误'), 'error');
    }
  } catch (e) {
    updateSyncStatus('error', '同步失败');
    showToast('❌ 网络错误: ' + e.message, 'error');
  }
  btn.disabled = false;
  btn.textContent = '🔄 同步到 GitHub';
}

// 编辑后自动（防抖）同步
var _syncTimer = null;
function scheduleSync() {
  clearTimeout(_syncTimer);
  var s = getGitHubSettings();
  if (!s.token) return;
  _syncTimer = setTimeout(function () { syncToGitHub(); }, 1500);
}

// ==================== 从 GitHub 下载（公开仓库无需 Token） ====================
// auto=true 时为打开文件时自动调用：404（仓库中尚无文件）静默跳过，不弹错误
async function downloadFromGitHub(auto) {
  var settings = getGitHubSettings();
  if (!settings.user || !settings.repo) { if (!auto) showToast('配置错误', 'error'); return; }
  if (!auto) {
    updateSyncStatus('syncing', '下载中...');
    var btn = document.getElementById('downloadBtn');
    btn.disabled = true;
    btn.textContent = '⏳ 下载中...';
  }
  try {
    var url = 'https://api.github.com/repos/' + encodeURIComponent(settings.user) + '/' + encodeURIComponent(settings.repo) + '/contents/' + encodeURIComponent(settings.filePath);
    // 有 Token 则带上（提高限额），没有也能下载公开仓库
    var headers = { 'Accept': 'application/vnd.github.v3+json' };
    if (settings.token) headers['Authorization'] = 'token ' + settings.token;
    var resp = await fetch(url, { headers: headers });
    if (!resp.ok) {
      if (auto && resp.status === 404) return; // 尚未上传，静默跳过
      var err = await resp.json().catch(function(){return {};});
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + (err.message || '未知错误'), 'error'); }
      return;
    }
    var data = await resp.json();
    var htmlStr = decodeURIComponent(escape(atob(data.content.replace(/\s/g, ''))));
    // 提取仓库文件中的 rawData
    var m = htmlStr.match(/<script id="xmData">([\s\S]*?)<\/script>/);
    if (!m) {
      if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 文件中未找到数据', 'error'); }
      return;
    }
    var newData = new Function(m[1] + '\n; return rawData;')();
    if (!Array.isArray(newData)) throw new Error('数据格式错误');
    rawData = newData;
    // 提取订单明细数据
    var mo = htmlStr.match(/<script id="orderData">([\s\S]*?)<\/script>/);
    if (mo) {
      try {
        var od = new Function(mo[1] + '\n; return orderData;')();
        if (Array.isArray(od)) orderData = od;
      } catch (e) {}
    }
    renumberOrders();
    // 价格明细由 rawData 中已定型行自动生成，无需单独提取
    render();
    renderPrice();
    renderOrder();
    updateSyncStatus('idle', '已同步');
    if (!auto) showToast('✅ 已从 GitHub 下载 方案 ' + rawData.length + ' 条 / 订单 ' + orderData.length + ' 条', 'success');
  } catch (e) {
    if (!auto) { updateSyncStatus('error', '下载失败'); showToast('❌ 下载失败: ' + e.message, 'error'); }
  }
  if (!auto) {
    btn.disabled = false;
    btn.textContent = '📥 从 GitHub 下载';
  }
}

// ==================== Toast ====================
function showToast(msg, type) {
  var toast = document.getElementById('toast');
  toast.textContent = msg;
  toast.className = 'toast ' + (type || 'info') + ' show';
  clearTimeout(toast._timeout);
  toast._timeout = setTimeout(function () { toast.classList.remove('show'); }, 3000);
}

// ==================== 初始化 ====================
loadGitHubSettings();
render();
// 点击遮罩关闭变更弹窗
document.getElementById('changeModal').addEventListener('click', function (e) {
  if (e.target === this) closeChangeModal();
});
