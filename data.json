    else if (f.key === '型号') cls += ' em-wide';
    else cls += ' em-small';
    html += '<div class="' + cls + '">';
    html += '<label>' + f.key + (f.locked ? '（只读）' : (f.multiline ? '（多行）' : '')) + '</label>';
    if (f.multiline) {
      html += '<textarea id="' + f.id + '" rows="' + (f.rows || 5) + '" placeholder="输入' + f.key + '"></textarea>';
    } else {
      html += '<input type="text" id="' + f.id + '" placeholder="输入' + f.key + '"' + (f.locked ? ' readonly' : '') + '>';
    }
    html += '</div>';
  });
  box.innerHTML = html;
  box.dataset.built = '1';
  // 明细字段（与新建行/新建变更一致：模组总长/总行程/工况及变更/模组下单型号…一项一项）
  buildXmDetailFields(document.getElementById('emDetail'), 'emd', {});
