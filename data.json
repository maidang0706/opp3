<script>
// ==================== 列定义 ====================
var allColumns = ["序列", "建档日期", "客户", "项目号", "项目名称", "工程师", "变更时间", "工况", "型号", "配置"];
// 同一方案的固定列（同一序列号的多条变更合并显示）；工程师不合并——每条变更独立显示/编辑
var MERGE_COLS = ["序列", "建档日期", "客户", "项目号", "项目名称"];
// 整理视图中按「序列号相同」合并显示的列（含工程师，与原表新增变更一致）
var XM_MERGE = ["序列", "建档日期", "客户", "项目号/项目名称", "工程师"];
// 判断某显示列是否属于「按方案(序列号)合并行」的列（序列/建档日期/客户/项目号/项目名称），用于跨行合并单元格
function isMergeCol(d) {
  if (!d || d.type === 'op' || d.type === 'rownum') return false;
  if (d.type === 'combo') return d.keys.some(function (k) { return MERGE_COLS.indexOf(k) !== -1; });
  return MERGE_COLS.indexOf(d.key) !== -1;
}

// ==================== 方案明细「整理视图」列定义（按 Excel 模板 24 列） ====================
// type: op(操作列) / native(直接读 rawData[key]) / map(读 rawData[key] 但显示名不同) /
//       cfg(从「配置」字段解析) / rownum(行号) / const(无数据源，留空)
// edit=true 表示整行编辑模式下该列可编辑，cfg 列编辑写回 rawData['配置']，其余写回 rawData[key]
var XM_DISPLAY = [
  { t: '操作', type: 'op' },
  { t: '序列', type: 'native', key: '序列', edit: true, cls: 'c-nowrap' },
  { t: '建档日期', type: 'native', key: '建档日期', edit: true, cls: 'c-nowrap' },
  { t: '客户', type: 'native', key: '客户', edit: true },
  { t: '项目号/项目名称', type: 'combo', key: '项目号/项目名称', keys: ['项目号', '项目名称'] },
  { t: '工程师', type: 'native', key: '工程师', edit: true },
  { t: '变更时间', type: 'native', key: '变更时间', edit: true, cls: 'c-nowrap' },
  { t: '工况及变更', type: 'map', key: '工况', edit: true },
  { t: '模组下单型号', type: 'map', key: '型号', edit: true },
  { t: '电机型号', type: 'cfg', cfg: '电机', edit: true },
  { t: '动子个数', type: 'cfg', cfg: '动子个数', edit: true },
  { t: '驱动器型号', type: 'cfg', cfg: '驱动器型号', edit: true },
  { t: '光电&个数', type: 'cfg', cfg: '光电开关', edit: true },
  { t: '导轨', type: 'cfg', cfg: '导轨品牌', edit: true },
  { t: '读头', type: 'cfg', cfg: '读头', edit: true },
  { t: '动力线', type: 'cfg', cfg: '动力线', edit: true },
  { t: '编码器线', type: 'cfg', cfg: '编码器线', edit: true },
  { t: '图纸来源', type: 'cfg', cfg: '图纸来源', edit: true },
  { t: '刹车电阻', type: 'cfg', cfg: '刹车电阻', edit: true },
  { t: '其他', type: 'cfg', cfg: '其他备注', edit: true }
];

// 取某显示列的值
function xmDisplayValue(row, d) {
  if (d.type === 'native' || d.type === 'map') return row[d.key];
  if (d.type === 'cfg') { var o = cfgParseCached(row['配置']); return o[d.cfg] || ''; }
  return '';
}

// 动态生成方案明细表头（与表体 XM_DISPLAY 始终一致；合并列「项目号/项目名称」、配置列等自动同步）
function buildXmHead() {
  var thead = document.getElementById('xmHead');
  if (!thead) return;
  thead.innerHTML = '';
  var tr = document.createElement('tr');
  XM_DISPLAY.forEach(function (d) {
    var th = document.createElement('th');
    th.textContent = d.t;
    if (d.type === 'cfg') th.className = 'col-config';
    else if (d.cls) th.className = d.cls;
    tr.appendChild(th);
  });
  thead.appendChild(tr);
}

// 整行编辑模式：原生/映射列提交（写回 rawData[key]，合并列同步同方案）
function commitXmEdit(input, rowIdx, nativeKey) {
  var val = input.value;
  rawData[rowIdx][nativeKey] = val;
  if (MERGE_COLS.indexOf(nativeKey) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[nativeKey] = val; });
  }
  persistData();
}

// 整行编辑模式：配置解析列提交（写回 rawData['配置']，更新对应子项）
function commitXmCfg(input, rowIdx, cfgKey) {
  var obj = parseConfig(rawData[rowIdx]['配置']);
  obj[cfgKey] = input.value;
  rawData[rowIdx]['配置'] = serializeConfig(obj);
  persistData();
}

// ==================== 配置列模板 ====================
// 固定文字 + （）可填入；（）内文本蓝底
var CONFIG_FIELDS = ["电机", "动子个数", "驱动器型号", "光电开关", "导轨品牌", "读头", "动力线", "编码器线", "图纸来源", "刹车电阻", "其他备注"];

function escapeHtml(s) {
  s = String(s == null ? '' : s);
  if (s.indexOf('&') === -1 && s.indexOf('<') === -1 && s.indexOf('>') === -1) return s;
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

// 将存储的「配置」字符串解析为 { 字段: 值 }
function parseConfig(str) {
  var obj = {};
  CONFIG_FIELDS.forEach(function (f) {
    var re = new RegExp(f.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + '（([^）]*)）');
    var m = (str || '').match(re);
    obj[f] = m ? m[1] : '';
  });
  return obj;
}
// 【性能】配置解析缓存：同一份「配置」文本只解析一次。
// 方案明细有 11 个配置列，原实现每个配置列都调用一次 parseConfig（内部 11 次正则匹配），
// 563 行 × 11 列 ≈ 6.8 万次正则，是方案/价格/电气三表渲染卡顿的主因；缓存后降至约 6 千次。
var _cfgParseCache = {};
var _cfgParseN = 0;
function cfgParseCached(str) {
  var key = (str == null ? '' : String(str));
  var hit = _cfgParseCache[key];
  if (hit) return hit;
  var obj = parseConfig(key);
  if (++_cfgParseN > 3000) { _cfgParseCache = {}; _cfgParseN = 0; } // 防止缓存无界增长
  _cfgParseCache[key] = obj;
  return obj;
}
// 将 { 字段: 值 } 序列化回模板字符串
function serializeConfig(obj) {
  return CONFIG_FIELDS.map(function (f) { return f + '（' + (obj[f] || '') + '）'; }).join('，');
}

// 非编辑态展示：固定文字 + 蓝底（）内容（旧版自由文本原样显示，避免丢失）
function configDisplay(val) {
  if (val && !CONFIG_FIELDS.some(function (f) { return String(val).indexOf(f) !== -1; })) {
    return escapeHtml(val);
  }
  var obj = parseConfig(val || '');
  return CONFIG_FIELDS.map(function (f) {
    return f + '（<span class="cfg-fill">' + escapeHtml(obj[f] || '') + '</span>）';
  }).join('，');
}

// 方案明细「配置」列显示规则（新）：仅当（）或()内有内容时，其内部文字加浅蓝底；其余原样显示
// 同时支持全角（）与半角()，内容含特殊字符已先 escapeHtml，避免注入
function configDisplayXm(val) {
  var s = (val === undefined || val === null) ? '' : String(val);
  if (!s) return '';
  s = escapeHtml(s);
  s = s.replace(/（([^（）]+)）|\(([^()]+)\)/g, function (m, full, half) {
    if (full !== undefined) {
      return '（<span class="cfg-fill">' + full + '</span>）';
    }
    return '(<span class="cfg-fill">' + half + '</span>)';
  });
  return s;
}

// 编辑态：每个（）渲染为蓝底输入框，失焦即保存对应字段
function buildConfigEditor(td, rowIdx, isPrice) {
  td.className = '';
  td.style.padding = '4px 6px';
  td.style.textAlign = 'left';
  td.style.verticalAlign = 'top';
  var current = parseConfig(rawData[rowIdx]['配置']);
  CONFIG_FIELDS.forEach(function (f) {
    var wrap = document.createElement('div');
    wrap.style.margin = '2px 0';
    var label = document.createElement('span');
    label.textContent = f;
    var open = document.createTextNode('（');
    var input = document.createElement('input');
    input.value = current[f] || '';
    input.className = 'cfg-input';
    input.setAttribute('placeholder', '填写');
    var close = document.createTextNode('）');
    wrap.appendChild(label); wrap.appendChild(open); wrap.appendChild(input); wrap.appendChild(close);
    input.onblur = (function (ri, field, inp) {
      return function () {
        var o = parseConfig(rawData[ri]['配置']);
        o[field] = inp.value;
        rawData[ri]['配置'] = serializeConfig(o);
        persistData();
        scheduleSync();
      };
    })(rowIdx, f, input);
    input.onkeydown = function (e) {
      if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
      else if (e.key === 'Escape') { if (isPrice) { priceEditingIdx = null; renderPrice(); } else { editingIdx = null; render(); } }
    };
    td.appendChild(wrap);
  });
}

// 重新连续编号：同一方案（序列号相同）共享一个编号；自底向上编号，使最小的序列号在表格最下方，依次向上递增
function renumberSchemes() {
  var counter = 0;
  var currentSeq = null;
  for (var i = rawData.length - 1; i >= 0; i--) {
    var r = rawData[i];
    if (String(r['序列']) !== String(currentSeq)) {
      counter++;
      currentSeq = r['序列'];
    }
    r['序列'] = counter;
  }
}

// ==================== 渲染 ====================
var tableBody = document.getElementById('tableBody');

// 自动缩放「建档日期 / 变更时间」列的文字大小，使其在不换行的前提下适配固定列宽
// 仅适配选定表（或可见表）中需要字号自适应的列；按列缓存样式，消除逐单元格 getComputedStyle 重排风暴
var _AUTOFIT_SEL = 'th.col-time,td.col-time,th.col-date,td.col-date,th.col-date-sm,td.col-date-sm,th.col-fixed,td.col-fixed,th.col-half,td.col-half,th.col-cust,td.col-cust,th.col-headfit,th.col-combo-date,td.col-combo-date';

function autoFitColumnText(scope) {
  var tables;
  if (scope) {
    tables = [scope];
  } else {
    // 未指定时仅处理可见表，跳过被隐藏视图（避免对另一张表的数万单元格做无谓计算）
    tables = [document.getElementById('priceTable'), document.getElementById('orderTable'), document.getElementById('tableBody')];
    tables = tables.filter(function (t) { return t && t.offsetParent !== null; });
  }
  for (var t = 0; t < tables.length; t++) autoFitTable(tables[t]);
}

function autoFitTable(table) {
  var cells = table.querySelectorAll(_AUTOFIT_SEL);
  if (!cells || !cells.length) return;
  // 写阶段①：统一重置字号（仅触发一次布局）
  for (var i = 0; i < cells.length; i++) {
    var c = cells[i];
    if (c.querySelector('input')) continue; // 编辑态（输入框）跳过
    c.style.whiteSpace = 'nowrap';
    c.style.fontSize = '';
  }
  // 按列缓存 padding / 可用宽 / 基准字号：每列仅 1 次 getComputedStyle（原来每单元格 1 次）
  var colInfo = {};
  function colInfoOf(cell) {
    var idx = cell.cellIndex;
    if (colInfo[idx]) return colInfo[idx];
    var cs = getComputedStyle(cell);
    var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
    var avail = cell.clientWidth - pad;
    var base = parseFloat(cs.fontSize) || 13;
    var info = { avail: avail, base: base };
    colInfo[idx] = info;
    return info;
  }
  // 读阶段：仅逐单元格读 scrollWidth（无穿插写，整表仅一次重排）
  var targets = [];
  for (var j = 0; j < cells.length; j++) {
    var cell = cells[j];
    if (cell.querySelector('input')) continue;
    var info = colInfoOf(cell);
    if (info.avail <= 0) continue; // 隐藏列跳过
    var textW = cell.scrollWidth;
    if (textW > info.avail + 0.5) {
      var size = Math.max(6, info.base * (info.avail / textW));
      targets.push([cell, size.toFixed(1) + 'px']);
    }
  }
  // 写阶段②：回写目标字号（再触发一次布局）
  for (var k = 0; k < targets.length; k++) targets[k][0].style.fontSize = targets[k][1];
}

// 将字体自适应推迟到下一帧绘制之后：让表格内容先呈现，再微调字号，点击进入视图不再卡顿
function scheduleAutoFit(scope) {
  requestAnimationFrame(function () {
    autoFitColumnText(scope);
  });
}

// 方案明细：将「配置」列列宽设为当前渲染宽度的 1/2（存为 --cfgcolw）；「工况」列宽由 CSS 设为 calc(--cfgcolw/2)，即工况=配置/2。
// 仅首帧测量一次（--cfgcolw 未设置时列保持自适应，即可测到「当前宽度」），之后固定，避免每次渲染被不断减半。
var xmCfgHalfW = null;
function fitXmConfigColWidth() {
  var tbl = document.getElementById('dataTable');
  if (!tbl) return;
  if (xmCfgHalfW === null) {
    var cfgTh = tbl.querySelector('thead th.col-config');
    if (!cfgTh) return;
    var natural = cfgTh.offsetWidth;
    if (!natural) return; // 视图不可见（offsetWidth=0）时跳过，待可见时再测
    xmCfgHalfW = Math.max(60, Math.round(natural / 2));
  }
  tbl.style.setProperty('--cfgcolw', xmCfgHalfW + 'px');
}

// 价格明细：「何健价格备注」列显示标题重命名为「价格备注」后，
// 锁定列宽为「重命名前」的自然宽度，使更长的标题通过 autoFit 缩字适配（满足「列宽不变」）。
// 仅价格视图可见时测量一次；之后每次 renderPrice 重新把锁定宽度应用到表头与该列所有单元格。
var priceRenameColW = null; // { 新标题: { w: 像素宽, idx: 列索引 } }
function measurePriceRenameColWidths() {
  var tbl = document.getElementById('priceTable');
  if (!tbl || tbl.offsetParent === null) return; // 仅价格视图可见时测量
  var revert = { '价格备注': '何健价格备注' };
  var oldNew = { '何健价格备注': '价格备注' };
  var ths = tbl.querySelectorAll('thead th');
  var targets = [];
  ths.forEach(function (th) {
    var t = th.textContent.trim();
    if (revert[t]) targets.push({ th: th, old: revert[t] });
  });
  if (!targets.length) return;
  targets.forEach(function (m) { m.th.textContent = m.old; }); // 临时改回旧标题
  var map = {};
  targets.forEach(function (m) {
    var idx = m.th.cellIndex;
    var w = m.th.offsetWidth; // 同步布局，读到旧标题下的自然列宽
    map[m.old] = { w: w, idx: idx };
  });
  targets.forEach(function (m) { m.th.textContent = oldNew[m.old]; }); // 还原新标题
  priceRenameColW = {};
  Object.keys(map).forEach(function (old) { priceRenameColW[oldNew[old]] = map[old]; });
}
function applyPriceRenameColWidths() {
  if (!priceRenameColW) measurePriceRenameColWidths();
  if (!priceRenameColW) return;
  var tbl = document.getElementById('priceTable');
  if (!tbl) return;
  Object.keys(priceRenameColW).forEach(function (title) {
    var info = priceRenameColW[title];
    var th = tbl.querySelector('thead th:nth-child(' + (info.idx + 1) + ')');
    if (th) { th.style.width = info.w + 'px'; th.style.minWidth = info.w + 'px'; th.style.maxWidth = info.w + 'px'; }
    var rows = tbl.querySelectorAll('tbody tr');
    rows.forEach(function (r) {
      var c = r.cells[info.idx];
      if (c) { c.style.width = info.w + 'px'; c.style.minWidth = info.w + 'px'; c.style.maxWidth = info.w + 'px'; }
    });
  });
}

// 单单元格自适应（供局部更新后调用，避免整表重排）
function fitSingleCell(cell) {
  if (!cell || cell.querySelector('input')) return;
  cell.style.whiteSpace = 'nowrap';
  cell.style.fontSize = '';
  var cs = getComputedStyle(cell);
  var pad = parseFloat(cs.paddingLeft) + parseFloat(cs.paddingRight);
  var avail = cell.clientWidth - pad;
  if (avail <= 0) return;
  var textW = cell.scrollWidth;
  if (textW > avail + 0.5) {
    var base = parseFloat(cs.fontSize) || 13;
    var size = Math.max(6, base * (avail / textW));
    cell.style.fontSize = size.toFixed(1) + 'px';
  }
}

// 订单日期统一显示为 YY/MM/DD（如 26/01/01）
function formatOrderDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})-(\d{2})-(\d{2})/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 价格明细表建档日期统一显示为 YY/MM/DD（如 26/01/01）
function formatPriceDate(v) {
  if (v === '' || v === null || v === undefined) return '';
  var s = String(v).trim();
  if (/^\d{2}\/\d{2}\/\d{2}$/.test(s)) return s;
  var m = s.match(/^(\d{4})[\/-](\d{2})[\/-](\d{2})$/);
  if (m) return m[1].slice(2) + '/' + m[2] + '/' + m[3];
  var d = new Date(s);
  if (!isNaN(d.getTime())) {
    var yy = String(d.getFullYear()).slice(2);
    var mm = String(d.getMonth() + 1); if (mm.length < 2) mm = '0' + mm;
    var dd = String(d.getDate()); if (dd.length < 2) dd = '0' + dd;
    return yy + '/' + mm + '/' + dd;
  }
  return s;
}

// 将订单日期统一解析为可比较的时间戳（兼容 26/01/01 与 2026-01-01）
var _orderDateMemo = {}; // 日期字符串 -> 时间戳（排序时避免对同一日期反复 Date.parse）
function orderDateValue(v) {
  if (v === '' || v === null || v === undefined) return 0;
  var raw = String(v).trim();
  var hit = _orderDateMemo[raw];
  if (hit !== undefined) return hit;
  var s = raw;
  var m = s.match(/^(\d{2})\/(\d{2})\/(\d{2})$/);
  if (m) s = '20' + m[1] + '-' + m[2] + '-' + m[3];
  var t = Date.parse(s);
  t = isNaN(t) ? 0 : t;
  _orderDateMemo[raw] = t;
  return t;
}

// ==================== 方案明细：Excel 式可拖拽列宽 ====================
// 各列默认像素宽度（与 Excel 模板列宽比例一致；拖动后可自由调整并实时生效）
var XM_DEF_W = {
  '操作': 66, '序列': 34, '建档日期': 72, '客户': 48, '项目号/项目名称': 130, '工程师': 48,
  '变更时间': 110, '工况及变更': 80, '模组下单型号': 106, '电机型号': 54,
  '动子个数': 34, '驱动器型号': 66, '光电&个数': 54, '导轨': 34, '读头': 34, '动力线': 48,
  '编码器线': 48, '图纸来源': 48, '刹车电阻': 48, '其他': 66
};
var xmColW = [];
var xmColGroup = null;
var xmResizerInited = false;
var XM_COLW_KEY = 'xmPlanColWidths';

// 从 localStorage 读取已保存的列宽（列数一致才生效，否则回退默认）
function loadXmColW(n) {
  try {
    var raw = localStorage.getItem(XM_COLW_KEY);
    if (!raw) return null;
    var arr = JSON.parse(raw);
    if (Array.isArray(arr) && arr.length === n) return arr;
  } catch (e) {}
  return null;
}
// 保存当前列宽到 localStorage（关闭文件再打开后自动恢复）
function saveXmColW() {
  try { localStorage.setItem(XM_COLW_KEY, JSON.stringify(xmColW)); } catch (e) {}
}
// 清除已保存列宽，下次打开恢复默认
function resetXmColW() {
  try { localStorage.removeItem(XM_COLW_KEY); } catch (e) {}
}
// 应用一组列宽（来自 localStorage 或 GitHub），并写回 colgroup / localStorage
function applyXmColWidths(arr) {
  if (!Array.isArray(arr) || !arr.length) return false;
  if (!xmColGroup || xmColGroup.children.length !== arr.length) return false;
  xmColW = arr.slice();
  for (var i = 0; i < xmColW.length; i++) {
    if (xmColGroup.children[i]) xmColGroup.children[i].style.width = xmColW[i] + 'px';
  }
  var tbl = document.getElementById('dataTable');
  if (tbl) tbl.style.width = xmColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  saveXmColW();
  return true;
}

function initXmColResizer() {
  if (xmResizerInited) return;
  var tbl = document.getElementById('dataTable');
  if (!tbl) return;
  var ths = tbl.querySelectorAll('thead th');
  if (!ths.length) return;
  var savedW = loadXmColW(ths.length);
  xmColGroup = document.createElement('colgroup');
  xmColGroup.id = 'xmColGroup';
  xmColW = [];
  var thList = [];
  ths.forEach(function (th, i) {
    thList.push(th);
    var title = (th.textContent || '').trim();
    var w = (savedW && savedW[i] != null) ? savedW[i] : (XM_DEF_W[title] || 50);
    xmColW.push(w);
    var col = document.createElement('col');
    col.style.width = w + 'px';
    xmColGroup.appendChild(col);
    var r = document.createElement('span');
    r.className = 'col-resizer';
    th.appendChild(r);
  });
  tbl.insertBefore(xmColGroup, tbl.firstChild);
  tbl.style.width = xmColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  tbl.querySelector('thead').addEventListener('mousedown', function (e) {
    var rEl = e.target.closest ? e.target.closest('.col-resizer') : null;
    if (!rEl) return;
    e.preventDefault();
    var th = rEl.parentNode;
    var idx = 0;
    for (var k = 0; k < thList.length; k++) { if (thList[k] === th) { idx = k; break; } }
    var startX = e.clientX;
    var startW = xmColW[idx];
    rEl.classList.add('active');
    function onMove(ev) {
      var nw = Math.max(36, startW + (ev.clientX - startX));
      xmColW[idx] = nw;
      xmColGroup.children[idx].style.width = nw + 'px';
      tbl.style.width = xmColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
      layoutXmFilterWidths(); // 拖拽时同步筛选框宽度
    }
    function onUp() {
      rEl.classList.remove('active');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.body.classList.remove('col-resizing');
      saveXmColW();
      persistData(); // 同步写入文件内 <script id="xmColW">，确保「同步到 GitHub」时方案表明细列宽一并上传
      layoutXmFilterWidths(); // 释放拖拽后再次同步筛选框宽度
    }
    document.body.classList.add('col-resizing');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });
  xmResizerInited = true;
}

// ==================== 订单明细列宽调整（可拖拽 + 双层持久化：localStorage / 文件内嵌 / GitHub） ====================
var orderColGroup = null;
var orderColW = [];
var orderResizerInited = false;
var ORDER_COLW_KEY = 'xm_order_colw_v1';

// 订单明细各列默认宽度（px）。数据来自「订单2026.xlsx」导入，列较多，给合理初值，用户可拖动微调
var ORDER_DEF_W = {
  '序列': 42, '订单类型': 72, '订单状态': 72, '内部订单号': 140, '订单日期': 92,
  '客户查找关联': 220, '规格型号': 160, '数量': 52, '单位': 42, '单价': 72,
  '金额': 82, '负责人': 72, '价格申请日期': 92, '项目名称': 130, '配置': 320
};

// 读取已保存列宽：① 本机 localStorage（同设备即时）② 文件内嵌 ORDER_SAVED_W（来自 GitHub）
function loadOrderColW(n) {
  try {
    var raw = localStorage.getItem(ORDER_COLW_KEY);
    if (raw) { var a = JSON.parse(raw); if (Array.isArray(a) && a.length === n) return a; }
  } catch (e) {}
  try {
    if (typeof ORDER_SAVED_W !== 'undefined' && Array.isArray(ORDER_SAVED_W) && ORDER_SAVED_W.length === n) return ORDER_SAVED_W;
  } catch (e) {}
  return null;
}
function saveOrderColW() {
  try { localStorage.setItem(ORDER_COLW_KEY, JSON.stringify(orderColW)); } catch (e) {}
}
// 应用一组列宽（来自 localStorage 或 GitHub），写回 colgroup / localStorage
function applyOrderColWidths(arr) {
  if (!Array.isArray(arr) || !arr.length) return false;
  if (!orderColGroup || orderColGroup.children.length !== arr.length) return false;
  orderColW = arr.slice();
  for (var i = 0; i < orderColW.length; i++) {
    if (orderColGroup.children[i]) orderColGroup.children[i].style.width = orderColW[i] + 'px';
  }
  var tbl = document.getElementById('orderTable');
  if (tbl) tbl.style.width = orderColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  saveOrderColW();
  return true;
}
function initOrderColResizer() {
  if (orderResizerInited) return;
  var tbl = document.getElementById('orderTable');
  if (!tbl) return;
  var ths = tbl.querySelectorAll('thead th');
  if (!ths.length) return;
  var savedW = loadOrderColW(ths.length);
  orderColGroup = document.createElement('colgroup');
  orderColGroup.id = 'orderColGroup';
  orderColW = [];
  var thList = [];
  ths.forEach(function (th, i) {
    thList.push(th);
    var title = (th.getAttribute('data-col') || th.textContent || '').trim();
    var w = (savedW && savedW[i] != null) ? savedW[i] : (ORDER_DEF_W[title] || 80);
    orderColW.push(w);
    var col = document.createElement('col');
    col.style.width = w + 'px';
    orderColGroup.appendChild(col);
    var r = document.createElement('span');
    r.className = 'col-resizer';
    th.appendChild(r);
  });
  tbl.insertBefore(orderColGroup, tbl.firstChild);
  tbl.style.width = orderColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  tbl.querySelector('thead').addEventListener('mousedown', function (e) {
    var rEl = e.target.closest ? e.target.closest('.col-resizer') : null;
    if (!rEl) return;
    e.preventDefault();
    var th = rEl.parentNode;
    var idx = 0;
    for (var k = 0; k < thList.length; k++) { if (thList[k] === th) { idx = k; break; } }
    var startX = e.clientX;
    var startW = orderColW[idx];
    rEl.classList.add('active');
    function onMove(ev) {
      var nw = Math.max(36, startW + (ev.clientX - startX));
      orderColW[idx] = nw;
      orderColGroup.children[idx].style.width = nw + 'px';
      tbl.style.width = orderColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
    }
    function onUp() {
      rEl.classList.remove('active');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.body.classList.remove('col-resizing');
      saveOrderColW();
      persistData(); // 同步写入文件内 <script id="orderColW">，确保「同步到 GitHub」时订单表明细列宽一并上传
    }
    document.body.classList.add('col-resizing');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });
  orderResizerInited = true;
}

function render() {
  tableBody.innerHTML = '';
  var _xmFrag = document.createDocumentFragment(); // 用片段一次性插入，避免逐行 appendChild 触发多次重排
  var list = getFiltered();
  if (list.length === 0) {
    var tr0 = document.createElement('tr');
    tr0.innerHTML = '<td colspan="' + XM_DISPLAY.length + '" style="padding:14px;color:#999;">暂无数据，点击「＋ 新增行」添加</td>';
    tableBody.appendChild(tr0);
    return;
  }
  // 计算每个方案块（序列连续相同）的起始行与跨度，用于合并单元格
  list.forEach(function (item, idx) {
    item._isStart = (idx === 0) || (String(item['序列']) !== String(list[idx - 1]['序列']));
    if (item._isStart) {
      var span = 1;
      while (idx + span < list.length && String(list[idx + span]['序列']) === String(item['序列'])) span++;
      item._span = span;
    }
  });
  var _grpParity = 0;
  list.forEach(function (item, rownum) {
    var tr = document.createElement('tr');
    // 按「连续不同序列号分组」交替浅黄背景：筛选后相邻的不同序列号也一定异色（不再依赖序列号奇偶）
    if (item._isStart) _grpParity ^= 1;
    if (_grpParity === 0) tr.className = 'row-even';
    if (rawData[item.__idx]['定型']) tr.className += ' finalized-row';
    var rowIdx = item.__idx;
    var isEditing = (editingIdx === rowIdx);
    XM_DISPLAY.forEach(function (d) {
      // 合并列（序列/建档日期/客户/项目号/项目名称）：同一方案(序列号)连续多行时，仅方案块首行渲染该单元格并跨行(rowspan)，续行跳过该列由首行占位
      var _isMergeCol = MERGE_COLS.indexOf(d.key) !== -1 || (d.type === 'combo' && d.keys && d.keys.some(function (k) { return MERGE_COLS.indexOf(k) !== -1; }));
      if (_isMergeCol && !item._isStart) return;
      var td = document.createElement('td');
      if (d.cls) td.className = d.cls;
      if (_isMergeCol && item._isStart && item._span > 1) td.rowSpan = item._span;
      if (d.type === 'op') {
        // 操作列：删除 / 编辑 / 定型（保留原表交互功能）
        td.className = 'op-cell';
        var del = document.createElement('button');
        del.className = 'op-btn del-btn';
        del.textContent = '删除';
        del.onclick = (function (ri) { return function () { deleteRow(ri); }; })(rowIdx);
        var editBtn = document.createElement('button');
        editBtn.className = 'op-btn edit-btn';
        editBtn.textContent = '编辑';
        editBtn.onclick = (function (ri) { return function () { openEditModal(ri); }; })(rowIdx);
        var finalized = !!rawData[rowIdx]['定型'];
        var finBtn = document.createElement('button');
        finBtn.className = 'op-btn finalize-btn' + (finalized ? ' finalized' : '');
        finBtn.textContent = finalized ? '☑定' : '☐定';
        finBtn.onclick = (function (ri) { return function () { toggleFinalize(ri); }; })(rowIdx);
        td.appendChild(del); td.appendChild(editBtn); td.appendChild(finBtn);
        tr.appendChild(td);
        return;
      }
      if (d.type === 'rownum') {
        td.textContent = rownum + 1;
        tr.appendChild(td);
        return;
      }
      if (d.type === 'const') {
        tr.appendChild(td);
        return;
      }
      var val = xmDisplayValue(item, d);
      if (isEditing && d.edit) {
        // 整行编辑模式：可编辑列渲染输入框（配置解析列写入 rawData['配置']，其余写回 rawData[key]）
        var input = document.createElement('input');
        input.className = 'cell-input';
        input.value = (val === undefined || val === null) ? '' : val;
        td.appendChild(input);
        if (d.type === 'cfg') {
          input.onblur = (function (ri, ck, inp) { return function () { commitXmCfg(inp, ri, ck); }; })(rowIdx, d.cfg, input);
        } else {
          input.onblur = (function (ri, nk, inp) { return function () { commitXmEdit(inp, ri, nk); }; })(rowIdx, d.key, input);
        }
        input.onkeydown = function (e) {
          if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
          else if (e.key === 'Escape') { editingIdx = null; render(); }
        };
      } else {
        if (d.type === 'combo') {
          var _v1 = item[d.keys[0]] || '';
          var _v2 = item[d.keys[1]] || '';
          td.innerHTML = escapeHtml(_v1) + '<br>' + escapeHtml(_v2);
        }
        else if (d.key === '建档日期') td.textContent = fmtYYMMDD(val);
        else if (d.key === '变更时间') {
          var _ct = fmtYYMMDDHHMM(val);
          if (_ct) {
            var _sp = _ct.indexOf(' ');
            td.innerHTML = escapeHtml(_ct.slice(0, _sp)) + '<br>' + escapeHtml(_ct.slice(_sp + 1));
          } else {
            td.textContent = '';
          }
        }
        else td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      }
      // 序列列：点击弹出「新增变更」对话框（每行独立，与价格明细表一致）
      if (d.key === '序列') {
        td.style.cursor = 'pointer';
        td.onclick = (function (ri) { return function () { openChangeDialog(ri); }; })(item.__idx);
      }
      tr.appendChild(td);
    });
    _xmFrag.appendChild(tr);
  });
  tableBody.appendChild(_xmFrag);
  layoutXmFilterWidths(); // 同步顶部工具栏内联筛选框宽度跟随列宽
}

// 记录方案明细表作为对齐基准的列宽（在方案明细视图可见时测量）
function measureXmRefColWidths() {
  var tbl = document.getElementById('dataTable');
  if (!tbl || tbl.offsetParent === null) return; // 视图不可见时跳过，待可见时再测
  var ths = tbl.querySelectorAll('thead th');
  for (var i = 0; i < ths.length; i++) {
    var t = (ths[i].textContent || '').trim();
    if (t === '建档日期') _xmDateColW = ths[i].offsetWidth;
    else if (t === '项目号/项目名称') _xmProjColW = ths[i].offsetWidth;
  }
  // 配置列（th.col-config）/ 工况列（th.col-cond）按 th 实际渲染宽记录（含 fitXmConfigColWidth 已应用的 --cfgcolw）
  var cfgTh = tbl.querySelector('thead th.col-config');
  var condTh = tbl.querySelector('thead th.col-cond');
  if (cfgTh) _xmConfigColW = cfgTh.offsetWidth;
  if (condTh) _xmCondColW = condTh.offsetWidth;
}

function getFiltered() {
  var f = {};
  allColumns.forEach(function (c) {
    var el = document.getElementById('f_' + c);
    if (el && el.value.trim()) f[c] = el.value.trim().toLowerCase();
  });
  // 其它筛选条件（剔除「型号」），用于「方案变更」展开行仍受客户/项目号/项目名称/工程师等约束
  var otherF = {};
  Object.keys(f).forEach(function (k) { if (k !== '型号') otherF[k] = f[k]; });

  function matchAll(row) {
    return Object.keys(f).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
    });
  }
  function matchOther(row) {
    return Object.keys(otherF).every(function (c) {
      return (row[c] || '').toString().toLowerCase().indexOf(otherF[c]) !== -1;
    });
  }
  // 某序列号是否包含「方案变更」（存在 变更时间 非空的变更记录行）
  function hasChangeOf(serial) {
    return rawData.some(function (r) {
      return String(r['序列']) === String(serial) && (r['变更时间'] || '').toString().trim() !== '';
    });
  }

  // 未启用「型号」筛选：保持原逐行过滤行为（按 rawData 顺序）
  if (!f['型号']) {
    return rawData.map(function (row, i) { return Object.assign({ __idx: i }, row); }).filter(matchAll);
  }

  // 按「模组下单型号」筛选时：按序列号分组输出（保证同一序列号行连续，合并单元格 rowspan 不脱节）。
  // 若被选中序列号（至少一行命中全部筛选）含「方案变更」，则展开显示该序列号下满足其它筛选条件的全部模组下单型号行。
  var groups = {};   // 序列号 -> { rows: [带 __idx 的行], order: 首次出现下标 }
  var order = [];
  rawData.forEach(function (row, i) {
    var s = String(row['序列']);
    if (!groups[s]) { groups[s] = { rows: [], order: i }; order.push(s); }
    groups[s].rows.push(Object.assign({ __idx: i }, row));
  });
  var result = [];
  order.forEach(function (s) {
    var g = groups[s];
    var matched = g.rows.filter(matchAll);     // 命中全部筛选（含型号）的行
    var changed = hasChangeOf(s);
    if (matched.length > 0 && changed) {
      // 展开：显示该序列号下满足其它筛选条件的全部行（无论型号是否匹配），保持连续
      g.rows.forEach(function (row) { if (matchOther(row)) result.push(row); });
    } else {
      matched.forEach(function (row) { result.push(row); });
    }
  });
  return result;
}

function applyFilters() {
  if (currentView === 'xm') render();
  else if (currentView === 'price') renderPrice();
  else if (currentView === 'elec') renderElec();
  else renderOrder();
}
// 清除当前视图筛选区内的所有输入并重新渲染，恢复该视图的全部行
function clearFilters(btn) {
  // 清空按钮所在视图内所有筛选输入框（顶部工具栏内联筛选框 + .filters 一并覆盖）
  var view = btn.closest('#xmView, #priceView, #orderView, #elecView');
  if (!view) view = btn.closest('.toolbar, .filters');
  if (view) {
    var ins = view.querySelectorAll('input');
    for (var i = 0; i < ins.length; i++) ins[i].value = '';
  }
  // 重置型号子筛选（订单明细存在此栏；价格明细无型号子筛选栏，无需处理）
  if (btn.closest('#orderView')) {
    if (typeof orderModelFilter !== 'undefined') orderModelFilter = null;
    if (typeof updateOrderModelFilterBar === 'function') updateOrderModelFilterBar();
  }
  applyFilters();
}

// 新增行 / 新增变更后清除方案明细的全部筛选条件，确保刚新增的行立即可见
// （否则若当前筛选项与新增行不匹配，数据已写入但会被过滤隐藏，表现为「新增行不显示」）
function clearXmFilters() {
  if (typeof allColumns === 'undefined') { applyFilters(); return; }
  allColumns.forEach(function (c) {
    var el = document.getElementById('f_' + c);
    if (el) el.value = '';
  });
  applyFilters();
}

// 新增行 / 新增变更后刷新方案明细：若新行在现行筛选下仍可见，则【保留】当前筛选
// （用户筛选上下文不丢失，且新行出现在筛选结果中）；仅当新行不满足当前筛选时才清除筛选，
// 确保新行一定可见。避免「有筛选时新增变更导致筛选被清空、原筛选数据丢失」的问题。
function refreshAfterAdd(newRowIdx) {
  var f = {};
  allColumns.forEach(function (c) {
    var el = document.getElementById('f_' + c);
    if (el && el.value.trim()) f[c] = el.value.trim().toLowerCase();
  });
  var match = Object.keys(f).every(function (c) {
    return (rawData[newRowIdx][c] || '').toString().toLowerCase().indexOf(f[c]) !== -1;
  });
  if (match) applyFilters();   // 新行已匹配现行筛选，保持筛选上下文
  else clearXmFilters();       // 新行被现行筛选挡住，只能清除筛选以显示新行
}

// ==================== 编辑 ====================
function startEdit(td, rowIdx, col) {
  if (td.querySelector('input')) return;
  var input = document.createElement('input');
  input.value = rawData[rowIdx][col] || '';
  td.innerHTML = '';
  td.appendChild(input);
  input.focus();
  input.onblur = function () { finishEdit(td, rowIdx, col, input.value); };
  input.onkeydown = function (e) {
    if (e.key === 'Enter') { e.preventDefault(); input.blur(); }
    else if (e.key === 'Escape') { render(); }
  };
}

function finishEdit(td, rowIdx, col, val) {
  if (rawData[rowIdx][col] !== val) {
    rawData[rowIdx][col] = val;
    // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
    if (MERGE_COLS.indexOf(col) !== -1) {
      var pid = String(rawData[rowIdx]['序列']);
      rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
    }
    persistData();
    applyFilters();
    scheduleSync();
  }
}

// ==================== 整行编辑（编辑按钮） ====================
var editingIdx = null; // 当前处于整行编辑模式的 rawData 下标

function editRow(rowIdx) {
  editingIdx = rowIdx;
  render();
}

// 编辑模式下提交单个单元格（仅保存数据，不重渲染，避免输入框失焦引发的按钮点击竞态；由「完成」统一退出编辑）
function commitEdit(input, rowIdx, col) {
  var val = input.value;
  rawData[rowIdx][col] = val;
  // 合并列编辑时，同步到同一方案（序列号相同）的所有变更行
  if (MERGE_COLS.indexOf(col) !== -1) {
    var pid = String(rawData[rowIdx]['序列']);
    rawData.forEach(function (r) { if (String(r['序列']) === pid) r[col] = val; });
  }
  // 仅本地保存；同步（订单回填 + GitHub）推迟到点击「完成」按钮时统一触发
  persistData();
}

// 定型勾选（按变更行独立）；切换后会自动刷新两侧视图（价格明细由定型行生成）
function toggleFinalize(rowIdx) {
  rawData[rowIdx]['定型'] = !rawData[rowIdx]['定型'];
  persistData();
  _priceRendered = false; _elecRendered = false; // 价格/电气由定型行派生，定型状态变化需重渲染
  applyFilters();
  scheduleSync();
}

// ==================== 价格明细视图（由 XM 中已「定型」的行自动生成，列与「方案明细」一致） ====================
// 列定义：完全复用「方案明细」的 XM_DISPLAY（去掉操作列），末尾追加价格相关列。
// 渲染、列宽拖拽、持久化均复用方案明细同款机制。
// 价格明细表不显示「建档日期」「变更时间」「工况及变更」三列（仅方案明细保留）
var PRICE_DISPLAY = XM_DISPLAY.filter(function (d) {
  return d.type !== 'op' && d.key !== '建档日期' && d.key !== '变更时间' && d.key !== '工况';
}).map(function (d) {
  var n = {}; for (var k in d) n[k] = d[k]; delete n.edit; return n;
}).concat([
  { t: '价格申请日期', type: 'native', key: '价格申请日期', priceEdit: true, dateFmt: true },
  // 成交价/成交价备注：上行为成交价（由订单明细按型号匹配自动填入，只读），下行为成交价备注（可编辑）
  { t: '成交价/成交价备注', type: 'combo-price', topKey: '成交价', bottomKey: '成交价备注', topReadOnly: true, bottomEdit: true },
  // 公司价格/公司价格备注：上行为公司价格，下行为公司价格备注，均可在价格表内编辑
  { t: '公司价格/公司价格备注', type: 'combo-price', topKey: '公司价格', bottomKey: '公司价格备注', topEdit: true, bottomEdit: true },
  // 报价/报价备注：上行为报价，下行为报价备注，均可在价格表内编辑
  { t: '报价/报价备注', type: 'combo-price', topKey: '报价', bottomKey: '报价备注', topEdit: true, bottomEdit: true }
]);
var priceEditingIdx = null;
var _cjDirty = false;
var priceTableBody = document.getElementById('priceTableBody');
var priceTable = document.getElementById('priceTable');

// 由 XM 数据筛选出已定型（定型 === true）的行，沿用方案明细真实序列号（与方案明细一一对应）
function getPriceList() {
  var fin = [];
  rawData.forEach(function (r, i) { if (r && r['定型']) fin.push({ row: r, idx: i }); });
  var counter = 0;
  for (var i = fin.length - 1; i >= 0; i--) { counter++; fin[i].newSeq = counter; }
  return fin.map(function (o) {
    var r = Object.assign({}, o.row);
    r['序列'] = o.newSeq;     // 价格视图内独立的自增序列号（与方案明细区分）
    r.__idx = o.idx;          // 指向 XM 源数据的下标，编辑会同步回源
    return r;
  });
}

// 价格表筛选（复用顶部工具栏内联筛选框 pf_ 输入框）
function getPriceFiltered() {
  var f = {};
  var map = { '客户': 'pf_客户', '项目号': 'pf_项目号', '项目名称': 'pf_项目名称', '工程师': 'pf_工程师', '型号': 'pf_型号' };
  PRICE_DISPLAY.forEach(function (d) {
    // 合并列（如「项目号/项目名称」）需拆成其真实数据键 keys 逐个匹配筛选框，否则组合键不会出现在 map 中而被整体跳过
    var keys = (d.type === 'combo' && d.keys) ? d.keys : (d.key ? [d.key] : []);
    keys.forEach(function (k) {
      if (!k || !map[k]) return;
      var el = document.getElementById(map[k]);
      if (el && el.value.trim()) f[k] = el.value.trim().toLowerCase();
    });
  });
  return getPriceList().filter(function (row) {
    return Object.keys(f).every(function (k) {
      return (row[k] || '').toString().toLowerCase().indexOf(f[k]) !== -1;
    });
  });
}

// 价格表表头（由 PRICE_DISPLAY 动态生成，保证列名与渲染一致）
function buildPriceHead() {
  var thead = document.getElementById('priceHead');
  if (!thead) return;
  thead.innerHTML = '';
  var tr = document.createElement('tr');
  var opTh = document.createElement('th');
  opTh.textContent = '操作';
  opTh.className = 'col-op';
  PRICE_DISPLAY.forEach(function (d) {
    if (d.key === '价格申请日期') tr.appendChild(opTh);
    var th = document.createElement('th');
    if (d.t.indexOf('/') !== -1) th.innerHTML = d.t.replace('/', '<br>');
    else th.textContent = d.t;
    if (d.type === 'cfg') th.className = 'col-config';
    tr.appendChild(th);
  });
  thead.appendChild(tr);
}

function renderPrice() {
  _cjDirty = false;
  priceTableBody.innerHTML = '';
  var _priceFrag = document.createDocumentFragment();
  var list = getPriceFiltered();
  if (list.length === 0) {
    var tr0 = document.createElement('tr');
    tr0.innerHTML = '<td colspan="' + (PRICE_DISPLAY.length + 1) + '" style="padding:14px;color:#999;">暂无定型方案，请在「XM方案明细」中将方案勾选为「定型」</td>';
    priceTableBody.appendChild(tr0);
    layoutPriceFilterWidths();
    return;
  }
  var _prevSerial = null, _grpIdx = -1;
  list.forEach(function (item) {
    var tr = document.createElement('tr');
    // 按「连续不同序列号分组」交替浅黄背景：筛选后相邻的不同序列号也一定异色（不再依赖序列号奇偶）
    var _serial = String(item['序列']);
    if (_serial !== _prevSerial) { _grpIdx++; _prevSerial = _serial; }
    if (_grpIdx % 2 === 1) tr.className = 'row-even';
    var isEditing = (priceEditingIdx === item.__idx);
    if (isEditing) tr.setAttribute('data-edit', '1');

    PRICE_DISPLAY.forEach(function (d) {
      // 操作列：插入在「价格申请日期」列之前（与表头顺序一致）
      if (d.key === '价格申请日期') {
        var opTd = document.createElement('td');
        opTd.className = 'col-op';
        if (isEditing) {
          var opActions = document.createElement('div');
          opActions.className = 'op-actions';
          var saveBtn = document.createElement('button');
          saveBtn.className = 'btn btn-primary btn-xs';
          saveBtn.textContent = '保存';
          saveBtn.onclick = function () { savePriceRowEdit(item.__idx); };
          var cancelBtn = document.createElement('button');
          cancelBtn.className = 'btn btn-outline btn-xs';
          cancelBtn.textContent = '取消';
          cancelBtn.onclick = function () { priceEditingIdx = null; renderPrice(); };
          opActions.appendChild(saveBtn);
          opActions.appendChild(cancelBtn);
          opTd.appendChild(opActions);
        } else {
          var editBtn = document.createElement('button');
          editBtn.className = 'btn btn-outline btn-xs';
          editBtn.textContent = '编辑';
          editBtn.onclick = function () { priceEditingIdx = item.__idx; renderPrice(); };
          opTd.appendChild(editBtn);
        }
        tr.appendChild(opTd);
      }
      var td = document.createElement('td');
      if (d.cls) td.className = d.cls;
      // 合并列（成交价/成交价备注、公司价格/公司价格备注、报价/报价备注）：上、下两行分别显示/编辑
      if (d.type === 'combo-price') {
        var _src = rawData[item.__idx];
        var topVal, botVal;
        if (d.topKey === '成交价') {
          // 成交价由订单明细按型号匹配单价自动填入（只读，不可编辑）
          topVal = lookupChengJiaPrice(item['型号'], item['价格申请日期']);
          if (_src && (_src['成交价'] || '') !== topVal) { _src['成交价'] = topVal; _cjDirty = true; }
        } else {
          topVal = _src ? (_src[d.topKey] || '') : '';
        }
        botVal = _src ? (_src[d.bottomKey] || '') : '';
        td.innerHTML = '';
        if (isEditing) {
          td.classList.add('edit-cell');
          // 编辑态：成交价仍只读展示（不可编辑），其余合并列上、下两行均渲染为输入框
          if (d.topKey === '成交价') {
            var topShow = document.createElement('div');
            topShow.className = 'cp-top';
            topShow.textContent = (topVal === '' || topVal === null || topVal === undefined) ? '' : topVal;
            if (topVal !== '') { topShow.style.fontWeight = '700'; topShow.style.color = '#0a7d3b'; }
            td.appendChild(topShow);
          } else {
            var tInp = document.createElement('input');
            tInp.className = 'cell-input';
            tInp.setAttribute('data-pf', d.topKey);
            tInp.value = (topVal === '' || topVal === null || topVal === undefined) ? '' : topVal;
            td.appendChild(tInp);
          }
          td.appendChild(document.createElement('br'));
          var bInp = document.createElement('input');
          bInp.className = 'cell-input';
          bInp.setAttribute('data-pf', d.bottomKey);
          bInp.value = (botVal === '' || botVal === null || botVal === undefined) ? '' : botVal;
          td.appendChild(bInp);
        } else {
          var topDiv = document.createElement('div');
          topDiv.className = 'cp-top';
          topDiv.textContent = (topVal === '' || topVal === null || topVal === undefined) ? '' : topVal;
          if (d.topKey === '成交价' && topVal !== '') { topDiv.style.fontWeight = '700'; topDiv.style.color = '#0a7d3b'; }
          var botDiv = document.createElement('div');
          botDiv.className = 'cp-bot';
          botDiv.textContent = (botVal === '' || botVal === null || botVal === undefined) ? '' : botVal;
          td.appendChild(topDiv);
          td.appendChild(botDiv);
        }
        tr.appendChild(td);
        return;
      }
      var val = xmDisplayValue(item, d);
      // 价格申请日期：编辑态渲染输入框，否则只读展示
      if (d.priceEdit) {
        if (isEditing) {
          var inp = document.createElement('input');
          inp.className = 'cell-input';
          inp.setAttribute('data-pf', d.key);
          var cur = item[d.key];
          inp.value = (cur === '' || cur === null || cur === undefined) ? '' : (d.dateFmt ? fmtYYMMDD(cur) : cur);
          td.appendChild(inp);
          td.classList.add('edit-cell');
        } else {
          var _disp = (d.dateFmt && val !== '' && val !== null && val !== undefined) ? fmtYYMMDD(val) : val;
          td.textContent = (_disp === '' || _disp === null || _disp === undefined) ? '' : _disp;
        }
        tr.appendChild(td);
        return;
      }
      // 只读展示（方案列）
      if (d.key === '序列') {
        td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
        td.style.cursor = 'pointer';
        td.title = '点击查看/复制整行文本';
        td.onclick = (function (ri) { return function () { openPriceTextModal(ri); }; })(item.__idx);
        tr.appendChild(td);
        return;
      }
      if (d.type === 'combo') {
        var _pv1 = item[d.keys[0]] || '';
        var _pv2 = item[d.keys[1]] || '';
        td.innerHTML = escapeHtml(_pv1) + '<br>' + escapeHtml(_pv2);
      }
      else if (d.type === 'cfg') td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      else td.textContent = (val === '' || val === null || val === undefined) ? '' : val;
      tr.appendChild(td);
    });
    _priceFrag.appendChild(tr);
  });
  priceTableBody.appendChild(_priceFrag);
  if (_cjDirty) persistData();
  layoutPriceFilterWidths();
}

// 价格明细：操作列「编辑」按钮触发的行内编辑提交（仅写入可编辑的 7 个字段，其余列保持只读）
function savePriceRowEdit(ri) {
  var _src = rawData[ri];
  if (!_src) { priceEditingIdx = null; renderPrice(); return; }
  var tr = priceTableBody.querySelector('tr[data-edit="1"]');
  if (tr) {
    tr.querySelectorAll('input[data-pf]').forEach(function (inp) {
      var k = inp.getAttribute('data-pf');
      var v = inp.value;
      if (k === '价格申请日期') v = parsePriceDateInput(v);
      _src[k] = v;
    });
  }
  priceEditingIdx = null;
  persistData();
  scheduleSync();
  renderPrice();
  showToast('✅ 已保存价格明细编辑', 'success');
}

// ==================== 价格明细：点击序列号 → 弹出整行文本（可一键复制） ====================
function openPriceTextModal(rowIdx) {
  var row = rawData[rowIdx];
  if (!row) return;
  var cfg = cfgParseCached(row['配置'] || '');
  var parts = [
    ['客户', row['客户'] || ''],
    ['模组下单型号', row['型号'] || ''],
    ['电机型号', cfg['电机'] || ''],
    ['动子个数', cfg['动子个数'] || ''],
    ['驱动器型号', cfg['驱动器型号'] || ''],
    ['光电&个数', cfg['光电开关'] || ''],
    ['导轨', cfg['导轨品牌'] || ''],
    ['读头', cfg['读头'] || ''],
    ['电源线', cfg['动力线'] || ''],
    ['编码器线', cfg['编码器线'] || ''],
    ['图纸来源', cfg['图纸来源'] || ''],
    ['刹车电阻', cfg['刹车电阻'] || ''],
    ['其他', cfg['其他备注'] || '']
  ];
  var text = parts.map(function (p) { return p[0] + '(' + p[1] + ')'; }).join(',');
  document.getElementById('ptText').value = text;
  document.getElementById('ptTitle').textContent = row['序列'];
  document.getElementById('priceTextModal').classList.add('show');
}

function closePriceTextModal() {
  document.getElementById('priceTextModal').classList.remove('show');
}

function copyPriceText() {
  var ta = document.getElementById('ptText');
  if (!ta) return;
  ta.focus();
  ta.select();
  var ok = false;
  try { ok = document.execCommand('copy'); } catch (e) { ok = false; }
  if (ok) showToast('✅ 已复制全部文本', 'success');
  else if (navigator.clipboard && navigator.clipboard.writeText) {
    navigator.clipboard.writeText(ta.value).then(function () { showToast('✅ 已复制全部文本', 'success'); },
      function () { showToast('复制失败，请手动复制', 'error'); });
  } else {
    showToast('复制失败，请手动复制', 'error');
  }
}

// ==================== 价格明细表：列宽拖拽（复用方案明细机制） ====================
var priceColW = [];
var priceColGroup = null;
var priceResizerInited = false;
var PRICE_COLW_KEY = 'xmPriceColWidths';
var PRICE_DEF_W = {};
for (var _k in XM_DEF_W) PRICE_DEF_W[_k] = XM_DEF_W[_k];
PRICE_DEF_W['价格申请日期'] = 80; PRICE_DEF_W['成交价/成交价备注'] = 120; PRICE_DEF_W['公司价格/公司价格备注'] = 120; PRICE_DEF_W['报价/报价备注'] = 120;
PRICE_DEF_W['操作'] = 92;

function loadPriceColW(n) {
  try { var raw = localStorage.getItem(PRICE_COLW_KEY); if (!raw) return null; var arr = JSON.parse(raw); if (Array.isArray(arr) && arr.length === n) return arr; } catch (e) {}
  return null;
}
function savePriceColW() { try { localStorage.setItem(PRICE_COLW_KEY, JSON.stringify(priceColW)); } catch (e) {} }
function applyPriceColWidths(arr) {
  if (!Array.isArray(arr) || !arr.length) return false;
  if (!priceColGroup || priceColGroup.children.length !== arr.length) return false;
  priceColW = arr.slice();
  for (var i = 0; i < priceColW.length; i++) { if (priceColGroup.children[i]) priceColGroup.children[i].style.width = priceColW[i] + 'px'; }
  if (priceTable) priceTable.style.width = priceColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  savePriceColW();
  return true;
}
function initPriceColResizer() {
  if (priceResizerInited) return;
  if (!priceTable) return;
  var ths = priceTable.querySelectorAll('thead th');
  if (!ths.length) return;
  var savedW = loadPriceColW(ths.length);
  priceColGroup = document.createElement('colgroup');
  priceColGroup.id = 'priceColGroup';
  priceColW = [];
  var thList = [];
  ths.forEach(function (th, i) {
    thList.push(th);
    var title = (th.textContent || '').trim();
    var w = (savedW && savedW[i] != null) ? savedW[i] : (PRICE_DEF_W[title] || 50);
    priceColW.push(w);
    var col = document.createElement('col');
    col.style.width = w + 'px';
    priceColGroup.appendChild(col);
    var r = document.createElement('span');
    r.className = 'col-resizer';
    th.appendChild(r);
  });
  priceTable.insertBefore(priceColGroup, priceTable.firstChild);
  priceTable.style.width = priceColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
  priceTable.querySelector('thead').addEventListener('mousedown', function (e) {
    var rEl = e.target.closest ? e.target.closest('.col-resizer') : null;
    if (!rEl) return;
    e.preventDefault();
    var th = rEl.parentNode;
    var idx = 0;
    for (var k = 0; k < thList.length; k++) { if (thList[k] === th) { idx = k; break; } }
    var startX = e.clientX;
    var startW = priceColW[idx];
    rEl.classList.add('active');
    function onMove(ev) {
      var nw = Math.max(36, startW + (ev.clientX - startX));
      priceColW[idx] = nw;
      priceColGroup.children[idx].style.width = nw + 'px';
      priceTable.style.width = priceColW.reduce(function (a, b) { return a + b; }, 0) + 'px';
      layoutPriceFilterWidths(); // 拖拽时同步筛选框宽度
    }
    function onUp() {
      rEl.classList.remove('active');
      document.removeEventListener('mousemove', onMove);
      document.removeEventListener('mouseup', onUp);
      document.body.classList.remove('col-resizing');
      savePriceColW();
      persistData(); // 同步写入文件内 <script id="priceColW">，确保「同步到 GitHub」时价格表列宽一并上传
      layoutPriceFilterWidths(); // 释放拖拽后再次同步筛选框宽度
    }
    document.body.classList.add('col-resizing');
    document.addEventListener('mousemove', onMove);
    document.addEventListener('mouseup', onUp);
  });
  priceResizerInited = true;
}
