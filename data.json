<!-- 电气配置视图（由「价格明细」全部定型方案复制而来，仅保留电气配置相关列，不包含价格/报价类字段） -->
<div id="elecView" style="display:none">
  <div class="toolbar">
    <span class="filter-inline">
      <input class="f-inp" placeholder="客户" id="ef_客户" onkeydown="if(event.key==='Enter')applyFilters()">
      <input class="f-inp" placeholder="模组下单型号" id="ef_型号" onkeydown="if(event.key==='Enter')applyFilters()">
      <button class="btn btn-primary" onclick="applyFilters()">确认</button>
      <button class="btn btn-outline" onclick="clearFilters(this)">清除</button>
    </span>
  </div>
  <div class="table-wrapper">
    <div class="table-scroll">
      <table id="elecTable">
        <thead id="elecHead"></thead>
        <tbody id="elecTableBody"></tbody>
      </table>
    </div>
  </div>
</div><!-- /elecView -->

<!-- 新增变更弹窗：界面与「新增行（方案）」弹窗完全一致；锁定字段只读，其余可编辑 -->
<div class="modal" id="changeModal">
  <div class="modal-box">
    <h3>🔧 新增变更 · 方案 #<span id="chPlanId"></span></h3>
    <div id="chFields"></div>
    <div id="chDetail" class="xm-detail"></div>
    <div class="ar-quickfill">
      <label>批量粘贴（格式：名称(内容)，用逗号或换行分隔）</label>
      <textarea id="chQuickText" rows="2" placeholder="模组下单型号(MIC080),电机型号(...)，可换行"></textarea>
      <button type="button" class="btn btn-outline" onclick="parseQuickFill('ch')">确认填入</button>
      <div class="hint">支持的类别：模组下单型号、电机型号、动子个数、驱动器型号、光电&amp;个数、导轨、读头、电源线、编码器线、图纸来源、刹车电阻、其他</div>
    </div>
    <div class="modal-actions">
      <button class="btn btn-outline" onclick="closeChangeModal()">取消</button>
      <button class="btn btn-primary" onclick="submitChange()">✅ 保存变更</button>
    </div>
  </div>
</div>

<!-- 新增行（方案）弹窗：字段与表格列一致 -->
<div class="modal" id="addRowModal">
